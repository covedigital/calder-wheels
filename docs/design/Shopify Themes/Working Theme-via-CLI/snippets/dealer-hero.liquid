{%- liquid
  assign local_dealer = seed_dealer_name | default: customer.name | default: 'Your Dealership'
  assign local_sub = 'Your Calder account, orders, and dealer activity at a glance.'
  assign local_image = hero_image | default: ''
  assign local_image_url = ''
  if local_image != blank
    assign local_image_url = local_image | img_url: 'master'
  endif
-%}

<div class="dp-hero"{% if local_image_url != blank %} style="background-image:url('{{ local_image_url }}')"{% endif %}>
  <div class="dp-hero__image"{% if local_image_url != blank %} style="display:none"{% endif %}>
    {% if local_image_url == blank %}
    <svg width="100%" height="100%" viewBox="0 0 800 200" preserveAspectRatio="xMidYMid slice" style="display:none">
      <defs>
        <linearGradient id="hero-grad" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#1A2A44"/>
          <stop offset="100%" stop-color="#0A1628"/>
        </linearGradient>
      </defs>
      <rect width="800" height="200" fill="url(#hero-grad)"/>
    </svg>
    {% endif %}
  </div>
  <div class="dp-hero__content">
    <p class="dp-hero__eyebrow">DEALER PORTAL</p>
    <h1 class="dp-hero__heading">WELCOME BACK,<br>{{ local_dealer }}</h1>
    <p class="dp-hero__sub">{{ local_sub }}</p>
  </div>
  <div class="dp-hero__tagline">
    <span>BUILT</span>
    <span>FOR THOSE</span>
    <span>WHO MOVE</span>
    <span>THE INDUSTRY</span>
    <span>FORWARD.</span>
    <span class="dp-hero__tagline-rule"></span>
  </div>
</div>