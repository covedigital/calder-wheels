{%- liquid
  render 'dealer-context'
  assign hide_dealer_only = false
  if is_dealer == false and product.metafields.custom.dealer_only.value == true
    assign hide_dealer_only = true
  endif
-%}
{%- unless hide_dealer_only -%}
{%- liquid
  assign card_layout = layout | default: settings.product_card_layout
  assign calder_premium = false
  assign card_modifier = ''
  if card_layout == '4'
    assign calder_premium = true
    assign card_modifier = ' calder-card--light'
  elsif card_layout == '5'
    assign calder_premium = true
    assign card_modifier = ' calder-card--dark'
  endif
  assign section_id = section_id | default: 'calder-card'
  assign product_form_id = 'product-form-' | append: product_form_suffix | append: section_id | append: '-' | append: product.id

  assign current_variant = product.selected_or_first_available_variant
  assign target = product.selected_variant | default: product
  assign image = product.selected_variant.featured_media | default: product.featured_media

  assign in_collection = product.collections | where: 'handle', collection.handle | first
  if collection == null or collection.handle == 'all' or in_collection == nil
    assign all_products_count = 0
    for c in product.collections
      if c.handle != 'all' and c.handle != 'frontpage' and all_products_count < c.all_products_count
        assign collection = c
        assign all_products_count = c.all_products_count
      endif
    endfor
  endif

  assign product_url_collection = product.url
  if settings.product_card_url_within_collection
    assign product_url_collection = product.url | within: collection
  endif
  capture calder_design_pdp_url
    render 'calder-design-url', product: product, current_variant: current_variant
  endcapture
  assign calder_design_pdp_url = calder_design_pdp_url | strip
  if calder_design_pdp_url != blank
    assign product_url_collection = calder_design_pdp_url
  endif

  assign picker_type = settings.product_card_picker_type
  assign use_pics = settings.product_card_use_pics
  assign use_variants_media = settings.product_card_use_variants_media
  assign swatches_width = settings.product_swatches_color_min_width

  assign media_size = product.media | where: 'media_type', 'image' | size

  assign hide_quantity = 1
  if settings.product_inventory_quantity and settings.product_inventory_quantity_on_product_card
    assign hide_quantity = 0
  endif

  if calder_premium
    assign hide_quantity = 0
  endif
  assign taxonomy_label = product.type | upcase
  if taxonomy_label == blank
    assign taxonomy_label = collection.title | upcase
  endif

  assign feature_metafields_1 = product.metafields.custom.card_feature_1
  assign feature_metafields_2 = product.metafields.custom.card_feature_2
  assign feature_metafields_3 = product.metafields.custom.card_feature_3

  assign has_features = false
  if feature_metafields_1 != blank or feature_metafields_2 != blank or feature_metafields_3 != blank
    assign has_features = true
  endif

  if calder_premium
    assign display_title = short_title | default: product.metafields.custom.design_code.value | default: product.title
    assign construction_label = '2-Piece Spun Forged'

    comment
      Shown Configuration sources (2026-11-02 D) — resolved per variant from
      the product's own data, options identified by NAME:
        diameter  native Diameter option value
        center    native Center Finish option value
        barrel    native Barrel & Lip option value (combined "Barrel & Lip -
                  Hardware" values contribute the "... Lip" fragment only)
        bolts     "… Bolts" fragment of the combined option value, else the
                  documented part-number SKU bolt digit (registry sku_scheme:
                  last digit 1=Chrome 2=Black — the live-store verified mapping
                  also used by calder-design-url.liquid), else the handle
                  chrome-bolts/black-bolts tokens
      When a value cannot be resolved for a variant the field is omitted —
      nothing is invented (spec D data rules).
    endcomment
    assign cc_diameter_index = -1
    assign cc_center_index = -1
    assign cc_barrel_index = -1
    assign cc_combined_hw = false
    for option in product.options_with_values
      assign option_name_lower = option.name | downcase
      if option_name_lower contains 'diameter'
        assign cc_diameter_index = forloop.index0
      elsif option_name_lower contains 'center finish'
        assign cc_center_index = forloop.index0
      elsif option_name_lower contains 'barrel'
        assign cc_barrel_index = forloop.index0
        if option_name_lower contains 'hardware'
          assign cc_combined_hw = true
        endif
      endif
    endfor

    comment
      C7 (2026-11-15): showcase variant — registry design default configuration
      matched to this product's own variants (developer-approved source (b)).
      docs/architecture/calder_design_registry.json default_configuration is
      identical for all six designs: 22" / gloss-black center / gloss-black
      lip / chrome bolts. The variant products (fixed lip/bolt combo per
      product, 9 variants = 3 diameters x 3 centers) resolve to their own
      22" + Gloss Black variant; the design products already list the exact
      default configuration as their first variant (verified against the
      live export) and resolve to it here unchanged. The showcased
      center's own alt-coded render ("... - Gloss Black center, ...",
      Matrixify position 2) replaces the featured media so the image and
      the Shown Configuration panel describe ONE configuration — the
      showcase only engages when that image exists, never a mismatched
      pair. Price stays on the same 22" tier as the previous first
      variant. Falls back to selected_or_first_available otherwise.
    endcomment
    if cc_center_index >= 0
      for cc_v in product.variants
        if cc_v.available and cc_v.options[cc_center_index] == 'Gloss Black'
          if cc_diameter_index < 0 or cc_v.options[cc_diameter_index] == '22"'
            assign cc_showcase_variant = cc_v
            break
          endif
        endif
      endfor
      if cc_showcase_variant
        for cc_media in product.media
          if cc_media.media_type == 'image' and cc_media.alt contains 'Gloss Black center'
            assign cc_showcase_media = cc_media
            break
          endif
        endfor
        if cc_showcase_media
          assign current_variant = cc_showcase_variant
          assign image = cc_showcase_media
          assign product_url_collection = product.url
          if settings.product_card_url_within_collection
            assign product_url_collection = product.url | within: collection
          endif
          capture calder_design_pdp_url
            render 'calder-design-url', product: product, current_variant: current_variant
          endcapture
          assign calder_design_pdp_url = calder_design_pdp_url | strip
          if calder_design_pdp_url != blank
            assign product_url_collection = calder_design_pdp_url
          endif
        endif
      endif
    endif

    if cc_center_index >= 0
      assign selected_finish = current_variant.options[cc_center_index] | default: ''
    else
      assign selected_finish = ''
    endif

    comment
      Diameter values for the Available Sizes line: unique option values,
      separated by " · " (spec D). No reliable diameter option -> section
      omitted.
    endcomment
    assign cc_sizes_line = ''
    if cc_diameter_index >= 0
      for option in product.options_with_values
        assign option_name_lower = option.name | downcase
        if option_name_lower contains 'diameter'
          for value in option.values
            assign cc_sizes_line = cc_sizes_line | append: value
            unless forloop.last
              assign cc_sizes_line = cc_sizes_line | append: ' · '
            endunless
          endfor
          break
        endif
      endfor
    endif

    comment
      Per-variant configuration map for the card-sync script: variant id ->
      {d, c, b, h}. Emitted once per card instance.
    endcomment
  endif
-%}
<calder-product-card class="prd prd--hover-off lazyload{{ card_modifier }}" data-section-render data-available="{% if product.available %}true{% else %}false{% endif %}">
{%- if calder_premium -%}
<script type="application/json" data-calder-card-variants>
  [
  {%- liquid
    assign cc_first_variant = true
    for cc_v in product.variants
      unless cc_first_variant
        echo ','
      endunless
      assign cc_first_variant = false
      assign cc_d = ''
      assign cc_c = ''
      assign cc_b = ''
      assign cc_h = ''
      if cc_diameter_index >= 0
        assign cc_d = cc_v.options[cc_diameter_index]
      endif
      if cc_center_index >= 0
        assign cc_c = cc_v.options[cc_center_index]
      endif
      if cc_barrel_index >= 0
        assign cc_b_raw = cc_v.options[cc_barrel_index]
        if cc_combined_hw and cc_b_raw contains ' Bolts'
          assign cc_b = cc_b_raw | split: ' Lip' | first | append: ' Lip'
          assign cc_h = cc_b_raw | split: '- ' | last
        elsif cc_b_raw == 'Chrome' or cc_b_raw == 'Black'
          comment
            C7 (2026-11-15): same routing as the server-rendered panel above —
            "Barrel & Lip Finish" values of Chrome/Black are the product's
            fixed hardware finish; the lip finish comes from the documented
            SKU tail digit. Keeps the JS card sync truthful for any variant
            the shopper selects.
          endcomment
          assign cc_h = cc_b_raw
          assign cc_b = ''
          assign cc_lip_digit = cc_v.sku | slice: -2 | slice: 0
          if cc_lip_digit == '1'
            assign cc_b = 'Polished'
          elsif cc_lip_digit == '2'
            assign cc_b = 'Gloss Black'
          endif
        else
          assign cc_b = cc_b_raw
          assign cc_h = ''
        endif
        if cc_h == blank
          assign cc_bolt_digit = cc_v.sku | slice: -1
          if cc_bolt_digit == '1'
            assign cc_h = 'Chrome'
          elsif cc_bolt_digit == '2'
            assign cc_h = 'Black'
          else
            assign cc_handle_l = product.handle | downcase
            if cc_handle_l contains 'chrome-bolts'
              assign cc_h = 'Chrome'
            elsif cc_handle_l contains 'black-bolts'
              assign cc_h = 'Black'
            endif
          endif
        endif
      endif
      assign cc_b = cc_b | remove: ' Lip' | remove: ' lip'
      assign cc_h = cc_h | remove: ' Bolts' | remove: ' bolts'
      echo '{"id":' | append: cc_v.id | append: ',"d":'
      echo cc_d | json
      echo ',"c":'
      echo cc_c | json
      echo ',"b":'
      echo cc_b | json
      echo ',"h":'
      echo cc_h | json
      echo '}'
    endfor
  -%}
  ]
</script>
{%- endif -%}

  <div class="calder-card">
    <div class="calder-card__media">
      {% render 'product-card-badges', render: true, section: section, product: product, product_form_id: product_form_id %}
      {% render 'product-card-component-icons-bar', current_variant: current_variant, target: target, product_form_id: product_form_id, product: product %}
      <div class="prd-image-wrap" style="width:100%;height:100%;position:static;">
        {% render 'product-card-media',
          product: product,
          image: image,
          collection: collection,
          lazyload: lazyload,
          class_img_only: class_img_only,
          widths: widths,
          sizes: sizes,
          product_form_suffix: product_form_suffix,
          fetchpriority: fetchpriority,
          product_url_collection: product_url_collection
        %}
      </div>
    </div>

    <div class="calder-card__content">
      {% unless calder_premium %}
      {% if taxonomy_label != blank %}
        <div class="calder-card__type">
          {% if collection != blank %}
            <a href="{{ collection.url }}">{{ taxonomy_label }}</a>
          {% else %}
            <span>{{ taxonomy_label }}</span>
          {% endif %}
        </div>
      {% endif %}
      {% endunless %}
      {% if calder_premium and construction_label != blank %}
        <div class="calder-card__type">{{ construction_label | escape }}</div>
      {% endif %}

      <h3 class="calder-card__title">
        <a href="{{ product_url_collection }}">{{ display_title | default: product.title | escape }}</a>
      </h3>
      {% unless calder_premium %}
        {% render 'calder-card-badges', product: product %}
      {% endunless %}
      {% if calder_premium %}
        {%- comment -%}
          Section 1 — Part# (2026-11-16 client update): the product's universal
          part number (the variant SKU from the SKU master, e.g. CLM0522106390630BT11).
          Replaces the former "Available Sizes" informational list.
        {%- endcomment -%}
        {%- liquid
          assign cc_part_no = current_variant.sku
          if cc_part_no == blank
            assign cc_part_no = product.selected_or_first_available_variant.sku
          endif
        -%}
        {% if cc_part_no != blank %}
          <div class="calder-card__part_no">
            <div class="calder-card__section-label">Part#</div>
            <div class="calder-card__part_no-value">{{ cc_part_no | escape }}</div>
          </div>
        {% endif %}
      {% endif %}

      {% if settings.product_card_rating and calder_premium == false %}
        <div class="calder-card__rating">
          {% render 'rating', product: product %}
        </div>
      {% endif %}

      {% capture card_price_markup %}
      <div class="calder-card__price">
        {% render 'price', product: product, use_variant: true, render: true, product_card_style_1: false, product_form_id: product_form_id, product_card: true %}
        {% render 'calder-card-dealer-price', product: product %}
      </div>

      {% endcapture %}
      {% unless calder_premium %}{{ card_price_markup }}{% endunless %}

      {%- comment -%}Legacy (non-premium) layouts keep their original quick
        swatch block untouched (2026-11-02 D: premium-only scope).{%- endcomment -%}
      {% unless calder_premium %}
        {% if settings.product_card_show_variants %}
          <div class="calder-card__swatches">
            {% render 'variant_picker',
              product: product,
              picker_type: picker_type,
              section: section,
              section_id: section_id,
              layout: 'product-card',
              product_form_id: product_form_id,
              use_pics: use_pics,
              use_variants_media: use_variants_media,
              color_options_name: settings.product_card_color_options_name,
              swatches_width: swatches_width,
              show_colors_only: true,
              product_form_suffix: product_form_suffix,
              quick_options: true
            %}
          </div>
        {% endif %}
      {% endunless %}

      {% if calder_premium %}
        {%- comment -%}
          Preserve the existing picker inputs for the native form and card
          synchronization, without displaying an Available Finishes section.
        {%- endcomment -%}
        <div class="calder-card__finishes" hidden>
          {% if settings.product_card_show_variants %}
            <div class="calder-card__swatches">
              {% render 'variant_picker',
                product: product,
                picker_type: picker_type,
                section: section,
                section_id: section_id,
                layout: 'product-card',
                product_form_id: product_form_id,
                use_pics: use_pics,
                use_variants_media: use_variants_media,
                color_options_name: settings.product_card_color_options_name,
                swatches_width: swatches_width,
                card_option_filter: 'Center Finish',
                product_form_suffix: product_form_suffix
              %}
            </div>
          {% endif %}
        </div>

        {%- comment -%}
          Section 3 — Shown Configuration (2026-11-02 D): compact two-column
          panel reflecting the configuration actually selected on THIS card.
          Server-rendered initial values mirror the resolved card selection;
          calder-product-card.js re-syncs per card on every existing variant
          change (input[name="id"] change events). Unresolvable fields are
          omitted; the whole panel is omitted when nothing resolves.
        {%- endcomment -%}
        {%- liquid
          assign cc_shown_d = ''
          assign cc_shown_c = ''
          assign cc_shown_b = ''
          assign cc_shown_h = ''
          assign cc_shown_size = ''
          assign cc_shown_offset = ''
          assign cc_shown_bore = ''
          if cc_diameter_index >= 0
            assign cc_shown_d = current_variant.options[cc_diameter_index]
          endif
          if cc_center_index >= 0
            assign cc_shown_c = current_variant.options[cc_center_index]
          endif
          comment
            2026-11-16 client update — Size = combined diameter × width (e.g. 22x10).
            Width parses from the variant SKU position 7-8 (documented master scheme:
            CLM05-22-10-639-... design|dia|width|bolt). Fallback: the catalog-wide
            x10 width per the SUV Data Sheet master.
          endcomment
          if cc_shown_d != blank
            assign cc_dia_raw = cc_shown_d | remove: '"' | strip
            assign cc_width_raw = current_variant.sku | slice: 7, 2
            if cc_width_raw == blank or cc_width_raw == ''
              assign cc_width_raw = '10'
            endif
            assign cc_shown_size = cc_dia_raw | append: 'x' | append: cc_width_raw
          endif
          comment
            2026-11-16 client update — Offset and Center Bore from product data.
            Offset parses from the handle (-p<NN>- pattern, verified across all 96
            variant product handles in the live export). Center Bore reads the
            center_bore metafield (cleans the import apostrophe) with a handle
            fallback. Both values correspond to the product's fixed bolt pattern
            (each variant product is one bolt-pattern family).
          endcomment
          assign cc_handle_parts = product.handle | split: '-p'
          if cc_handle_parts.size > 1
            assign cc_offset_raw = cc_handle_parts[1] | split: '-' | first
            if cc_offset_raw != blank
              assign cc_shown_offset = '+' | append: cc_offset_raw | append: 'mm'
            endif
          endif
          assign cc_bore_raw = product.metafields.custom.center_bore.value | default: product.metafields.custom.center_bore | default: ''
          assign cc_bore_raw = cc_bore_raw | remove: "'" | strip
          if cc_bore_raw != blank
            assign cc_shown_bore = cc_bore_raw
          elsif cc_handle_parts.size > 1
            assign cc_handle_tail = cc_handle_parts[1] | split: 'mm' | first
            if cc_handle_tail != blank
              assign cc_shown_bore = cc_handle_tail | replace: '-', '.' | strip
            endif
          endif
          if cc_barrel_index >= 0
            assign cc_b_raw = current_variant.options[cc_barrel_index]
            if cc_combined_hw and cc_b_raw contains ' Bolts'
              assign cc_shown_b = cc_b_raw | split: ' Lip' | first | append: ' Lip'
              assign cc_shown_h = cc_b_raw | split: '- ' | last
            elsif cc_b_raw == 'Chrome' or cc_b_raw == 'Black'
              comment
                C7 (2026-11-15): live catalog shape — the "Barrel & Lip Finish"
                option carries the product's fixed HARDWARE value (Chrome /
                Black). Display it under Bolts and take the true lip finish
                from the documented SKU tail digit (verified 864/864 against
                the handles in the live export: ...BT11 = center, 1=Polished
                lip, 1=Chrome bolts). Unparseable SKU -> barrel omitted
                (truthful), never invented.
              endcomment
              assign cc_shown_h = cc_b_raw
              assign cc_lip_digit = current_variant.sku | slice: -2 | slice: 0
              if cc_lip_digit == '1'
                assign cc_shown_b = 'Polished'
              elsif cc_lip_digit == '2'
                assign cc_shown_b = 'Gloss Black'
              endif
            else
              assign cc_shown_b = cc_b_raw
            endif
            if cc_shown_h == blank
              assign cc_bolt_digit = current_variant.sku | slice: -1
              if cc_bolt_digit == '1'
                assign cc_shown_h = 'Chrome'
              elsif cc_bolt_digit == '2'
                assign cc_shown_h = 'Black'
              else
                assign cc_handle_l = product.handle | downcase
                if cc_handle_l contains 'chrome-bolts'
                  assign cc_shown_h = 'Chrome'
                elsif cc_handle_l contains 'black-bolts'
                  assign cc_shown_h = 'Black'
                endif
              endif
            endif
          endif
          assign cc_shown_b = cc_shown_b | remove: ' Lip' | remove: ' lip'
          assign cc_shown_h = cc_shown_h | remove: ' Bolts' | remove: ' bolts'
          assign cc_has_config = false
          if cc_shown_d != blank or cc_shown_c != blank or cc_shown_b != blank or cc_shown_h != blank
            assign cc_has_config = true
          endif
        -%}
        {% if cc_has_config %}
          <div class="calder-card__config" aria-live="polite">
            <div class="calder-card__config-heading">Wheel Description</div>
            <div class="calder-card__config-grid">
              {% if cc_shown_size != blank %}
                <div class="calder-card__config-cell" data-calder-config-cell="d">
                  <span class="calder-card__config-label">Size</span>
                  <span class="calder-card__config-value" data-calder-config="d">{{ cc_shown_size | escape }}</span>
                </div>
              {% endif %}
              {% if cc_shown_c != blank %}
                <div class="calder-card__config-cell" data-calder-config-cell="c">
                  <span class="calder-card__config-label">Center Finish</span>
                  <span class="calder-card__config-value" data-calder-config="c">{{ cc_shown_c | escape }}</span>
                </div>
              {% endif %}
              {% if cc_shown_h != blank %}
                <div class="calder-card__config-cell" data-calder-config-cell="h">
                  <span class="calder-card__config-label">Bolts</span>
                  <span class="calder-card__config-value" data-calder-config="h">{{ cc_shown_h | escape }}</span>
                </div>
              {% endif %}
              {% if cc_shown_b != blank %}
                <div class="calder-card__config-cell" data-calder-config-cell="b">
                  <span class="calder-card__config-label">Barrel</span>
                  <span class="calder-card__config-value" data-calder-config="b">{{ cc_shown_b | escape }}</span>
                </div>
              {% endif %}
              {% if cc_shown_offset != blank %}
                <div class="calder-card__config-cell" data-calder-config-cell="o">
                  <span class="calder-card__config-label">Offset</span>
                  <span class="calder-card__config-value" data-calder-config="o">{{ cc_shown_offset | escape }}</span>
                </div>
              {% endif %}
              {% if cc_shown_bore != blank %}
                <div class="calder-card__config-cell" data-calder-config-cell="cb">
                  <span class="calder-card__config-label">Center Bore</span>
                  <span class="calder-card__config-value" data-calder-config="cb">{{ cc_shown_bore | escape }}</span>
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}

        {{ card_price_markup }}
      {% endif %}

      {% if has_features and calder_premium == false %}
        <div class="calder-card__features">
          {% if feature_metafields_1 != blank %}
            <div class="calder-card__feature">
              <span class="calder-card__feature-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              </span>
              <span class="calder-card__feature-label">{{ feature_metafields_1 }}</span>
            </div>
          {% endif %}
          {% if feature_metafields_2 != blank %}
            <div class="calder-card__feature">
              <span class="calder-card__feature-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              </span>
              <span class="calder-card__feature-label">{{ feature_metafields_2 }}</span>
            </div>
          {% endif %}
          {% if feature_metafields_3 != blank %}
            <div class="calder-card__feature">
              <span class="calder-card__feature-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              </span>
              <span class="calder-card__feature-label">{{ feature_metafields_3 }}</span>
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if calder_premium %}<div class="calder-card__purchase-row">{% endif %}
      <div class="calder-card__action">
        {% render 'product-card-action'
          product: product,
          product_form_id: product_form_id,
          show_variants: settings.product_card_show_variants,
          product_direct: settings.product_direct,
          layout: 'product-card',
          hide_quantity: hide_quantity,
          current_variant: current_variant
        %}
      </div>

      {% if calder_premium %}</div>{% endif %}
      <div class="calder-card__details">
        <a href="{{ product_url_collection }}">
          {% if calder_premium %}
            Customize Your Wheel
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
