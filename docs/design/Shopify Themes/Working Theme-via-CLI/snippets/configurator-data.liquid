{% comment %}
  Calder Wheels — Configurator Data Provider
  Injects resolved canonical product data as JS globals:
    - window._calderProductData[<product_id>]   (per-product, no global overwrites)
    - window._calderProductComponents           (current product alias)
  Trailing commas are valid in JS (not JSON), so this is simpler and more reliable.
  Usage: {% render 'configurator-data', product: product, section_id: section.id %}
{% endcomment %}

{%- liquid
  assign bom_json = product.metafields.custom.bom.value
  assign components = bom_json.components | default: bom_json
  assign design_code = product.metafields.custom.design_code.value
  if design_code == blank
    assign handle_parts = product.handle | split: '-'
    assign design_code = handle_parts[1]
  endif
  assign variant_map = product.metafields.custom.variant_map.value | default: product.metafields.custom.config_map.value
  assign lead_time = product.metafields.custom.lead_time_days.value | default: 10
  assign api_url = settings.configurator_api_url | default: 'https://calder-dev.covedigitalworks.com'
  assign diameters_meta = product.metafields.custom.diameters.value
  if diameters_meta == blank
    assign diameters_meta = ''
  endif
  if diameters_meta != blank and diameters_meta contains ' ; '
    assign diameters_meta = diameters_meta | split: ' ; '
  endif
-%}

<script id="configurator-data-{{ section_id }}">
window._calderProductData = window._calderProductData || {};
window._calderProductData[{{ product.id }}] = {% render 'configurator-product-data', product: product %};
window._calderProductComponents = window._calderProductData[{{ product.id }}];
</script>

{%- assign _ab = 'x' | asset_url | split: 'x' | first -%}
<script>
window.CALDER_API_BASE = window.CALDER_API_BASE || '{{ api_url }}';
window._calderDesignCode = window._calderDesignCode || '{{ design_code }}';
window.CALDER_ASSET_BASE = window.CALDER_ASSET_BASE || '{{ _ab }}';
</script>