{% comment %}
  Calder Wheels — Wheel Catalog for Fitment Matching
  Source of truth for which wheel products exist and their fitment specs.
  Emits a window.__fitmentCatalog JSON array consumed by fitment-finder.js.
  No network request needed — rendered inline with the section.

  Product fields:
    - bolt_pattern / bolt_patterns: product `bolt_pattern` metafield when
      present; otherwise the curated per-design bolt set (mirrors
      fitment/fitment_manifest.py). A wheel design is produced across
      multiple bolt patterns, so `bolt_patterns` is the array used for
      vehicle matching.
    - load_rating:   product metafield (e.g. 2650)
    - diameters / diameter_labels: unique Option1 sizes across variants
      (e.g. [22,24,26] and their raw labels 22"/24"/26")
    - finishes:      unique Option2 (center finish) values
{% endcomment %}

{%- liquid
  assign collection_handle = 'all-calder-wheels'
  assign calder_collection = collections[collection_handle]
  assign products_arr = calder_collection.products | default: collections.all.products | default: ''

  assign _bp_map = '201:6x139.7,6x135|202:6x139.7,6x135,5x130,5x120|203:6x139.7,6x135|205:6x139.7,6x135|206:6x139.7,6x135,5x130,5x120|207:6x139.7,6x135,5x130,5x120'
  assign _bp_entries = _bp_map | split: '|'
-%}

{%- capture catalog_json -%}
[
{%- for product in products_arr -%}
  {%- assign dc = product.metafields.custom.design_code.value -%}
  {%- if dc == blank -%}
    {%- assign dc_parts = product.handle | split: '-' -%}
    {%- assign dc = dc_parts[1] -%}
  {%- endif -%}
  {%- assign lr = product.metafields.custom.load_rating.value -%}

  {%- comment %} Curated bolt patterns for this design {% endcomment %}
  {%- assign curated_bolts = '' -%}
  {%- for entry in _bp_entries -%}
    {%- assign eid = entry | split: ':' | first | strip -%}
    {%- if eid == dc -%}
      {%- assign curated_bolts = entry | split: ':' | last | strip -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign meta_bp = product.metafields.custom.bolt_pattern.value | strip -%}
  {%- assign bp_primary = meta_bp -%}
  {%- if bp_primary == blank -%}
    {%- assign bp_primary = curated_bolts | split: ',' | first | strip -%}
  {%- endif -%}

  {%- assign diameters = '' -%}
  {%- assign diameter_labels = '' -%}
  {%- assign widths = '' -%}
  {%- assign finishes = '' -%}
  {%- assign barrel_finishes = '' -%}

  {%- comment -%}
    Barrel/lip option position (2026-11-02 B): identified by NAME ('barrel'),
    not position. Computed once per product; -1 when absent.
  {%- endcomment -%}
  {%- assign barrel_opt_index = -1 -%}
  {%- for opt in product.options -%}
    {%- if opt contains 'barrel' -%}
      {%- assign barrel_opt_index = forloop.index0 -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}

  {%- for variant in product.variants -%}
    {%- assign opt = variant.option1 | strip -%}
    {%- if opt != blank and opt != 'Default Title' -%}
      {%- assign d_raw = opt | split: 'x' | first | strip | remove: '"' | remove: 'in' | remove: 'inch' | strip | plus: 0 -%}
      {%- if d_raw > 0 -%}
        {%- unless diameters contains d_raw -%}
          {%- if diameters != '' -%}{%- assign diameters = diameters | append: ',' -%}{%- endif -%}
          {%- assign diameters = diameters | append: d_raw -%}
          {%- if diameter_labels != '' -%}{%- assign diameter_labels = diameter_labels | append: ',' -%}{%- endif -%}
          {%- assign diameter_labels = diameter_labels | append: opt -%}
        {%- endunless -%}
        {%- if opt contains 'x' -%}
          {%- assign w_raw = opt | split: 'x' | last | strip | remove: '"' | remove: 'in' | strip | plus: 0 -%}
          {%- if w_raw > 0 -%}
            {%- unless widths contains w_raw -%}
              {%- if widths != '' -%}{%- assign widths = widths | append: ',' -%}{%- endif -%}
              {%- assign widths = widths | append: w_raw -%}
            {%- endunless -%}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
    {%- assign finish = variant.option2 | strip -%}
    {%- if finish != blank and finish != 'Default Title' -%}
      {%- unless finishes contains finish -%}
        {%- if finishes != '' -%}{%- assign finishes = finishes | append: ',' -%}{%- endif -%}
        {%- assign finishes = finishes | append: finish -%}
      {%- endunless -%}
    {%- endif -%}
    {%- comment -%}
      Barrel/lip option values (2026-11-02 B): option identified by NAME
      ('barrel'), not position. Combined "Barrel & Lip - Hardware" values on
      universal products ("Gloss Black Lip - Chrome Bolts") contribute their
      barrel/lip fragment only. Raw store values are preserved verbatim.
    {%- endcomment -%}
    {%- if barrel_opt_index >= 0 -%}
      {%- assign barrel_val_raw = variant.options[barrel_opt_index] | strip -%}
      {%- assign barrel_val = barrel_val_raw -%}
      {%- if barrel_val_raw contains ' Bolts' and barrel_val_raw contains ' Lip' -%}
        {%- assign barrel_val = barrel_val_raw | split: ' Lip' | first | append: ' Lip' -%}
      {%- endif -%}
      {%- if barrel_val != blank and barrel_val != 'Default Title' -%}
        {%- unless barrel_finishes contains barrel_val -%}
          {%- if barrel_finishes == '' -%}{%- assign barrel_finishes = barrel_val -%}{%- else -%}{%- assign barrel_finishes = barrel_finishes | append: ',' | append: barrel_val -%}{%- endif -%}
        {%- endunless -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%}Bolt/hardware finish (2026-11-02 B): the product's own
    hardware_rivet_finish_options metafield value, trimmed to the first
    entry. Missing metafield -> empty list (no fabrication).{%- endcomment -%}
  {%- assign hw_list = product.metafields.custom.hardware_rivet_finish_options.value | default: '' | strip | split: ',' -%}
  {%- assign bolt_finish = '' -%}
  {%- for hw in hw_list -%}
    {%- assign hw_v = hw | strip -%}
    {%- if hw_v != blank and bolt_finish == '' -%}
      {%- assign bolt_finish = hw_v -%}
    {%- endif -%}
  {%- endfor -%}

  {%- unless forloop.first -%},{%- endunless -%}
  {
    "handle": {{ product.handle | json }},
    "title": {{ product.title | json }},
    "url": {{ product.url | json }},
    "price": {{ product.price | divided_by: 100.0 | round: 2 }},
    "featured_image": {{ product.featured_image | image_url: width: 400 | json }},
    "bolt_pattern": {{ bp_primary | json }},
    "bolt_patterns": [{%- assign _bp_out = bp_primary -%}{%- if curated_bolts != '' -%}{%- assign _bp_out = bp_primary | append: ',' | append: curated_bolts -%}{%- endif -%}{%- assign _bp_uniq = _bp_out | split: ',' -%}{%- assign _bp_seen = '' -%}{%- assign _bp_json = '' -%}{%- for _p in _bp_uniq -%}{%- assign _p2 = _p | strip -%}{%- assign _s = _bp_seen | split: ',' -%}{%- unless _s contains _p2 -%}{%- assign _bp_seen = _bp_seen | append: _p2 | append: ',' -%}{%- if _bp_json != '' -%}{%- assign _bp_json = _bp_json | append: ',' -%}{%- endif -%}{%- capture _tok_bp -%}{{ _p2 | json }}{%- endcapture -%}{%- assign _bp_json = _bp_json | append: _tok_bp -%}{%- endunless -%}{%- endfor -%}{{ _bp_json }}],
    "load_rating": {{ lr | default: 0 }},
    "design_code": {{ dc | json }},
    "nickname": {{ product.metafields.custom.design_nickname.value | default: '' | json }},
    "construction": {{ product.metafields.custom.construction_type.value | default: '' | json }},
    "diameters": [{{ diameters }}],
    "diameter_labels": [{%- assign _dl_arr = diameter_labels | split: ',' -%}{%- assign _dl_seen = '' -%}{%- assign _dl_json = '' -%}{%- for _dl in _dl_arr -%}{%- assign _dlv = _dl | strip -%}{%- assign _s = _dl_seen | split: ',' -%}{%- unless _s contains _dlv -%}{%- assign _dl_seen = _dl_seen | append: _dlv | append: ',' -%}{%- if _dl_json != '' -%}{%- assign _dl_json = _dl_json | append: ',' -%}{%- endif -%}{%- capture _tok_dl -%}{{ _dlv | json }}{%- endcapture -%}{%- assign _dl_json = _dl_json | append: _tok_dl -%}{%- endunless -%}{%- endfor -%}{{ _dl_json }}],
    "widths": [{{ widths }}],
    "finishes": [{{ finishes | prepend: '"' | append: '"' | replace: ',', '","' }}],
    "barrel_finishes": [{%- if barrel_finishes != '' -%}{{ barrel_finishes | prepend: '"' | append: '"' | replace: ',', '","' }}{%- endif -%}],
    "bolt_finish": {{ bolt_finish | json }}
  }
{%- endfor -%}
]
{%- endcapture -%}

<script>
  window.__fitmentCatalog = {{ catalog_json }};
</script>