{%- comment -%}
  Calder Wheels — Configurator Quote Intake Modal
  Renders the quote form and its submit handler. Opened (and prefilled) by
  WheelConfigurator.prototype.requestQuote via the element id
  `wheel-configurator-quote-{{ section_id }}`.
  Usage: {% render 'calder-quote-modal', section_id: section.id, product: product %}
{%- endcomment -%}

<div
  id="wheel-configurator-quote-{{ section_id }}"
  class="calder-quote-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="calder-quote-title-{{ section_id }}"
  style="display:none;max-width:600px;width:100%;max-height:90vh;overflow:auto;background:#fff;border-radius:10px;padding:28px;"
>
  <button type="button" class="calder-quote-modal__close" data-quote-close aria-label="Close">&times;</button>
  <div class="calder-quote-modal__content">
    <h3 id="calder-quote-title-{{ section_id }}" class="calder-quote-modal__title">Request a Quote</h3>
    <p class="calder-quote-modal__product" data-quote-product-title></p>
    <p class="calder-quote-modal__config" data-quote-config-summary></p>

    <form id="calder-quote-form-{{ section_id }}" class="calder-quote-modal__form">
      <input type="hidden" name="product_id" value="{{ product.id | default: '' }}">
      <input type="hidden" name="variant_id" value="">
      <input type="hidden" name="product_title" value="{{ product.title | escape | default: '' }}">

      <div class="form-group">
        <label for="calder-quote-name-{{ section_id }}">Full Name *</label>
        <input type="text" id="calder-quote-name-{{ section_id }}" name="name" class="form-control" required placeholder="Your full name" {% if customer %}value="{{ customer.name }}"{% endif %}>
      </div>

      <div class="form-group">
        <label for="calder-quote-email-{{ section_id }}">Email *</label>
        <input type="email" id="calder-quote-email-{{ section_id }}" name="email" class="form-control" required placeholder="your@email.com" {% if customer %}value="{{ customer.email }}"{% endif %}>
      </div>

      <div class="form-group">
        <label for="calder-quote-phone-{{ section_id }}">Phone</label>
        <input type="tel" id="calder-quote-phone-{{ section_id }}" name="phone" class="form-control" placeholder="(555) 123-4567" {% if customer.default_address.phone %}value="{{ customer.default_address.phone }}"{% endif %}>
      </div>

      <div class="form-group">
        <label for="calder-quote-vehicle-{{ section_id }}">Vehicle (Year, Make, Model)</label>
        <input type="text" id="calder-quote-vehicle-{{ section_id }}" name="vehicle" class="form-control" placeholder="e.g. 2024 BMW M3 Competition">
      </div>

      <div class="form-group">
        <label for="calder-quote-qty-{{ section_id }}">Quantity *</label>
        <input type="number" id="calder-quote-qty-{{ section_id }}" name="quantity" class="form-control" min="1" value="1" required>
      </div>

      <div class="form-group">
        <label for="calder-quote-notes-{{ section_id }}">Additional Notes</label>
        <textarea id="calder-quote-notes-{{ section_id }}" name="notes" class="form-control" rows="3" placeholder="Finish preferences, fitment, timeline..."></textarea>
      </div>

      <div class="form-group">
        <label class="calder-quote-modal__checkbox">
          <input type="checkbox" name="dealer_inquiry" value="yes">
          I am a dealer inquiring about wholesale pricing
        </label>
      </div>

      <button type="submit" class="btn cbp-config__add-btn calder-quote-modal__submit">
        <span>Submit Quote Request</span>
      </button>

      <div class="calder-quote-modal__status" style="display:none;"></div>
    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var modal = document.getElementById('wheel-configurator-quote-{{ section_id }}');
    if (!modal) return;
    var form = modal.querySelector('form');

    function openModal() {
      if (typeof jq_lumia !== 'undefined' && jq_lumia.fancybox) {
        jq_lumia.fancybox.open({ src: '#' + modal.id, type: 'inline' });
      } else {
        modal.style.display = 'block';
      }
    }
    function closeModal() {
      if (typeof jq_lumia !== 'undefined' && jq_lumia.fancybox) {
        jq_lumia.fancybox.close();
      }
      modal.style.display = 'none';
    }

    var closeBtn = modal.querySelector('[data-quote-close]');
    if (closeBtn) closeBtn.addEventListener('click', closeModal);

    modal.addEventListener('click', function (e) {
      if (e.target === modal) closeModal();
    });

    if (!form) return;
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var submitBtn = form.querySelector('button[type="submit"]');
      var statusEl = form.querySelector('.calder-quote-modal__status');
      if (submitBtn) submitBtn.disabled = true;
      if (statusEl) { statusEl.style.display = 'block'; statusEl.className = 'calder-quote-modal__status'; statusEl.textContent = 'Submitting...'; }

      var data = {};
      new FormData(form).forEach(function (value, key) { data[key] = value; });

      var apiBase = window.CALDER_API_BASE || '';
      var quoteUrl = apiBase ? apiBase + '/api/configurator/quote' : '/apps/wheel-configurator/api/quote';
      var xhr = new XMLHttpRequest();
      xhr.open('POST', quoteUrl, true);
      xhr.setRequestHeader('Content-Type', 'application/json');
      xhr.onload = function () {
        if (xhr.status === 200 || xhr.status === 201) {
          if (statusEl) {
            statusEl.className = 'calder-quote-modal__status calder-quote-modal__status--success';
            statusEl.textContent = 'Quote request submitted! We will contact you within 1-2 business days.';
          }
          form.querySelectorAll('input, textarea, button').forEach(function (el) { el.disabled = true; });
          setTimeout(closeModal, 3000);
        } else {
          if (statusEl) {
            statusEl.className = 'calder-quote-modal__status calder-quote-modal__status--error';
            statusEl.textContent = 'There was an error submitting your request. Please try again or contact us directly.';
          }
          if (submitBtn) submitBtn.disabled = false;
        }
      };
      xhr.onerror = function () {
        if (statusEl) {
          statusEl.className = 'calder-quote-modal__status calder-quote-modal__status--error';
          statusEl.textContent = 'Network error. Please check your connection and try again.';
        }
        if (submitBtn) submitBtn.disabled = false;
      };
      xhr.send(JSON.stringify(data));
    });
  });
</script>

<style>
  .calder-quote-modal { position: relative; z-index: 9999; }
  .calder-quote-modal__close {
    position: absolute; top: 10px; right: 14px;
    background: none; border: 0; font-size: 1.6rem; line-height: 1;
    color: #999; cursor: pointer; z-index: 2;
  }
  .calder-quote-modal__close:hover { color: #222; }
  .calder-quote-modal__title { font-size: 1.35rem; margin: 0 0 6px; }
  .calder-quote-modal__product { margin: 0 0 4px; font-weight: 600; font-size: 0.95rem; }
  .calder-quote-modal__config { margin: 0 0 18px; }
  .calder-quote-modal .form-group { margin-bottom: 14px; }
  .calder-quote-modal label { display: block; font-size: 0.82rem; margin-bottom: 5px; color: #444; }
  .calder-quote-modal .form-control {
    width: 100%; padding: 9px 12px; font-size: 0.95rem;
    border: 1px solid #d7d7d7; border-radius: 5px; background: #fff; color: #222;
  }
  .calder-quote-modal__checkbox { display: flex; align-items: center; gap: 8px; cursor: pointer; }
  .calder-quote-modal__status { margin-top: 14px; padding: 11px 14px; border-radius: 6px; font-size: 0.9rem; }
  .calder-quote-modal__status--success { background: rgba(34,197,94,0.1); color: #15803d; border: 1px solid rgba(34,197,94,0.25); }
  .calder-quote-modal__status--error { background: rgba(239,68,68,0.1); color: #b91c1c; border: 1px solid rgba(239,68,68,0.25); }
</style>