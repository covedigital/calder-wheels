{% comment %}theme-check-disable NestedSnippet, UndefinedObject{% endcomment %}
<script src="{{ 'calder-product-card.js' | asset_url }}" defer></script>
{%- for product in collection.products limit: 6 -%}
    {%- liquid
        if product.id == current_product.id
        continue
        endif
    -%}
    <div class="col-3 swiper-slide">
        {% render 'calder-product-card', product: product, collection: collection %}
    </div>
{%- endfor -%}