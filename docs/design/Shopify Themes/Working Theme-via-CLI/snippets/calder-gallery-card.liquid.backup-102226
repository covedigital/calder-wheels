{% comment %}
  Calder Gallery — Shared Gallery Card
  Renders a gallery card for vehicle or wheel type.
  Parameters: image, heading, meta_lines, badges, url, type, dataset_attrs, lazy
{% endcomment %}
{%- liquid
  assign image_url = image | image_url: width: 800
  assign image_alt = heading | escape
  assign image_srcset = ''
  if image != blank
    assign image_srcset = image | image_url: width: 400 | append: ' 400w, ' | append: image | image_url: width: 600 | append: ' 600w, ' | append: image_url | append: ' 800w'
  endif
-%}
<a href="{{ url }}" class="calder-gallery-grid__item" {{ dataset_attrs }}>
  <div class="calder-gallery-grid__image-wrap">
    {%- if image != blank -%}
      <img src="{{ image_url }}" data-srcset="{{ image_srcset }}" data-sizes="auto" alt="{{ image_alt }}" class="calder-gallery-grid__image blur-up" loading="lazy" width="800" height="600">
    {%- else -%}
      <div class="calder-gallery-grid__image" style="background:var(--body-bg-secondary,#1a1a1a);min-height:240px;"></div>
    {%- endif -%}
    <div class="calder-gallery-grid__overlay"></div>
  </div>
  <div class="calder-gallery-grid__info">
    {%- if type == 'vehicle' -%}
      <div class="calder-gallery-grid__vehicle">{{ heading }}</div>
      {%- if meta_lines.size > 0 -%}
        <div class="calder-gallery-grid__wheel">{{ meta_lines | join: ' · ' }}</div>
      {%- endif -%}
    {%- elsif type == 'wheel' -%}
      {%- if meta_lines.size > 0 -%}
        <div class="calder-gallery-grid__wheel-series">{{ meta_lines[0] }}</div>
      {%- endif -%}
      <div class="calder-gallery-grid__wheel-name">{{ heading }}</div>
      {%- if meta_lines.size > 1 -%}
        <div class="calder-gallery-grid__wheel-finish">{{ meta_lines[1] }}</div>
      {%- endif -%}
    {%- endif -%}
    {%- if badges.size > 0 -%}
      <div class="calder-gallery-grid__meta">
        {%- for badge in badges -%}
          <span class="calder-gallery-grid__badge">{{ badge }}</span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</a>