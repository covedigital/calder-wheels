/* =========================================================
   SIGNATURE WHEELS
   ========================================================= */

.bnr .bnr-text2 {
    margin: 0 !important;
    max-width: 520px;

    font-family: "Facundo", Georgia, "Times New Roman", serif !important;

    font-size: clamp(52px, 5.3vw, 82px) !important;
