    letter-spacing: -0.025em !important;
    text-transform: uppercase;

    color: #F2EFE9 !important;
}


/*
   Force the existing "Signature Wheels" text
   to wrap similarly to the reference.

   Width controls the natural break between
   Signature and Wheels.
*/
.bnr .bnr-text2 span {
    display: block;
    max-width: 480px;
}


/* =========================================================
   DESCRIPTION
   Since the Liquid doesn't contain one, generate it
   visually through CSS.
   ========================================================= */

.bnr .bnr-text2::after {
    content:
        "Distinct designs. Engineered to elevate\A"
        "performance, style, and presence\A"
        "on every road.";

    white-space: pre-line;
    display: block;
    max-width: 420px;
    margin-top: 24px;
    font-family: "Inter", "Garet", "Poppins", sans-serif !important;
    font-size: 15px !important;
    line-height: 1.5 !important;
    font-weight: 400 !important;

    letter-spacing: 0 !important;
    text-transform: none;

    color: rgba(242, 239, 233, 0.88);
}


/* =========================================================
   BUTTON
   ========================================================= */

.bnr .bnr-btn-wrap {
    margin-top: 30px !important;
}


.bnr .bnr-btn-wrap .btn {
    display: inline-flex !important;

    align-items: center;
    justify-content: space-between;

    min-width: 250px;
    min-height: 66px;

    padding: 0 28px !important;

    border: 1px solid rgba(255,255,255,.2) !important;
    border-radius: 5px !important;

    background:
        linear-gradient(
            90deg,
            #E9BC76 0%,
            #D5A45E 100%
        ) !important;

    color: #231F20 !important;

    font-family: "Inter", "Garet", "Poppins", sans-serif !important;

    font-size: 13px !important;
    line-height: 1 !important;
    font-weight: 700 !important;

    letter-spacing: .09em !important;
    text-transform: uppercase;

    box-shadow: 0 8px 25px rgba(0,0,0,.2);

    transition:
        transform .2s ease,
        box-shadow .2s ease;
}


/* Change visible "View all" is NOT possible through CSS,
   but we can add the arrow */
.bnr .bnr-btn-wrap .btn::after {
    content: "→";

    margin-left: 40px;

    font-family: Arial, sans-serif;
    font-size: 21px;
    font-weight: 400;

    line-height: 1;

    transition: transform .2s ease;
}


.bnr .bnr-btn-wrap .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(0,0,0,.28);
}


.bnr .bnr-btn-wrap .btn:hover::after {
    transform: translateX(4px);
}


/* =========================================================
   DARK READABILITY GRADIENT
   ========================================================= */

.bnr::after {
    content: "";

    position: absolute;
    inset: 0;

    background:
        linear-gradient(
            90deg,
            rgba(5,10,13,.90) 0%,
            rgba(5,10,13,.72) 28%,
            rgba(5,10,13,.42) 52%,
            rgba(5,10,13,0) 75%
        );

    pointer-events: none;
    z-index: 1;
}


.bnr .bnr-caption {
    position: relative;
    z-index: 2;
}


