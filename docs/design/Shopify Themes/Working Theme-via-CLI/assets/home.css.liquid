  font-family: var(--calder-heading-font);
  font-weight: 650;
  font-size: 36px;
  text-transform: uppercase;
  color: var(--calder-ink);
  letter-spacing: -0.02em;
  margin: 0;
}

.home-gallery__view-all {
  font-family: var(--calder-ui-font);
  font-weight: 700;
  font-size: 0.65rem;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  color: var(--calder-copper);
  text-decoration: none;
}

.home-gallery__panels {
  display: grid;
  grid-template-columns: 64fr 36fr;
  gap: 0;
  border-radius: 2px;
  overflow: hidden;
  box-shadow: var(--calder-shadow-sm);
}

.home-gallery__cta-panel {
  padding: 2.5rem 20rem 2.5rem 2.5rem;
  display: flex;
  flex-direction: column;
  justify-content: center;

  background-color: var(--calder-ivory);

  background-image:
    linear-gradient(
      90deg,
      rgba(244, 241, 234, 1) 0%,
      rgba(244, 241, 234, 0.97) 38%,
      rgba(244, 241, 234, 0.25) 72%,
      rgba(244, 241, 234, 0) 100%
    ),
    url('https://cdn.shopify.com/s/files/1/1017/6325/2533/files/disassembly-mock-placeholder-1.png?v=1790034814');

  background-size: cover, contain;
  background-repeat: no-repeat;
  background-position: center, right center;
}

.home-gallery__cta-eyebrow {
  font-family: var(--calder-ui-font);
  font-weight: 700;
  font-size: 9px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--calder-gold);
  margin-bottom: 4px;
}

.home-gallery__cta-heading {
  font-family: var(--calder-ui-font);
  font-weight: 700;
  font-size: 16px;
  text-transform: uppercase;
  color: var(--calder-ink);
  letter-spacing: -0.02em;
  margin-bottom: 6px;
}

.home-gallery__cta-body {
  font-family: var(--calder-ui-font);
  font-weight: 350;
  font-size: 14px;
  line-height: 1.5;
  color: var(--calder-muted);
  margin-bottom: 14px;
}

.home-gallery__cta-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 20px;
  background: var(--calder-gradient-navy);
  color: var(--calder-white);
  font-family: var(--calder-ui-font);
  font-weight: 700;
  font-size: 0.65rem;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  border: none;
  border-radius: 2px;
  cursor: pointer;
  text-decoration: none;
  align-self: flex-start;
  transition:
    background 0.2s ease,
    transform 0.2s ease;
}

.home-gallery__cta-btn:hover {
  background: var(--calder-blue);
  transform: translateY(-1px);
}

.home-gallery__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  min-height: 120px;
}


/* ==========================================================
   NEWSLETTER — THE BUILD DROP
   ========================================================== */

.home-newsletter {
  position: relative;
  overflow: hidden;
  min-height: 200px;
  display: flex;
  align-items: center;
  background: var(--calder-navy-dark);
}

.home-newsletter__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.home-newsletter__bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.home-newsletter__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: var(--calder-gradient-newsletter-overlay);
}

.home-newsletter__container {
  position: relative;
  z-index: 2;
  max-width: var(--calder-content-max-width);
  margin: 0 auto;
  padding: 30px var(--calder-gutter);
  width: 100%;
}

.home-newsletter__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
}

.home-newsletter__content {
  flex-shrink: 0;
}

.home-newsletter__heading {
  font-family: var(--calder-ui-font);
  font-weight: 700;
  font-size: 18px;
  color: var(--calder-white);
  margin-bottom: 2px;
}

.home-newsletter__body {
  font-family: var(--calder-ui-font);
  font-weight: 350;
  font-size: 14px;
  color: rgba(255, 255, 255, 0.72);
}

.home-newsletter__form {
  display: flex;
  gap: 8px;
  flex-shrink: 0;
}

.home-newsletter__input {
  padding: 8px 14px;
  font-family: var(--calder-ui-font);
  font-weight: 350;
  font-size: 12px;
  color: var(--calder-ink);
  background: rgba(255, 255, 255, 0.96);
  border: 1px solid rgba(255, 255, 255, 0.22);
  border-radius: 2px;
  min-width: 200px;
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.home-newsletter__input:focus {
  border-color: var(--calder-gold);
  outline: none;
  box-shadow: 0 0 0 3px rgba(213, 163, 92, 0.15);
}

.home-newsletter__submit {
  padding: 8px 20px;
  background: var(--calder-gradient-button);
  color: var(--calder-navy-dark);
  font-family: var(--calder-ui-font);
  font-weight: 700;
  font-size: 12px;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  border: none;
  border-radius: 2px;
  cursor: pointer;
  box-shadow: var(--calder-shadow-gold);
  transition:
    background 0.2s ease,
    transform 0.2s ease;
}

.home-newsletter__submit:hover {
  background: var(--calder-gradient-button-hover);
  transform: translateY(-1px);
}


/* ==========================================================
   FOOTER
   ========================================================== */

.calder-site .page-footer {
  background: var(--calder-gradient-dark-vertical);
  color: rgba(255, 255, 255, 0.70);
  border-top: 1px solid rgba(255, 255, 255, 0.07);
}

.calder-site .page-footer a {
  color: rgba(255, 255, 255, 0.70);
  transition:
    color 0.2s ease,
    opacity 0.2s ease;
}

.calder-site .page-footer a:hover {
  color: var(--calder-champagne);
}


/* ==========================================================
   BRAND TICKER
   ========================================================== */

.calder-site .theme-editor-init-swiper-carousel {
  background: var(--calder-warm-white);
}

.calder-site .theme-editor-init-swiper-carousel .bnr-text1,
.calder-site .theme-editor-init-swiper-carousel .h-sub {
  color: var(--calder-muted) !important;
}


/* ==========================================================
   PRODUCT CAROUSEL TABS
   ========================================================== */

.calder-site .tab-carousel-tab .tab-item {
  font-family: var(--calder-ui-font);
  font-weight: 700;
  font-size: 10px;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  color: var(--calder-muted);
  border-bottom-color: transparent;
  transition:
    color 0.2s ease,
    border-color 0.2s ease;
}

.calder-site .tab-carousel-tab .tab-item.active-tab {
  color: var(--calder-navy);
  border-bottom-color: var(--calder-gold);
}

.calder-site .tab-carousel-tab .tab-item:hover {
  color: var(--calder-copper);
}

.calder-site .section-tabs-carousel .prd-title {
  font-family: var(--calder-ui-font);
  font-weight: 700;
  font-size: 14px;
  color: var(--calder-ink);
  text-transform: uppercase;
}

.calder-site .section-tabs-carousel .prd-price,
.calder-site .section-tabs-carousel .prd-price .money {
  font-family: var(--calder-ui-font);
  font-weight: 700;
  color: var(--calder-navy);
}

.calder-site .section-tabs-carousel .prd-info {
  font-family: var(--calder-ui-font);
  font-weight: 350;
  font-size: 11px;
  color: var(--calder-muted);
}


/* ==========================================================
   ENGINEERING STATS CARDS
   ========================================================== */

.calder-site .about-benefits .info-block {
  background: var(--calder-gradient-warm-light);
  border: 1px solid rgba(35, 67, 84, 0.08);
  border-radius: 4px;
  padding: 30px 20px;
  text-align: center;
  box-shadow: var(--calder-shadow-sm);
}

.calder-site .about-benefits .info-block .h3 {
  font-family: var(--calder-ui-font);
  font-weight: 700;
  font-size: 14px;
  color: var(--calder-ink);
  text-transform: uppercase;
  letter-spacing: 0.02em;
  margin-bottom: 8px;
}

.calder-site .about-benefits .info-block .info-block-text {
  font-family: var(--calder-ui-font);
  font-weight: 350;
  font-size: 12px;
  color: var(--calder-muted);
  line-height: 1.5;
}

.calder-site .about-benefits .info-block .info-block-count {
  font-family: var(--calder-ui-font);
  font-weight: 700;
  font-size: 32px;
  color: var(--calder-navy);
  line-height: 1;
  margin-bottom: 4px;
}

.calder-site .about-benefits .info-block .info-block-icon svg {
  color: var(--calder-gold);
  width: 36px;
  height: 36px;
}


/* ==========================================================
   VERTICAL SLIDER
   ========================================================== */

.calder-site .vertical-slider-holder .vertical-slider-caption {
  max-width: 600px;
  margin: 0 auto;
}

.calder-site .vertical-slider-holder .vertical-slider-title {
  font-family: var(--calder-heading-font);
  font-weight: 700;
  font-size: 48px;
  color: var(--calder-white);
  text-transform: uppercase;
  letter-spacing: -0.02em;
  line-height: 1.05;
  margin-bottom: 16px;
}

.calder-site .vertical-slider-holder .vertical-slider-text {
  font-family: var(--calder-ui-font);
  font-weight: 350;
  font-size: 15px;
  color: rgba(255, 255, 255, 0.72);
  line-height: 1.6;
}

.calder-site .vertical-slider-holder .btn--white {
  font-family: var(--calder-ui-font);
  font-weight: 700;
  font-size: 12px;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  color: var(--calder-navy-dark) !important;
  background: var(--calder-gradient-button) !important;
  border: none;
  border-radius: 2px;
  padding: 12px 28px;
  box-shadow: var(--calder-shadow-gold);
}

.calder-site .vertical-slider-holder .btn--white:hover {
  background: var(--calder-gradient-button-hover) !important;
  color: var(--calder-navy-dark) !important;
}


/* ==========================================================
   NATIVE SECTION HEADINGS
   ========================================================== */

.calder-site .holder .h-custom-style,
.calder-site .holder .h-sub {
  font-family: var(--calder-ui-font);
}

.calder-site .holder .h-custom-style {
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: -0.02em;
  color: var(--calder-ink);
}

.calder-site .holder .h-sub {
  font-weight: 350;
  color: var(--calder-muted);
}


/* ==========================================================
   ACCESSIBILITY / INTERACTION
   ========================================================== */

.calder-site a:focus-visible,
.calder-site button:focus-visible,
.calder-site input:focus-visible,
.calder-site select:focus-visible {
  outline: 2px solid var(--calder-champagne);
  outline-offset: 3px;
}


/* ==========================================================
   RESPONSIVE
   ========================================================== */

@media (max-width: 768px) {

  .home-hero {
    min-height: 520px;
  }

  .home-hero__container {
    padding: 0 20px;
    min-height: 280px;
  }

  .home-hero__content {
    max-width: 100%;
    padding: 6rem 0 5rem;
  }

  /* ── Fitment responsive ── */

  .hf-fitment {
    margin-top: -40px;
  }

  .hf-fitment__shell {
    padding: 0 16px;
  }

  .hf-fitment__tab {
    padding: 14px 20px;
    font-size: 0.75rem;
    -webkit-clip-path: none !important;
    clip-path: none !important;
    border-radius: 8px 8px 0 0;
    border: 1px solid #52616A;
    border-bottom: none;
  }

  .hf-fitment__tab:first-child,
  .hf-fitment__tab:last-child {
    padding-left: 20px;
    padding-right: 20px;
    -webkit-clip-path: none !important;
    clip-path: none !important;
    border-radius: 8px 8px 0 0;
  }

  .hf-fitment__tab--active::after,
  .hf-fitment__tab[aria-selected="true"]::after {
    left: 0;
    right: 0;
  }

  .hf-fitment__tab-icon {
    width: 16px;
    height: 16px;
  }

  .hf-fitment__panel {
    border-radius: 0 12px 12px 12px;
    min-height: 0;
  }

  .hf-fitment__layout {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .hf-fitment__finder {
    flex: none;
  }

  .hf-fitment__divider {
    display: none;
  }

  .hf-fitment__vehicle {
    width: auto;
    padding: 20px;
    border-top: 1px solid #52616A;
    margin: 0 20px;
  }

  .hf-fitment__vehicle-inner {
    padding: 0;
  }

  .hf-fitment__vehicle-hdivider {
    width: 100%;
  }

  .hf-fitment__heading-group {
    padding: 20px 20px 0;
  }

  .hf-fitment__heading {
    font-size: 26px;
  }

  .hf-fitment__controls {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding: 12px 20px 0;
  }

  .hf-fitment__control,
  .hf-fitment__control--year,
  .hf-fitment__control--make,
  .hf-fitment__control--model,
  .hf-fitment__control--trim {
    width: 100%;
  }

  .hf-fitment__action {
    grid-column: 1 / -1;
    width: 100%;
  }

  .hf-fitment__cta {
    width: 100%;
    height: 56px;
  }

  .hf-fitment__select {
    height: 52px;
  }

  .hf-fitment__art {
    display: none;
  }

  .hf-fitment__results {
    padding: 12px 20px 4px;
  }

  .home-signature__grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .home-customize {
    flex-direction: column;
  }

  .home-customize__image {
    flex: 0 0 200px;
  }

  .home-customize__copy {
    padding: 24px 20px;
  }

  .home-customize__steps {
    flex-wrap: wrap;
    gap: 12px;
  }

  .home-engineering__container {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .home-process__strip {
    grid-template-columns: repeat(2, 1fr);
  }

  .home-gallery__panels {
    grid-template-columns: 1fr;
  }

  .home-gallery__cta-panel {
    padding: 2rem;
    background-position: center, right center;
  }

  .home-newsletter__inner {
    flex-direction: column;
    text-align: center;
  }

  .home-newsletter__form {
    width: 100%;
    max-width: 360px;
  }

  .home-newsletter__input {
    flex: 1;
    min-width: 0;
  }
}


/* ==========================================================
   REDUCED MOTION
   ========================================================== */

@media (prefers-reduced-motion: reduce) {

  .calder-site *,
  .calder-site *::before,
  .calder-site *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }

}