/* ==========================================================
   NEWSLETTER — THE BUILD DROP
   ========================================================== */

.home-newsletter {
  position: relative;
  overflow: hidden;
  min-height: 200px;
  display: flex;
  align-items: center;
  background: var(--calder-navy-dark);
}

.home-newsletter__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.home-newsletter__bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.home-newsletter__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: var(--calder-gradient-newsletter-overlay);
}

.home-newsletter__container {
  position: relative;
  z-index: 2;
  max-width: var(--calder-content-max-width);
  margin: 0 auto;
  padding: 30px var(--calder-gutter);
  width: 100%;
}

.home-newsletter__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
}

.home-newsletter__content {
  flex-shrink: 0;
}

.home-newsletter__heading {
  font-family: var(--calder-ui-font);
  font-weight: 700;
  font-size: 18px;
  color: var(--calder-white);
  margin-bottom: 2px;
}

.home-newsletter__body {
  font-family: var(--calder-ui-font);
  font-weight: 300;
  font-size: 14px;
  color: rgba(255, 255, 255, 0.72);
}

.home-newsletter__form {
  display: flex;
  gap: 8px;
  flex-shrink: 0;
}

.home-newsletter__input {
  padding: 8px 14px;
  font-family: var(--calder-ui-font);
  font-weight: 300;
  font-size: 12px;
  color: var(--calder-ink);
  background: rgba(255, 255, 255, 0.96);
  border: 1px solid rgba(255, 255, 255, 0.22);
  border-radius: 2px;
  min-width: 200px;
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.home-newsletter__input:focus {
  border-color: var(--calder-champagne);
  outline: none;
  box-shadow: 0 0 0 3px rgba(213, 163, 92, 0.15);
}

.home-newsletter__submit {
  padding: 8px 20px;
  background: var(--calder-gradient-button);
  color: var(--calder-navy-dark);
  font-family: var(--calder-ui-font);
  font-weight: 700;
  font-size: 12px;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  border: none;
  border-radius: 2px;
  cursor: pointer;
  box-shadow: var(--calder-shadow-gold);
  transition:
    background 0.2s ease,
    transform 0.2s ease;
}

.home-newsletter__submit:hover {
  background: var(--calder-gradient-button-hover);
  transform: translateY(-1px);
}


/* ==========================================================
   RESPONSIVE
   ========================================================== */

@media (max-width: 768px) {

  .home-hero {
    min-height: 520px;
  }

  .home-hero__container {
    padding: 0 20px;
    min-height: 520px;
  }

  .home-hero__content {
    max-width: 100%;
    padding: 14rem 0 0rem;
  }

  .home-hero__body {
    display: none;
  }

  .home-hero__proof-points {
    display: none;
  }

  /* ── Fitment responsive ── */

  .hf-fitment {
    margin-top: -40px;
  }

  .hf-fitment__shell {
    padding: 0 16px;
  }

  .hf-fitment__tab {
    padding: 14px 20px;
    font-size: 0.75rem;
    -webkit-clip-path: none !important;
    clip-path: none !important;
    border-radius: 8px 8px 0 0;
    border: 1px solid #52616A;
    border-bottom: none;
  }

  .hf-fitment__tab:first-child,
  .hf-fitment__tab:last-child {
    padding-left: 20px;
    padding-right: 20px;
    -webkit-clip-path: none !important;
    clip-path: none !important;
    border-radius: 8px 8px 0 0;
  }

  .hf-fitment__tab--active::after,
  .hf-fitment__tab[aria-selected="true"]::after {
    left: 0;
    right: 0;
  }

  .hf-fitment__tab-icon {
    width: 16px;
    height: 16px;
  }

  .hf-fitment__panel {
    border-radius: 0 12px 12px 12px;
    min-height: 0;
  }

  .hf-fitment__layout {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .hf-fitment__finder {
    flex: none;
  }

  .hf-fitment__divider {
    display: none;
  }

  .hf-fitment__vehicle {
    width: auto;
    padding: 20px;
    border-top: 1px solid #52616A;
    margin: 0 20px;
    display: none;
  }

  .hf-fitment__vehicle-inner {
    padding: 0;
  }

  .hf-fitment__vehicle-hdivider {
    width: 100%;
  }

  .hf-fitment__heading-group {
    padding: 20px 20px 0;
  }

  .hf-fitment__heading {
    font-size: 26px;
  }

  .hf-fitment__controls {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding: 12px 20px 0;
  }

  .hf-fitment__control,
  .hf-fitment__control--year,
  .hf-fitment__control--make,
  .hf-fitment__control--model,
  .hf-fitment__control--trim {
    width: 100%;
  }

  .hf-fitment__action {
    grid-column: 1 / -1;
    width: 100%;
  }

  .hf-fitment__cta {
    width: 100%;
    height: 56px;
  }

  .hf-fitment__select {
    height: 52px;
  }

  .hf-fitment__art {
    display: none;
  }

  .hf-fitment__results {
    padding: 12px 20px 4px;
  }

  .home-signature__grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .home-customize {
    flex-direction: column;
    background-position: left;
  }

  .home-customize__image {
    flex: 0 0 200px;
  }

  .home-customize__copy {
    padding: 2rem;
  }

  .home-customize__steps {
    flex-wrap: wrap;
    gap: 12px;
  }

  .home-engineering__container {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .home-process__strip {
    grid-template-columns: repeat(2, 1fr);
  }

  .home-gallery__panels {
    grid-template-columns: 1fr;
  }

  .home-gallery__cta-panel {
    padding: 2rem;
    background-position: center, right center;
    background-image: none;
  }

  .home-newsletter__inner {
    flex-direction: column;
    text-align: center;
  }

  .home-newsletter__form {
    width: 100%;
    max-width: 360px;
  }

  .home-newsletter__input {
    flex: 1;
    min-width: 0;
  }
}

