{%- comment -%}Calder Wheels — Custom Font Loading{%- endcomment -%}
@font-face {
    font-family: 'Facundo';
    src: url('{{ "Facundo-SemiBold.otf" | asset_url }}') format('opentype');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: 'Garet';
    src: url('{{ "Garet-Book.otf" | asset_url }}') format('opentype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
}

/* Garet Bold: the supplied garet-bold.otf is a 96-glyph ASCII-only subset
   (missing en/em dashes, curly quotes, apostrophe, minus — mobile per-glyph
   fallback). Until a complete Garet Bold is supplied, the 700 slot serves
   Poppins Bold (brand-sanctioned fallback, complete Latin coverage). */
@font-face {
    font-family: 'Garet';
    src: url('{{ "Poppins-Bold.ttf" | asset_url }}') format('truetype');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: 'Poppins';
    src: url('{{ "Poppins-Light.ttf" | asset_url }}') format('truetype');
    font-weight: 300;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: 'Poppins';
    src: url('{{ "Poppins-Bold.ttf" | asset_url }}') format('truetype');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
}