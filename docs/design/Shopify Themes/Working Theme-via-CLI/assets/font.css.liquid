{%- comment -%}Calder Wheels — Custom Font Loading{%- endcomment -%}
@font-face {
    font-family: 'Facundo';
    src: url('{{ "Facundo-SemiBold.otf" | asset_url }}') format('opentype');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: 'Garet';
    src: url('{{ "Garet-Book.otf" | asset_url }}') format('opentype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: 'Garet';
    src: url('{{ "garet-bold.otf" | asset_url }}') format('opentype');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: 'Poppins';
    src: url('{{ "Poppins-Light.ttf" | asset_url }}') format('truetype');
