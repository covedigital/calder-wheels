                  <span>Track and street validated</span>
                </div>

              </div>

            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>


{% schema %}
{
  "name": "Calder Specs & Eng",
  "tag": "section",
  "class": "calder-specs-wrap",

  "settings": [

    {
      "type": "header",
      "content": "Specifications"
    },

    {
      "type": "text",
      "id": "specs_heading",
      "label": "Heading",
      "default": "Specifications"
    },

    {
      "type": "text",
      "id": "spec_diameter",
      "label": "Diameter",
      "default": "18\" — 22\""
    },

    {
      "type": "text",
      "id": "spec_width",
      "label": "Width",
      "default": "8.5\" — 11\""
    },

    {
      "type": "text",
      "id": "spec_bolt",
      "label": "Bolt Pattern",
      "default": "5x112"
    },

    {
      "type": "text",
      "id": "spec_offset",
      "label": "Offset",
      "default": "+22 to +45"
    },

    {
      "type": "text",
      "id": "spec_construction",
      "label": "Construction",
      "default": "3-Piece Forged"
    },

    {
      "type": "text",
      "id": "spec_weight",
      "label": "Weight",
      "default": "24.5 lbs"
    },

    {
      "type": "text",
      "id": "spec_load",
      "label": "Load Rating",
      "default": "1,600 lbs"
    },

    {
      "type": "text",
      "id": "spec_finish",
      "label": "Finish",
      "default": "Multiple Options"
    },


    {
      "type": "header",
      "content": "Engineering"
    },

    {
      "type": "text",
      "id": "engineering_heading",
      "label": "Heading",
      "default": "Engineered to Perform"
    },

    {
      "type": "textarea",
      "id": "engineering_text",
      "label": "Description",
      "default": "Every Calder wheel is precision-engineered from aerospace-grade materials, assembled to order by master craftsmen, and validated through rigorous testing before delivery."
    },

    {
      "type": "image_picker",
      "id": "engineering_image",
      "label": "Engineering background image"
    },


    {
      "type": "header",
      "content": "SECTION GENERAL"
    },

    {
      "type": "checkbox",
      "id": "section_animation",
      "label": "Enable soft appearing of section",
      "default": true,
      "info": "Global sections animation disabling in Theme Settings / General / Sections. AUTODISABLED if section has top or bottom separator."
    },


    {
      "type": "header",
      "content": "SECTION WIDTH"
    },

    {
      "type": "select",
      "id": "section_width",
      "label": "Select width source",
      "options": [
        {
          "value": "global",
          "label": "Use store width"
        },
        {
          "value": "custom",
          "label": "Custom width"
        }
      ],
      "default": "global",
      "info": "Store width you can set in Theme Settings / General"
    },

    {
      "type": "range",
      "id": "container_max_width",
      "min": 1178,
      "max": 1978,
      "step": 8,
      "unit": "px",
      "label": "Custom width",
      "default": 1178,
      "info": "The specified width may differ from the actual width of the section because this section uses a smart grid for the most successful arrangement of columns in rows and for best view. Columns are not scaled, but added when the section width is increased."
    },


    {
      "type": "header",
      "content": "SECTION MARGIN"
    },

    {
      "type": "range",
      "id": "spacing_sections",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Vertical space above the section on Desktop",
      "default": 100
    },

    {
      "type": "checkbox",
      "id": "use_global_desktop_space",
      "label": "Use global space on desktop",
      "default": true,
      "info": "from Theme Settings / General / Layout"
    },

    {
      "type": "range",
      "id": "spacing_sections_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Vertical space above the section on Mobile",
      "default": 70
    },

    {
      "type": "checkbox",
      "id": "use_global_mobile_space",
      "label": "Use global space on mobile",
      "default": true,
      "info": "from Theme Settings / General / Layout"
    },


    {
      "type": "header",
      "content": "SECTION PADDING",
      "info": "Only if SECTION BACKGROUND or SECTION SEPARATOR was enabled"
    },

    {
      "type": "range",
      "id": "spacing_padding_sections",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Vertical inner padding on Desktop",
      "default": 100
    },

    {
      "type": "checkbox",
      "id": "use_global_desktop_space_padding",
      "label": "Use global inner padding on desktop",
      "default": true,
      "info": "from Theme Settings / General / Layout"
    },

    {
      "type": "range",
      "id": "spacing_padding_sections_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Vertical inner padding on Mobile",
      "default": 70
    },

    {
      "type": "checkbox",
      "id": "use_global_mobile_space_padding",
      "label": "Use global inner padding on Mobile",
      "default": true,
      "info": "from Theme Settings / General / Layout"
    },


    {
      "type": "header",
      "content": "SECTION BACKGROUND"
    },

    {
      "type": "checkbox",
      "id": "background",
