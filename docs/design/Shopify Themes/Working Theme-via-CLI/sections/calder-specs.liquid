                  </svg>
                </div>

                <div class="calder-engineering__cap-text">
                  <strong>Strength Tested</strong>
                  <span>Exceeds SAE J2530</span>
                </div>

              </div>


              {%- comment -%} Real World Proven {%- endcomment -%}

              <div class="calder-engineering__cap">

                <div class="calder-engineering__cap-icon" aria-hidden="true">
                  <svg class="calder-engineering__icon" width="32" height="32" viewBox="0 0 512 512" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
