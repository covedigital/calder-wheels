{% comment %}theme-check-disable NestedSnippet{% endcomment %}

{%- liquid
  assign eng_image = section.settings.engineering_image
  assign eng_text = section.settings.engineering_text

  assign bolt_pattern = product.metafields.custom.bolt_pattern.value
  assign center_bore = product.metafields.custom.center_bore.value
  assign construction = product.metafields.custom.construction.value
  assign load_rating = product.metafields.custom.load_rating.value
  assign design_code = product.metafields.custom.design_code.value
  assign series = product.metafields.custom.series.value

  assign bom_data = product.metafields.custom.bom.value
  assign bom_components = bom_data.components | default: bom_data

  assign center_finishes = ''
  assign barrel_finishes = ''
  assign hardware_finishes = ''

  if bom_components
    for c in bom_components
      if c.type == 'center'
        assign center_finishes = center_finishes | append: c.name | append: ', '
      elsif c.type == 'barrel'
        assign barrel_finishes = barrel_finishes | append: c.name | append: ', '
      elsif c.type == 'hardware'
        assign hardware_finishes = hardware_finishes | append: c.name | append: ', '
      endif
    endfor
    assign center_finishes = center_finishes | strip | remove_last: ','
    assign barrel_finishes = barrel_finishes | strip | remove_last: ','
    assign hardware_finishes = hardware_finishes | strip | remove_last: ','
  endif

  assign uc_design_code = product.metafields.custom.design_code.value | default: product.metafields.custom.design_code | default: '' | strip | upcase
  assign uc_design_key = uc_design_code | remove: '-'
  assign is_universal_design = false
  if uc_design_key == 'CLM01' or uc_design_key == 'CLM02' or uc_design_key == 'CLM03' or uc_design_key == 'CLM05' or uc_design_key == 'CLB06' or uc_design_key == 'CLB07' or uc_design_key == 'CLM06' or uc_design_key == 'CLM07'
    assign is_universal_design = true
  endif

  assign diameters = ''
  assign variant_sizes = ''
  for v in product.variants
    assign opt = v.option1 | default: v.title
    if opt contains 'in' or opt contains '"'
      assign size_clean = opt | strip
      unless diameters contains size_clean
        if diameters != ''
          assign diameters = diameters | append: ', '
        endif
        assign diameters = diameters | append: size_clean
      endunless
    endif
  endfor
-%}

<div class="calder-specs-section">
  <div class="container">

    <div class="calder-specs-grid">

      {%- comment -%}
        ============================================================
        SPECIFICATIONS
        ============================================================
      {%- endcomment -%}

      <div class="calder-specs">
        <div class="calder-eyebrow">Product Details</div>

        <h2 class="calder-specs__heading">
          {{ section.settings.specs_heading | default: 'Specifications' }}
        </h2>

          <table class="calder-specs__table">
            <tbody>

              {% if design_code %}
              <tr>
                <td>Design</td>
                <td>{{ design_code }}</td>
              </tr>
              {% endif %}

              {%- if is_universal_design -%}
              <tr>
                <td>SKU</td>
                <td data-calder-spec="sku">—</td>
              </tr>
              <tr>
                <td>Diameter</td>
                <td data-calder-spec="diameter">22"</td>
              </tr>
              <tr>
                <td>Center Finish</td>
                <td data-calder-spec="center">Gloss Black</td>
              </tr>
              <tr>
                <td>Barrel &amp; Lip Finish</td>
                <td data-calder-spec="barrel">Gloss Black Lip</td>
              </tr>
              <tr>
                <td>Hardware &amp; Rivet Finish</td>
                <td data-calder-spec="hardware">Chrome Bolts</td>
              </tr>
              {%- else -%}
              {% if diameters != blank %}
              <tr>
                <td>Diameter</td>
                <td>{{ diameters }}</td>
              </tr>
              {% else %}
              <tr>
                <td>Diameter</td>
                <td>{{ section.settings.spec_diameter | default: '18" — 22"' }}</td>
              </tr>
              {% endif %}
              {%- endif -%}

              <tr>
                <td>Width</td>
                <td>{{ section.settings.spec_width | default: '8.5" — 11"' }}</td>
              </tr>

              {% if bolt_pattern != blank %}
              <tr>
                <td>Bolt Pattern</td>
                <td>{{ bolt_pattern }}</td>
              </tr>
              {% else %}
              <tr>
                <td>Bolt Pattern</td>
                <td>{{ section.settings.spec_bolt | default: '5x112' }}</td>
              </tr>
              {% endif %}

              {% if center_bore != blank %}
              <tr>
                <td>Center Bore</td>
                <td>{{ center_bore }}mm</td>
              </tr>
              {% endif %}

              <tr>
                <td>Offset</td>
                <td>{{ section.settings.spec_offset | default: '+22 to +45' }}</td>
              </tr>

              {% if construction != blank %}
              <tr>
                <td>Construction</td>
                <td>{{ construction }}</td>
              </tr>
              {% else %}
              <tr>
                <td>Construction</td>
                <td>{{ section.settings.spec_construction | default: '3-Piece Forged' }}</td>
              </tr>
              {% endif %}

              <tr>
                <td>Weight</td>
                <td>{{ section.settings.spec_weight | default: '24.5 lbs' }}</td>
              </tr>

              {% if load_rating != blank %}
              <tr>
                <td>Load Rating</td>
                <td>{{ load_rating }} lbs</td>
              </tr>
              {% else %}
              <tr>
                <td>Load Rating</td>
                <td>{{ section.settings.spec_load | default: '1,600 lbs' }}</td>
              </tr>
              {% endif %}

              {% if series != blank %}
              <tr>
                <td>Series</td>
                <td>{{ series }}</td>
              </tr>
              {% endif %}

              {% if center_finishes != blank %}
              <tr>
                <td>Center Finishes</td>
                <td>{{ center_finishes }}</td>
              </tr>
              <tr>
                <td>Barrel Finishes</td>
                <td>{{ barrel_finishes }}</td>
              </tr>
              <tr>
                <td>Hardware</td>
                <td>{{ hardware_finishes }}</td>
              </tr>
              {% else %}
              <tr>
                <td>Finish</td>
                <td>{{ section.settings.spec_finish | default: 'Multiple Options' }}</td>
              </tr>
              {% endif %}

            </tbody>
          </table>

      </div>


      {%- comment -%}
        ============================================================
        ENGINEERING PANEL
        Image is a full-panel visual layer.
        Overlay and content sit above the image.
        ============================================================
      {%- endcomment -%}

      <div class="calder-engineering">

        <div class="calder-engineering__panel">

          {%- if eng_image -%}
            <img
              class="calder-engineering__hero-img"
              src="{{ eng_image | image_url: width: 1400 }}"
              srcset="
                {{ eng_image | image_url: width: 700 }} 700w,
                {{ eng_image | image_url: width: 1000 }} 1000w,
                {{ eng_image | image_url: width: 1400 }} 1400w
              "
              sizes="(max-width: 749px) 100vw, 50vw"
              alt=""
              loading="lazy"
              width="{{ eng_image.width }}"
              height="{{ eng_image.height }}"
            >
          {%- else -%}

            <div
              class="calder-engineering__hero-img calder-engineering__hero-img--placeholder"
              aria-hidden="true"
            ></div>

          {%- endif -%}


          {%- comment -%}
            Gradient overlay.
            Keeps left-side copy readable and creates the dark lower
            band behind the engineering capability strip.
          {%- endcomment -%}

          <div
            class="calder-engineering__overlay"
            aria-hidden="true"
          ></div>


          <div class="calder-engineering__body">

            <div class="calder-engineering__intro">

              <h3 class="calder-engineering__title">
                {{ section.settings.engineering_heading | default: 'Engineered to Perform' }}
              </h3>

              <p class="calder-engineering__description">
                {{ eng_text | default: 'Every Calder wheel is precision-engineered from aerospace-grade materials, assembled to order by master craftsmen, and validated through rigorous testing before delivery.' }}
              </p>

            </div>


            {%- comment -%}
              ======================================================
              ENGINEERING CAPABILITIES
              ======================================================
            {%- endcomment -%}

            <div class="calder-engineering__capabilities">


              {%- comment -%} Forged Aluminum {%- endcomment -%}

              <div class="calder-engineering__cap">

                <div class="calder-engineering__cap-icon" aria-hidden="true">
                  <svg class="calder-engineering__icon" width="32" height="32" viewBox="0 0 512 512" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                    <path d="m434.8 137.65-149.36-68.1c-16.19-7.4-42.69-7.4-58.88 0L77.3 137.65c-17.6 8-17.6 21.09 0 29.09l148 67.5c16.89 7.7 44.69 7.7 61.58 0l148-67.5c17.52-8 17.52-21.1-.08-29.09M160 308.52l-82.7 37.11c-17.6 8-17.6 21.1 0 29.1l148 67.5c16.89 7.69 44.69 7.69 61.58 0l148-67.5c17.6-8 17.6-21.1 0-29.1l-79.94-38.47" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="32"/>
                    <path d="m160 204.48-82.8 37.16c-17.6 8-17.6 21.1 0 29.1l148 67.49c16.89 7.7 44.69 7.7 61.58 0l148-67.49c17.7-8 17.7-21.1.1-29.1L352 204.48" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="32"/>
                  </svg>
                </div>

                <div class="calder-engineering__cap-text">
                  <strong>Forged Aluminum</strong>
                  <span>Aerospace-grade 6061-T6</span>
                </div>

              </div>


              {%- comment -%} CNC Machined {%- endcomment -%}

              <div class="calder-engineering__cap">

                <div class="calder-engineering__cap-icon" aria-hidden="true">
                  <svg class="calder-engineering__icon" width="32" height="32" viewBox="0 0 512 512" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                    <path d="m456.7 242.27-26.08-4.2a8 8 0 0 1-6.6-6.82c-.5-3.2-1-6.41-1.7-9.51a8.08 8.08 0 0 1 3.9-8.62l23.09-12.82a8.05 8.05 0 0 0 3.9-9.92l-4-11a7.94 7.94 0 0 0-9.4-5l-25.89 5a8 8 0 0 1-8.59-4.11q-2.25-4.2-4.8-8.41a8.16 8.16 0 0 1 .7-9.52l17.29-19.94a8 8 0 0 0 .3-10.62l-7.49-9a7.88 7.88 0 0 0-10.5-1.51l-22.69 13.63a8 8 0 0 1-9.39-.9c-2.4-2.11-4.9-4.21-7.4-6.22a8 8 0 0 1-2.5-9.11l9.4-24.75A8 8 0 0 0 365 78.77l-10.2-5.91a8 8 0 0 0-10.39 2.21l-16.64 20.84a7.15 7.15 0 0 1-8.5 2.5s-5.6-2.3-9.8-3.71A8 8 0 0 1 304 87l.4-26.45a8.07 8.07 0 0 0-6.6-8.42l-11.59-2a8.07 8.07 0 0 0-9.1 5.61l-8.6 25.05a8 8 0 0 1-7.79 5.41h-9.8a8.07 8.07 0 0 1-7.79-5.41l-8.6-25.05a8.07 8.07 0 0 0-9.1-5.61l-11.59 2a8.07 8.07 0 0 0-6.6 8.42l.4 26.45a8 8 0 0 1-5.49 7.71c-2.3.9-7.3 2.81-9.7 3.71-2.8 1-6.1.2-8.8-2.91l-16.51-20.34A8 8 0 0 0 156.75 73l-10.2 5.91a7.94 7.94 0 0 0-3.3 10.09l9.4 24.75a8.06 8.06 0 0 1-2.5 9.11c-2.5 2-5 4.11-7.4 6.22a8 8 0 0 1-9.39.9L111 116.14a8 8 0 0 0-10.5 1.51l-7.49 9a8 8 0 0 0 .3 10.62l17.29 19.94a8 8 0 0 1 .7 9.52q-2.55 4-4.8 8.41a8.11 8.11 0 0 1-8.59 4.11l-25.89-5a8 8 0 0 0-9.4 5l-4 11a8.05 8.05 0 0 0 3.9 9.92L85.58 213a7.94 7.94 0 0 1 3.9 8.62c-.6 3.2-1.2 6.31-1.7 9.51a8.08 8.08 0 0 1-6.6 6.82l-26.08 4.2a8.09 8.09 0 0 0-7.1 7.92v11.72a7.86 7.86 0 0 0 7.1 7.92l26.08 4.2a8 8 0 0 1 6.6 6.82c.5 3.2 1 6.41 1.7 9.51a8.08 8.08 0 0 1-3.9 8.62L62.49 311.7a8.05 8.05 0 0 0-3.9 9.92l4 11a7.94 7.94 0 0 0 9.4 5l25.89-5a8 8 0 0 1 8.59 4.11q2.25 4.2 4.8 8.41a8.16 8.16 0 0 1-.7 9.52l-17.29 19.96a8 8 0 0 0-.3 10.62l7.49 9a7.88 7.88 0 0 0 10.5 1.51l22.69-13.63a8 8 0 0 1 9.39.9c2.4 2.11 4.9 4.21 7.4 6.22a8 8 0 0 1 2.5 9.11l-9.4 24.75a8 8 0 0 0 3.3 10.12l10.2 5.91a8 8 0 0 0 10.39-2.21l16.79-20.64c2.1-2.6 5.5-3.7 8.2-2.6 3.4 1.4 5.7 2.2 9.9 3.61a8 8 0 0 1 5.49 7.71l-.4 26.45a8.07 8.07 0 0 0 6.6 8.42l11.59 2a8.07 8.07 0 0 0 9.1-5.61l8.6-25a8 8 0 0 1 7.79-5.41h9.8a8.07 8.07 0 0 1 7.79 5.41l8.6 25a8.07 8.07 0 0 0 9.1 5.61l11.59-2a8.07 8.07 0 0 0 6.6-8.42l-.4-26.45a8 8 0 0 1 5.49-7.71c4.2-1.41 7-2.51 9.6-3.51s5.8-1 8.3 2.1l17 20.94A8 8 0 0 0 355 439l10.2-5.91a7.93 7.93 0 0 0 3.3-10.12l-9.4-24.75a8.08 8.08 0 0 1 2.5-9.12c2.5-2 5-4.1 7.4-6.21a8 8 0 0 1 9.39-.9L401 395.66a8 8 0 0 0 10.5-1.51l7.49-9a8 8 0 0 0-.3-10.62l-17.29-19.94a8 8 0 0 1-.7-9.52q2.55-4.05 4.8-8.41a8.11 8.11 0 0 1 8.59-4.11l25.89 5a8 8 0 0 0 9.4-5l4-11a8.05 8.05 0 0 0-3.9-9.92l-23.09-12.82a7.94 7.94 0 0 1-3.9-8.62c.6-3.2 1.2-6.31 1.7-9.51a8.08 8.08 0 0 1 6.6-6.82l26.08-4.2a8.09 8.09 0 0 0 7.1-7.92V250a8.25 8.25 0 0 0-7.27-7.73M256 112a143.82 143.82 0 0 1 139.38 108.12A16 16 0 0 1 379.85 240H274.61a16 16 0 0 1-13.91-8.09l-52.1-91.71a16 16 0 0 1 9.85-23.39A147 147 0 0 1 256 112M112 256a144 144 0 0 1 43.65-103.41 16 16 0 0 1 25.17 3.47L233.06 248a16 16 0 0 1 0 15.87l-52.67 91.7a16 16 0 0 1-25.18 3.36A143.94 143.94 0 0 1 112 256m144 144a147 147 0 0 1-38.19-4.95 16 16 0 0 1-9.76-23.44l52.58-91.55a16 16 0 0 1 13.88-8H379.9a16 16 0 0 1 15.52 19.88A143.84 143.84 0 0 1 256 400" fill="currentColor"/>
                  </svg>
                </div>

                <div class="calder-engineering__cap-text">
                  <strong>CNC Machined</strong>
                  <span>Precision to ±0.005mm</span>
                </div>

              </div>


              {%- comment -%} Strength Tested {%- endcomment -%}

              <div class="calder-engineering__cap">

                <div class="calder-engineering__cap-icon" aria-hidden="true">
                  <svg class="calder-engineering__icon" width="32" height="32" viewBox="0 0 512 512" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                    <path d="M336 176 225.2 304 176 255.8" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="32"/>
