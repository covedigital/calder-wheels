{{ 'calder-product-fitment-guide.css' | asset_url | stylesheet_tag }}
{% render 'calder-fitment-guide-data' %}
{% render 'fitment-catalog' %}

{%- liquid
  assign store_width = settings.container_max_width
  if section.settings.section_width == 'custom'
    assign store_width = section.settings.container_max_width
  endif
  assign heading = section.settings.heading | default: 'Fitment Guide'
  assign eyebrow = section.settings.eyebrow | default: 'Vehicle Compatibility'
  assign subheading = section.settings.subheading | default: 'Select your vehicle to see compatible wheels'
  assign description = section.settings.description | default: 'Use our fitment guide to see compatible sizes, bolt patterns, and offsets for your make and model.'
  assign button_text = section.settings.button_text | default: 'SEE FITMENT'
  assign assistance_heading = section.settings.assistance_heading | default: 'Not sure if it fits?'
  assign assistance_text = section.settings.assistance_text | default: 'Our wheel specialists can help verify fitment for your vehicle and answer any questions.'
  assign contact_label = section.settings.contact_label | default: 'SPEAK WITH A WHEEL SPECIALIST'
  assign faq_label = section.settings.faq_label | default: 'MORE QUESTIONS?'
  assign disclaimer_text = section.settings.disclaimer_text | default: 'Fitment specifications are provided for reference. Final compatibility must be verified before ordering. Brake clearance, vehicle modifications, tire selection, and load requirements may affect fitment.'
  assign contact_method = section.settings.contact_method | default: 'contact'
  assign contact_url = section.settings.contact_url
  assign phone = section.settings.phone
  assign email = section.settings.email
  assign show_specs = section.settings.show_specs
  assign show_configs = section.settings.show_configs
  assign show_details = section.settings.show_details
  assign show_assistance = section.settings.show_assistance
  assign show_faq = section.settings.show_faq
  assign auto_vehicle = section.settings.auto_vehicle
  assign show_disclaimer = section.settings.show_disclaimer
  assign bg_color = section.settings.bg_color
  assign bg_image = section.settings.background_image
  assign card_radius = section.settings.card_radius | default: 16
  assign accent_color = section.settings.accent_color
  assign default_image = section.settings.default_image
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --container-max-width: {{ store_width }}px;
  }
  .cw-fitment-guide--{{ section.id }} {
    {% if bg_color != blank and bg_color != 'rgba(0,0,0,0)' %}
      --cw-guide-bg: {{ bg_color }};
      background-color: {{ bg_color }};
    {% endif %}
    {% if bg_image != blank %}
      --cw-guide-bg-image: url({{ bg_image | img_url: '1920x' }});
      background-image: var(--cw-guide-bg-image);
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    {% endif %}
    {% if accent_color != blank and accent_color != 'rgba(0,0,0,0)' %}
      --cw-guide-accent: {{ accent_color }};
    {% endif %}
    --cw-guide-radius: {{ card_radius }}px;
  }
  .cw-fitment-guide--{{ section.id }} .cw-fitment-guide__card {
    border-radius: var(--cw-guide-radius, 16px);
  }
{%- endstyle -%}

<div
  class="cw-fitment-guide cw-fitment-guide--{{ section.id }} section"
  id="calder-fitment-guide-{{ section.id }}"
  data-section-id="{{ section.id }}"
  {% unless section.settings.enable_section %}hidden{% endunless %}
>
  <div class="cw-fitment-guide__inner container">
    <div class="cw-fitment-guide__header">
      <div class="cw-fitment-guide__header-left">
        {% if eyebrow != blank %}<p class="cw-fitment-guide__eyebrow">{{ eyebrow }}</p>{% endif %}
        <h2 class="cw-fitment-guide__title">{{ heading }}</h2>
        <p class="cw-fitment-guide__subtitle">{{ subheading }}</p>
      </div>
      <div class="cw-fitment-guide__header-right">
        <p class="cw-fitment-guide__description">{{ description }}</p>
      </div>
    </div>

    <div class="cw-fitment-guide__card">
      <div class="cw-fitment-guide__controls">
        <div class="cw-fitment-guide__field cw-fitment-guide__field--year">
          <label class="cw-fitment-guide__label" for="cw-guide-year-{{ section.id }}">Select Year</label>
          <div class="cw-fitment-guide__select-wrapper">
            <select
              id="cw-guide-year-{{ section.id }}"
              class="cw-fitment-guide__select"
              data-guide-year
              data-placeholder="{{ section.settings.placeholder_year | default: 'Select Year' }}"
              disabled
            >
              <option value="">{{ section.settings.placeholder_year | default: 'Select Year' }}</option>
            </select>
          </div>
        </div>
        <div class="cw-fitment-guide__field cw-fitment-guide__field--make">
          <label class="cw-fitment-guide__label" for="cw-guide-make-{{ section.id }}">Select Make</label>
          <div class="cw-fitment-guide__select-wrapper">
            <select
              id="cw-guide-make-{{ section.id }}"
              class="cw-fitment-guide__select"
              data-guide-make
              data-placeholder="{{ section.settings.placeholder_make | default: 'Select Make' }}"
              disabled
            >
              <option value="">{{ section.settings.placeholder_make | default: 'Select Make' }}</option>
            </select>
          </div>
        </div>
        <div class="cw-fitment-guide__field cw-fitment-guide__field--model">
          <label class="cw-fitment-guide__label" for="cw-guide-model-{{ section.id }}">Select Model</label>
          <div class="cw-fitment-guide__select-wrapper">
            <select
              id="cw-guide-model-{{ section.id }}"
              class="cw-fitment-guide__select"
              data-guide-model
              data-placeholder="{{ section.settings.placeholder_model | default: 'Select Model' }}"
              disabled
            >
              <option value="">{{ section.settings.placeholder_model | default: 'Select Model' }}</option>
            </select>
          </div>
        </div>
        <button
          type="button"
          class="cw-fitment-guide__submit"
          data-guide-submit
          disabled
        >
          {{ button_text }}
        </button>
      </div>

      <div class="cw-fitment-guide__divider"></div>

      <div class="cw-fitment-guide__results" data-guide-results style="display:none;">
        {% if default_image != blank %}
          <div class="cw-fitment-guide__image-container">
            <img
              src="{{ default_image | image_url: width: 400 }}"
              alt=""
              class="cw-fitment-guide__image"
              width="{{ default_image.width }}"
              height="{{ default_image.height }}"
              loading="lazy"
            >
          </div>
        {% endif %}
      </div>

      {% if show_assistance %}
      <div class="cw-fitment-guide__assistance">
        <div class="cw-fitment-guide__assistance-icon">
          <svg viewBox="0 0 44 44" fill="none" aria-hidden="true">
            <circle cx="22" cy="22" r="22" fill="#1E4C68"/>
            <circle cx="22" cy="22" r="14" fill="white"/>
            <path d="M22 18v10M22 14v.01" stroke="#1E4C68" stroke-width="2.5" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="cw-fitment-guide__assistance-content">
          <h4 class="cw-fitment-guide__assistance-heading">{{ assistance_heading }}</h4>
          <p class="cw-fitment-guide__assistance-text">{{ assistance_text }}</p>
        </div>
        <div class="cw-fitment-guide__assistance-actions">
          <button
            type="button"
            class="cw-fitment-guide__assistance-btn cw-fitment-guide__assistance-btn--primary"
            data-guide-assistance
            data-guide-contact-url="{% if contact_method == 'url' and contact_url != blank %}{{ contact_url }}{% elsif contact_method == 'phone' and phone != blank %}tel:{{ phone }}{% elsif contact_method == 'email' and email != blank %}mailto:{{ email }}{% else %}{{ routes.root_url }}pages/contact{% endif %}"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            {{ contact_label }}
          </button>
          {% if show_faq and section.blocks.size > 0 %}
          <button
            type="button"
            class="cw-fitment-guide__assistance-btn cw-fitment-guide__assistance-btn--secondary"
            data-guide-faq-toggle
          >
            {{ faq_label }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          {% endif %}
        </div>
      </div>
      {% endif %}

      {% if show_faq and section.blocks.size > 0 %}
      <div class="cw-fitment-guide__faq-panel" data-guide-faq-panel>
        {% for block in section.blocks %}
          {% if block.type == 'faq' %}
            <div class="cw-fitment-guide__faq-item">
              <button type="button" class="cw-fitment-guide__faq-question" data-guide-faq-question>
                {{ block.settings.question }}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <div class="cw-fitment-guide__faq-answer" hidden>
                {{ block.settings.answer }}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
      {% endif %}

      {% if show_disclaimer %}
      <div class="cw-fitment-guide__disclaimer">
        {{ disclaimer_text }}
      </div>
      {% endif %}
    </div>
  </div>
</div>

<script src="{{ 'calder-product-fitment-guide.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Calder Fitment Guide",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Enable / Disable"
    },
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable Fitment Guide section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_specs",
      "label": "Show vehicle specifications",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_configs",
      "label": "Show alternative wheel sizes",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_details",
      "label": "Show technical explanations",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_assistance",
      "label": "Enable Speak With a Rep CTA",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_faq",
      "label": "Enable More Questions FAQ",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "auto_vehicle",
      "label": "Automatically use selected vehicle",
      "default": true,
      "info": "Pre-fills the guide with the shopper's previously selected vehicle."
    },
    {
      "type": "checkbox",
      "id": "show_disclaimer",
      "label": "Show fitment verification disclaimer",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fitment Guide"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Vehicle Compatibility"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Select your vehicle to see compatible wheels"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Use our fitment guide to see compatible sizes, bolt patterns, and offsets for your make and model."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "See Fitment button label",
      "default": "SEE FITMENT"
    },
    {
      "type": "header",
      "content": "Placeholders"
    },
    {
      "type": "text",
      "id": "placeholder_year",
      "label": "Year placeholder",
      "default": "Select Year"
    },
    {
      "type": "text",
      "id": "placeholder_make",
      "label": "Make placeholder",
      "default": "Select Make"
    },
    {
      "type": "text",
      "id": "placeholder_model",
      "label": "Model placeholder",
      "default": "Select Model"
    },
    {
      "type": "header",
      "content": "Assistance Banner"
    },
    {
      "type": "text",
      "id": "assistance_heading",
      "label": "Assistance heading",
      "default": "Not sure if it fits?"
    },
    {
      "type": "textarea",
      "id": "assistance_text",
      "label": "Assistance description",
      "default": "Our wheel specialists can help verify fitment for your vehicle and answer any questions."
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Contact CTA label",
      "default": "SPEAK WITH A WHEEL SPECIALIST"
    },
    {
      "type": "text",
      "id": "faq_label",
      "label": "FAQ CTA label",
      "default": "MORE QUESTIONS?"
    },
    {
      "type": "select",
      "id": "contact_method",
      "label": "Contact method",
      "options": [
        { "value": "contact", "label": "Contact page" },
        { "value": "phone", "label": "Phone" },
        { "value": "email", "label": "Email" },
        { "value": "url", "label": "Custom URL" }
      ],
      "default": "contact"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact URL"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address"
    },
    {
      "type": "header",
      "content": "Disclaimer"
    },
    {
      "type": "textarea",
      "id": "disclaimer_text",
      "label": "Disclaimer text",
      "default": "Fitment specifications are provided for reference. Final compatibility must be verified before ordering. Brake clearance, vehicle modifications, tire selection, and load requirements may affect fitment."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F7F8FA"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "global", "label": "Global" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "global"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 400,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "label": "Container max width",
      "default": 1180
    },
    {
      "type": "header",
      "content": "Vehicle Images"
    },
    {
      "type": "image_picker",
      "id": "default_image",
      "label": "Default vehicle image"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How do I know if this wheel fits my vehicle?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Use our Fitment Guide to select your vehicle. We provide reference specifications for bolt pattern, offset, center bore, and tire sizes. Always verify final compatibility before ordering."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Calder Product Fitment Guide",
      "category": "Calder",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "What is wheel fitment?",
            "answer": "Wheel fitment refers to how a wheel attaches to your vehicle. Key measurements include bolt pattern (PCD), offset, center bore, diameter, and width."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What is bolt pattern (PCD)?",
            "answer": "PCD (Pitch Circle Diameter) is the diameter of the circle formed by the centers of the wheel lug holes. It is expressed as the number of lugs x the diameter (e.g. 5x112)."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What is wheel offset?",
            "answer": "Offset is the distance between the wheel's mounting surface and its centerline. Positive offset moves the wheel inward; negative offset pushes it outward."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What is center bore?",
            "answer": "Center bore is the diameter of the hole in the center of the wheel that fits over the vehicle's hub. A properly sized center bore ensures the wheel is centered correctly."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Do I need different front and rear wheels?",
            "answer": "Some vehicles use a staggered fitment where front and rear wheels have different widths or offsets. Our guide shows staggered configurations where applicable."
          }
        }
      ]
    }
  ]
}
{% endschema %}