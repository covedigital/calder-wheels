{% comment %}
  CALDER PRODUCT — Main PDP Hero
  -------------------------------------------------------------
  Purpose:
  - Calder visual presentation
  - Calder-owned product media gallery
  - Lumia-native variant picker
  - Lumia-native price rendering
  - Lumia-native buy buttons / AJAX cart
  - Native wishlist integration
  - Calder fitment integration
  - Dealer context preserved
  Approved layout:
  LEFT
    Large media
    Horizontal thumbnails
  RIGHT
    Product code/title
    Construction
    Tagline
    Description
    Rating / SKU / Made to Order
    Fitment status
    Variant configuration
    Price / quantity / add to cart
    Save / Share
    Trust row
{% endcomment %}

{% comment %}theme-check-disable NestedSnippet, ImgLazyLoading, UnusedAssign{% endcomment %}
{{ 'main-product.css' | asset_url | stylesheet_tag }}
{{ 'calder-product.css' | asset_url | stylesheet_tag }}
{{ 'calder-pdp-fitment-form.css' | asset_url | stylesheet_tag }}
{% render 'calder-configuration-catalog', wheel_collection: collections['all-calder-wheels'] %}
{%- liquid
  assign uc_design_code = product.metafields.custom.design_code.value | default: product.metafields.custom.design_code | default: '' | strip | upcase
  assign uc_design_key = uc_design_code | remove: '-'
  assign is_universal_design = false
  if uc_design_key == 'CLM01' or uc_design_key == 'CLM02' or uc_design_key == 'CLM03' or uc_design_key == 'CLM05' or uc_design_key == 'CLB06' or uc_design_key == 'CLB07'
    assign is_universal_design = true
  endif

  render 'dealer-context'
  assign layout = 'product'
  assign section_id = section.id
  assign product_form_id = 'product-form-' | append: section_id | append: '-' | append: product.id
  assign current_variant = product.selected_or_first_available_variant | default: product.variants.first
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign design_code = product.metafields.custom.design_code.value
  assign design_nickname = product.metafields.custom.design_nickname.value
  assign series = product.metafields.custom.series.value
  assign construction_type = product.metafields.custom.construction_type.value | default: product.type
  assign finish_options = product.metafields.custom.finish_options.value
  assign diameters = product.metafields.custom.diameters.value
  assign widths = product.metafields.custom.widths.value
  assign applications = product.metafields.custom.applications.value
  assign hardware_rivet_options = product.metafields.custom.hardware_rivet_finish_options.value
  if hardware_rivet_options == blank
    assign hardware_rivet_options = product.metafields.custom.hardware_rivet_finish_options
  endif

  assign calder_preset_bom = product.metafields.custom.bom.value
  assign calder_preset_components = calder_preset_bom.components | default: calder_preset_bom

  comment
    Barrel & Lip preset — authoritative resolution order:
    1. A native product option whose verified NAME is the barrel dimension
       and which carries exactly ONE value (single-value third option =
       the fixed product preset, e.g. "Chrome"). This is the live-store
       authoritative source.
    2. BOM barrel component client_code (polished -> Chrome, gloss/black -> Black).
    3. Canonical handle tokens (polished-lip -> Chrome, other *-lip -> Black).
  endcomment
  assign preset_barrel_catalog = ''
  assign calder_barrel_index = -1
  assign calder_barrel_single = false
  assign calder_opt_i = 0
  for calder_opt in product.options_with_values
    assign calder_opt_name_l = calder_opt.name | downcase
    if calder_opt_name_l contains 'barrel'
      assign calder_barrel_index = calder_opt_i
      if calder_opt.values.size == 1
        assign calder_barrel_single = true
      endif
      break
    endif
    assign calder_opt_i = calder_opt_i | plus: 1
  endfor
  if calder_barrel_single and calder_barrel_index >= 0
    assign preset_barrel_catalog = current_variant.options[calder_barrel_index] | strip
  endif
  if preset_barrel_catalog contains 'polish' or preset_barrel_catalog contains 'hrome'
    assign preset_barrel_catalog = 'Chrome'
  elsif preset_barrel_catalog contains 'lack' or preset_barrel_catalog contains 'loss'
    assign preset_barrel_catalog = 'Black'
  else
    assign preset_barrel_catalog = ''
  endif
  if preset_barrel_catalog == blank
    for comp in calder_preset_components
      if comp.type == 'barrel' and comp.client_code != blank
        assign barrel_code = comp.client_code | downcase
        if barrel_code contains 'polish'
          assign preset_barrel_catalog = 'Chrome'
        elsif barrel_code contains 'black' or barrel_code contains 'gloss'
          assign preset_barrel_catalog = 'Black'
        endif
        break
      endif
    endfor
  endif
  if preset_barrel_catalog == blank
    assign calder_handle_l = product.handle | downcase
    if calder_handle_l contains 'polished-lip'
      assign preset_barrel_catalog = 'Chrome'
    elsif calder_handle_l contains '-lip-'
      assign preset_barrel_catalog = 'Black'
    endif
  endif

  assign preset_hardware_catalog = hardware_rivet_options | split: ',' | first | strip
  if preset_hardware_catalog contains 'hrome'
    assign preset_hardware_catalog = 'Chrome'
  elsif preset_hardware_catalog contains 'lack'
    assign preset_hardware_catalog = 'Black'
  else
    assign preset_hardware_catalog = ''
    for comp in calder_preset_components
      if comp.type == 'hardware' and comp.client_code != blank
        if comp.client_code contains 'chrome'
          assign preset_hardware_catalog = 'Chrome'
        else
          assign preset_hardware_catalog = 'Black'
        endif
        break
      endif
    endfor
  endif
  if preset_hardware_catalog == blank
    assign calder_handle_l = product.handle | downcase
    if calder_handle_l contains 'chrome-bolts'
      assign preset_hardware_catalog = 'Chrome'
    elsif calder_handle_l contains 'black-bolts'
      assign preset_hardware_catalog = 'Black'
    endif
  endif
  assign short_description = product.metafields.custom.short_description.value
  assign tagline = product.metafields.custom.tagline.value
  assign store_width = settings.container_max_width
  if section.settings.section_width == 'custom'
    assign store_width = section.settings.container_max_width
  endif
  if template.suffix contains 'store-width-'
    assign store_width = template.suffix | split: 'store-width-' | last | plus: 0
  endif
  assign aspect_ratio = settings.product_image_aspect_ratio
  if aspect_ratio == 'custom'
    assign aspect_ratio = settings.product_height_ratio | times: 100 | divided_by: settings.product_width_ratio
  endif
  assign thumbs = section.settings.thumbs
  assign media_layout_grid = false
  assign hide_variants = false
  assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src'
  assign media_count = product.media.size
  assign initialSlide = 0
  if current_variant.featured_media
    assign selected_variant_image_id = current_variant.featured_media.id
    for media in product.media
      if selected_variant_image_id == media.id
        assign initialSlide = forloop.index0
      endif
    endfor
  endif
  assign model_variants_schema = product.metafields.custom.model_variants_schema
  if product.metafields.custom.model_with_variants.value == true and model_variants_schema.value != blank
    assign model_variant_name_array = model_variants_schema | split: product.selected_variant.id
    if model_variant_name_array.size > 1
      assign model_variant_name = model_variants_schema | split: product.selected_variant.id | last | split: "]" | first | strip | replace: ',', '' | replace: '"', ''
      assign media_model_viewer_first = product.media | where: 'media_type', 'model' | first
      assign media_model_viewer_first_id = media_model_viewer_first.id
      for media in product.media
        if media_model_viewer_first_id == media.id
          assign initialSlide = forloop.index0
        endif
      endfor
    endif
  endif
  assign options_with_values = product.options_with_values
  assign color_options_name = settings.product_card_color_options_name | split: ","
  assign has_color_option = false
  for option in options_with_values
    assign has_color_option = false
    if color_options_name contains option.name
      assign has_color_option = true
      assign color_option_order = forloop.index0
      break
    endif
  endfor
  if has_color_option == true
    assign colorGroups = ''
    if product.images.size > 0
      for image in product.images
        unless image.alt contains 'color-'
          continue
        endunless
        assign imageAlt = image.alt | escape | replace: 'color-', '' | handle
        assign colorGroups = colorGroups | append: imageAlt
        unless forloop.last
          assign colorGroups = colorGroups | append: ','
        endunless
      endfor
      assign colorGroupsArray = colorGroups | split: ',' | uniq
      assign colorGroups = colorGroupsArray | join: ','
    endif
    assign optionHandle = current_variant.options[color_option_order] | handle
    for color in colorGroupsArray
      if color == optionHandle
        assign colorSelected = optionHandle
        break
      endif
    endfor
  endif
  assign is_configurable = product.metafields.custom.is_configurable.value | default: false
  unless is_configurable
    for tag in product.tags
      if tag == 'configurable'
        assign is_configurable = true
        break
      endif
    endfor
  endunless
  assign rating_value = product.metafields.reviews.rating.value.rating
  assign rating_scale_max = product.metafields.reviews.rating.value.scale_max
  assign rating_count = product.metafields.reviews.rating_count.value
  assign has_native_options = false
  unless product.has_only_default_variant
    assign has_native_options = true
  endunless
-%}
{%- style -%}
  #shopify-section-{{ section.id }} {
    --container-max-width: {{ store_width }}px;
  }
{%- endstyle -%}
<div
  id="CalderProduct-{{ section.id }}"
  class="calder-pdp"
  data-section-render
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
  data-product-url="{{ product.url }}"
  data-preset-barrel="{{ preset_barrel_catalog | escape }}"
  data-preset-hardware="{{ preset_hardware_catalog | escape }}"
>
  {%- if section.settings.show_breadcrumbs -%}
    <nav
      class="breadcrumbs container calder-pdp__breadcrumbs"
      aria-label="Breadcrumb"
    >
      <a href="{{ routes.root_url }}">
        Home
      </a>
      <span aria-hidden="true">/</span>
      {%- if collection -%}
        <a href="{{ collection.url }}">
          {{ collection.title }}
        </a>
        <span aria-hidden="true">/</span>
      {%- endif -%}
      <span aria-current="page">
        {{ product.title | escape }}
      </span>
    </nav>
  {%- endif -%}
  <div class="calder-pdp__hero container">

    {% comment %}
  ==========================================================
  LEFT — NATIVE LUMIA PRODUCT GALLERY
  IMPORTANT:
  Preserve Lumia's native product-gallery structure.
  Calder classes are additive styling hooks only.
  ==========================================================
{% endcomment %}

    <div class="calder-pdp__gallery aside--sticky js-sticky-collision">
      <div class="aside-content">
      {%- if is_universal_design -%}
        {% render 'calder-universal-gallery', product: product, section: section %}
      {%- elsif product.media.size > 0 -%}
        <div class="calder-pdp__main-image">
          <product-gallery class="d-flex w-100 prd-block-gallery-container-hor" data-initial-slide="{{ initialSlide }}" data-aspect="{{ aspect_ratio }}" style="--aspect-ratio: {{ aspect_ratio }}">
            {%- liquid
              if thumbs and media_count != 1
                assign sizes ='(min-width: 1200px) 77px, (min-width: 992px) 55px, (min-width: 768px) 119px, (min-width: 576px) 83px, calc((100vw - 30px - 45px)/4)'
                render 'product-media-thumbs', sizes: sizes, product: product, section: section, product_media_main_fill_color: section.settings.product_media_main_fill_color, media_count: media_count, variant_images: variant_images, hide_variants: hide_variants, thumbs_position: section.settings.thumbs_position, grid: false
              endif
              assign sizes ='(min-width: 1200px) 559px, (min-width: 992px) 450px, (min-width: 768px) 690px, (min-width: 576px) 510px, (min-width: 360px) 330px, calc(100vw - 30px)'
            -%}
            {% render 'product-media-main',
              product: product,
              sizes: sizes,
              product_form_id: product_form_id,
              loop: section.settings.enable_video_looping,
              product_media_main_fill_color: section.settings.product_media_main_fill_color,
              media_count: media_count,
              model_variant_name: model_variant_name,
              grid: false,
              suffix: section_id,
              thumbs_position: section.settings.thumbs_position,
              pjpg: section.settings.pjpg,
              hide_variants: hide_variants,
              variant_images: variant_images,
              colorSelected: colorSelected
            %}
          </product-gallery>
        </div>
        {%- if thumbs and product.media.size > 1 -%}
          <div class="calder-pdp__thumbs-wrap">
          {%- liquid
            assign sizes ='(min-width: 1200px) 77px, (min-width: 992px) 55px, (min-width: 768px) 119px, (min-width: 576px) 83px, calc((100vw - 30px - 45px)/4)'
          -%}
          {% render 'product-media-thumbs',
            sizes: sizes,
            product: product,
            section: section,
            product_media_main_fill_color: section.settings.product_media_main_fill_color,
            media_count: media_count,
            variant_images: variant_images,
            hide_variants: hide_variants,
            thumbs_position: section.settings.thumbs_position,
            grid: false
          %}
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="calder-pdp__gallery-empty">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}
      </div><!-- /.aside-content -->
    </div>

    {% comment %}
      ==========================================================
      RIGHT — PRODUCT INFORMATION
      ==========================================================
    {% endcomment %}

    <div class="calder-pdp__info">

      {% comment %}
        ----------------------------------------------------------
        Product heading
        ----------------------------------------------------------
      {% endcomment %}

      <div class="calder-pdp__heading">
        <div class="calder-pdp__heading-main">
          <div class="calder-pdp__eyebrow">2-PIECE SPUN FORGED</div>
          {%- if design_code != blank -%}
            <div class="calder-pdp__design-code">
              {{ design_code }}
            </div>
          {%- endif -%}
          <h1 class="calder-pdp__title">
            {% unless design_code != blank and product.title contains design_code %}
              {{ product.title | escape }}
            {% endunless %}
          </h1>
          {%- if construction_type != blank -%}
            <div class="calder-pdp__construction">
              {{ construction_type }}
            </div>
          {%- elsif series != blank -%}
            <div class="calder-pdp__construction">
              {{ series }}
            </div>
          {%- endif -%}
        </div>
        {%- if section.settings.show_made_to_order -%}
          <span class="calder-pdp__badge">
            {{ section.settings.made_to_order_text }}
          </span>
        {%- endif -%}
      </div>

      {% comment %}
        ----------------------------------------------------------
        Tagline
        ----------------------------------------------------------
      {% endcomment %}

      {%- if tagline != blank -%}
        <div class="calder-pdp__tagline">
          {{ tagline }}
        </div>
      {%- elsif design_nickname != blank and design_nickname.size > 0 and design_nickname != design_code -%}
        <div class="calder-pdp__tagline">
          {{ design_nickname }}
        </div>
      {%- endif -%}

      {% comment %}
        ----------------------------------------------------------
        Description
        ----------------------------------------------------------
      {% endcomment %}

      {%- if short_description != blank -%}
        <div class="calder-pdp__description rte">
          {{ short_description }}
        </div>
      {%- elsif product.description != blank -%}
        <div class="calder-pdp__description">
          {{ product.description | strip_html | truncatewords: section.settings.description_words }}
        </div>
      {%- endif -%}

      {% comment %}
        ----------------------------------------------------------
        Rating / SKU
        ----------------------------------------------------------
      {% endcomment %}

      <div class="calder-pdp__meta">
        {%- if section.settings.show_rating -%}
          <div class="calder-pdp__rating">
            <div class="calder-pdp__rating-stars">
              {% render 'rating',
                product: product,
                type: 'product'
              %}
            </div>
            {%- if rating_value != blank -%}
              <strong class="calder-pdp__rating-value">
                {{ rating_value }}
              </strong>
            {%- endif -%}
            {%- if rating_count != blank -%}
              <span class="calder-pdp__rating-count">
                ({{ rating_count }} reviews)
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if current_variant.sku != blank -%}
          {%- comment -%}
            Universal designs: calder-universal-pdp.js rewrites this block on
            every calder-uc selection with the resolved CFG SKU + Universal
            Part#. Initial paint mirrors the JS structure; the Part# reads
            "—" until the registry resolves (progressive enhancement).
          {%- endcomment -%}
          <div
            class="calder-pdp__sku"
            data-render="sku-{{ product_form_id }}"
          >
            <span class="sku"><span>SKU:</span> {{ current_variant.sku }}</span>
            {%- if is_universal_design -%}
              <br />
              <span class="universal-part"><span>Universal Part#:</span> —</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {% comment %}
        ==========================================================
        FITMENT STATUS
        ==========================================================
      {% endcomment %}

      {%- if section.settings.show_developer_output -%}
        {% render 'calder-developer-output', product: product %}
      {%- endif -%}
      <div
        class="calder-pdp__fitment calder-pdp__fitment--unset"
        data-calder-fitment
      >
        <div class="calder-pdp__fitment-status">
          <span class="calder-pdp__fitment-icon">
            <svg
              class="calder-pdp__fitment-icon-check"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <circle
                cx="12"
                cy="12"
                r="10"
                fill="currentColor"
              />
              <path
                d="M7.5 12.25L10.5 15.25L16.75 8.75"
                stroke="white"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <svg
              class="calder-pdp__fitment-icon-warn"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              hidden
            >
              <path
                d="M12 3.5L21.5 19.5H2.5L12 3.5Z"
                fill="currentColor"
              />
              <path
                d="M12 9.75V14"
                stroke="white"
                stroke-width="2"
                stroke-linecap="round"
              />
              <circle
                cx="12"
                cy="16.9"
                r="1.1"
                fill="white"
              />
            </svg>
          </span>
          <div class="calder-pdp__fitment-copy">
            <strong
              class="calder-pdp__fitment-label"
              data-calder-fitment-label
            >
              {{ section.settings.fitment_unset_heading }}
            </strong>
            <div class="calder-pdp__fitment-text">
              <span data-calder-fitment-text>
                {{ section.settings.text_no_vehicle }}
              </span>
              <span
                class="calder-pdp__fitment-vehicle"
                data-calder-fitment-vehicle
                hidden
              ></span>
            </div>
          </div>
        </div>
        <div class="calder-pdp__fitment-actions-row">
          <button
            class="calder-pdp__fitment-action"
            data-calder-fitment-action
            type="button"
            aria-expanded="false"
            aria-controls="calder-fitment-mini-form-{{ section.id }}"
          >
            <span data-calder-fitment-action-text>
              {{ section.settings.action_text }}
            </span>
          </button>
          <button
            class="calder-pdp__fitment-reset"
            data-calder-fitment-reset
            type="button"
            hidden
          >
            Reset
          </button>
        </div>
        <div
          class="calder-pdp__fitment-form"
          id="calder-fitment-mini-form-{{ section.id }}"
          data-calder-fitment-form
          hidden
        >
          <div class="calder-pdp__fitment-form-row">
            <select class="calder-pdp__fitment-select" data-calder-ffv-year aria-label="Select Year">
              <option value="">Select Year</option>
            </select>
            <select class="calder-pdp__fitment-select" data-calder-ffv-make aria-label="Select Make" disabled>
              <option value="">Select Make</option>
            </select>
            <select class="calder-pdp__fitment-select" data-calder-ffv-model aria-label="Select Model" disabled>
              <option value="">Select Model</option>
            </select>
          </div>
          <button type="button" class="calder-pdp__fitment-form-apply" data-calder-ffv-apply disabled>
            Apply Vehicle
          </button>
        </div>
      </div>

      {% comment %}
        ==========================================================
        PRODUCT CONFIGURATION
        ==========================================================
      {% endcomment %}

      <div class="calder-pdp__config-stack calder-pdp__config">

        {% comment %}
          Native Shopify/Lumia variants are the authoritative
          commerce selector whenever variants exist.
        {% endcomment %}

        {%- if is_universal_design -%}
          {% render 'calder-universal-controls',
            product: product,
            product_form_id: product_form_id
          %}
        {%- elsif has_native_options -%}
          <div class="calder-pdp__native-variants">
            {% render 'variant_picker',
              product: product,
              picker_type: 'button',
              section: section,
              section_id: section_id,
              layout: layout,
              product_form_id: product_form_id,
              use_pics: section.settings.use_variant_images,
              use_variants_media: section.settings.use_variant_images,
              color_options_name: settings.product_card_color_options_name,
              swatches_width: settings.product_swatches_page_color_min_width,
              calder_pdp_labels: true
            %}
          </div>
          {%- comment -%}Calder visual controls for has_native_options path{%- endcomment -%}
          {%- liquid
            assign bom = product.metafields.custom.bom.value
            assign bom_comps = bom.components | default: bom
            assign hardware_bom = bom_comps | where: 'type', 'hardware'
          -%}
          {%- comment -%}Both hardware finishes are discoverable; actual purchase is resolved across the catalog.{%- endcomment -%}
          {%- assign preset_hardware = preset_hardware_catalog -%}
          <div class="calder-pdp__option-group calder-pdp__finish-group">
            <div class="calder-pdp__option-heading">Hardware &amp; Rivet Finish</div>
            <div class="calder-pdp__option-values" data-calder-finishes="hardware">
              {%- assign calder_hardware_choices = 'Black,Chrome' | split: ',' -%}
              {%- for hw_val in calder_hardware_choices -%}
                {%- assign hw_asset = 'finish-bolt-bk.png' -%}
                {%- if hw_val == 'Chrome' -%}{%- assign hw_asset = 'finish-bolt-chrome.png' -%}{%- endif -%}
                <button
                  class="calder-pdp__finish-chip{% if hw_val == preset_hardware %} is-selected{% endif %}"
                  type="button" data-calder-finish
                  data-type="hardware"
                  data-value="{{ hw_val }}"
                  aria-label="{{ hw_val }}"
                  aria-pressed="{% if hw_val == preset_hardware %}true{% else %}false{% endif %}"><span class="calder-pdp__swatch-material" aria-hidden="true"><img src="{{ hw_asset | asset_url }}" alt="" width="30" height="30" loading="lazy"></span>
                  <span class="calder-pdp__finish-name">{{ hw_val }}</span></button>
              {%- endfor -%}
            </div>
          </div>
          <select id="CalderHardwareRivet-{{ section.id }}" class="calder-pdp__config-select" data-calder-hardware-rivet hidden>
            {%- for hw_val in calder_hardware_choices -%}<option value="{{ hw_val }}"{% if hw_val == preset_hardware %} selected{% endif %}>{{ hw_val }}</option>{%- endfor -%}
          </select>
          {%- else -%}

          {% comment %}
            Calder metafield configuration fallback.
          {% endcomment %}

          {%- if diameters != blank or widths != blank -%}
            <div class="calder-pdp__config-row">
              {%- if diameters != blank -%}
                <div class="calder-pdp__config-group">
                  <label class="calder-pdp__config-label">
                    Available Sizes &mdash; Diameter
                  </label>
                  <div class="calder-pdp__finishes" data-calder-diameter>
                    {%- for diameter in diameters -%}
                      <button
                        class="calder-pdp__finish-chip calder-pdp__diameter-chip{% if forloop.first %} is-selected{% endif %}"
                        type="button"
                        data-calder-diameter-option
                        data-value="{{ diameter | escape }}"
                        aria-label="{{ diameter | escape }}"
                        aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                      >
                        {{ diameter }}
                      </button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}
              {%- if widths != blank -%}
                <div class="calder-pdp__config-group">
                  <label
                    class="calder-pdp__config-label"
                    for="CalderWidth-{{ section.id }}"
                  >
                    Width
                  </label>
                  <select
                    id="CalderWidth-{{ section.id }}"
                    class="calder-pdp__config-select"
                    data-calder-width
                  >
                    <option value="">
                      {{ section.settings.placeholder_width }}
                    </option>
                    {%- for width in widths -%}
                      <option value="{{ width | escape }}">
                        {{ width }}
                      </option>
                    {%- endfor -%}
                  </select>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- if finish_options != blank -%}
            <div class="calder-pdp__config-group calder-pdp__finish-group">
              <label class="calder-pdp__config-label">
                Center Finish
              </label>
              <div
                class="calder-pdp__finishes"
                data-calder-finishes="center"
              >
                {%- for finish in finish_options -%}
                  {%- liquid
                    assign finish_label = finish.label | default: finish.value | default: finish
                    assign finish_value = finish.value | default: finish
                  -%}
                  {%- liquid
  assign calder_finish_key = finish_value | handleize
  assign calder_finish_asset = blank
  case calder_finish_key
    when 'black-tint'
      assign calder_finish_asset = 'finish-black-tint.jpg'
    when 'chrome'
      assign calder_finish_asset = 'finish-chrome.jpg'
    when 'gloss-black'
      assign calder_finish_asset = 'finish-gloss-black.jpg'
    when 'titanium-tint'
      assign calder_finish_asset = 'finish-titanium-tint.jpg'
  endcase
-%}
                  <button
                    class="calder-pdp__finish-chip{% if forloop.first %} is-selected{% endif %}"
                    type="button"
                    data-calder-finish
                    data-type="center"
                    data-value="{{ finish_value | escape }}"
                    aria-label="{{ finish_label | escape }}"
                    aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                    title="{{ finish_label | escape }}"
                  >
                    {%- if calder_finish_asset != blank -%}
                      {%- if calder_finish_asset != blank -%}<span class="calder-pdp__swatch-material" aria-hidden="true"><img src="{{ calder_finish_asset | asset_url }}" alt="" width="88" height="88" loading="lazy"></span>{%- endif -%}<span class="calder-pdp__finish-name">{{ finish_label | escape }}</span>
                    {%- elsif finish.image -%}
                      <span class="calder-pdp__swatch-material" aria-hidden="true">{{ finish.image | image_url: width: 180 | image_tag: loading: 'lazy', alt: '' }}</span>
                      <span class="calder-pdp__finish-name">{{ finish_label | escape }}</span>
                    {%- else -%}
                      <span class="calder-pdp__finish-name">{{ finish_label | escape }}</span>
                    {%- endif -%}
                  </button>
                {%- endfor -%}
              </div>
            </div>
            {%- liquid
              assign bom = product.metafields.custom.bom.value
              assign bom_comps = bom.components | default: bom
              assign barrel_options = bom_comps | where: 'type', 'barrel'
              assign hardware_options = bom_comps | where: 'type', 'hardware'
            -%}
            <div class="calder-pdp__config-group calder-pdp__finish-group">
              <label class="calder-pdp__config-label">Barrel &amp; Lip Finish</label>
              <div class="calder-pdp__finishes" data-calder-finishes="barrel">
                {%- assign barrel_choices = 'Black,Chrome' | split: ',' -%}
                {%- assign preset_barrel = preset_barrel_catalog -%}
                {%- for finish in barrel_choices -%}
                  {%- assign asset = 'finish-barrel-bk.png' -%}
                  {%- assign label = 'Black' -%}
                  {%- if finish == 'Chrome' -%}{%- assign asset = 'finish-barrel-polish.png' -%}{%- assign label = 'Polish' -%}{%- endif -%}
                  <button
                    type="button"
                    class="calder-pdp__finish-chip{% if finish == preset_barrel %} is-selected{% endif %}" data-calder-finish
                    data-type="barrel"
                    data-value="{{ finish }}"
                    aria-label="{{ label }}"
                    aria-pressed="{% if finish == preset_barrel %}true{% else %}false{% endif %}"><span class="calder-pdp__swatch-material"><img src="{{ asset | asset_url }}" width="30" height="30" alt=""></span>
                    <span class="calder-pdp__finish-name">{{ label }}</span></button>
                {%- endfor -%}
              </div>
            </div>
            <div class="calder-pdp__config-group calder-pdp__finish-group">
              <label class="calder-pdp__config-label">Hardware &amp; Rivet Finish</label>
              <div class="calder-pdp__finishes" data-calder-finishes="hardware">
                {%- assign hardware_choices = 'Black,Chrome' | split: ',' -%}
                {%- assign preset_hardware = preset_hardware_catalog -%}
                {%- for finish in hardware_choices -%}
                  {%- assign asset = 'finish-bolt-bk.png' -%}
                  {%- if finish == 'Chrome' -%}{%- assign asset = 'finish-bolt-chrome.png' -%}{%- endif -%}
                  <button
                    type="button"
                    class="calder-pdp__finish-chip{% if finish == preset_hardware %} is-selected{% endif %}" data-calder-finish
                    data-type="hardware"
                    data-value="{{ finish }}"
                    aria-label="{{ finish }}"
                    aria-pressed="{% if finish == preset_hardware %}true{% else %}false{% endif %}"><span class="calder-pdp__swatch-material"><img src="{{ asset | asset_url }}" width="30" height="30" alt=""></span>
                    <span class="calder-pdp__finish-name">{{ finish }}</span></button>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
          {%- if applications != blank -%}
            <div class="calder-pdp__config-group">
              <label
                class="calder-pdp__config-label"
                for="CalderApplication-{{ section.id }}"
              >
                Vehicle Fitment / Application
              </label>
              <select
                id="CalderApplication-{{ section.id }}"
                class="calder-pdp__config-select"
                data-calder-application
              >
                <option value="">
                  {{ section.settings.placeholder_application }}
                </option>
                {%- for application in applications -%}
                  <option value="{{ application | escape }}">
                    {{ application }}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>

      {% comment %}
        ==========================================================
        PURCHASE AREA
        ==========================================================
      {% endcomment %}

      <div class="calder-pdp__pre-purchase-divider"></div>
      <div class="calder-pdp__purchase">
          <div class="calder-pdp__price-column">
            {%- if section.settings.price_prefix != blank -%}
              <span class="calder-pdp__price-prefix">
                {{ section.settings.price_prefix }}
              </span>
            {%- endif -%}
            <div class="calder-pdp__price">
              {% render 'price',
                render: true,
                product: product,
                use_variant: true,
                price_class: 'price--large',
                product_form_id: product_form_id,
                layout: layout
              %}
            </div>
          </div>
        <div class="calder-pdp__purchase-row">
          <div class="calder-pdp__quantity-column">
            <span class="calder-pdp__purchase-label">
              Quantity
            </span>
            <div class="calder-pdp__qty">
              <button
                class="calder-pdp__qty-btn"
                type="button"
                data-calder-qty-minus
                aria-label="Decrease quantity"
              >
                &minus;
              </button>
              <input
                class="calder-pdp__qty-input"
                type="number"
                value="1"
                min="1"
                inputmode="numeric"
                data-calder-qty-input
                aria-label="Quantity"
              >
              <button
                class="calder-pdp__qty-btn"
                type="button"
                data-calder-qty-plus
                aria-label="Increase quantity"
              >
                +
              </button>
            </div>
          </div>
        <div class="calder-pdp__buy">
          {%- if is_universal_design -%}
            {% render 'calder-universal-purchase', product: product, min_qty: section.settings.calder_min_component_qty %}
          {%- else -%}
          {%- assign buy_block = section.blocks | where: 'type', 'buy_buttons' | first -%}
          {%- if buy_block -%}
            {% render 'product-buy-buttons',
              block: buy_block,
              product: product,
              product_form_id: product_form_id,
              section_id: section_id,
              layout: layout,
              show_dynamic_checkout: buy_block.settings.show_dynamic_checkout,
              show_cart_note: false,
              hide_quantity: true,
              hide_add_to_cart: false
            %}
          {%- else -%}
            {%- form
              'product',
              product,
              id: product_form_id,
              class: 'form js-product-form calder-pdp__form',
              novalidate: 'novalidate'
            -%}
              <input
                type="hidden"
                name="id"
                value="{{ current_variant.id }}"
              >
              <input
                type="hidden"
                name="quantity"
                value="1"
                data-calder-form-quantity
              >
              <input
                type="hidden"
                name="properties[Hardware &amp; Rivet Finish]"
                value="{{ hardware_rivet_options | split: ',' | first | strip | escape }}"
                data-calder-hw-rivet-property
              >
              <button
                type="submit"
                name="add"
                class="calder-pdp__add-btn"
                {% unless current_variant.available %}
                  disabled
                {% endunless %}
              >
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 18 18"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M3.5 5.5H14.5L13.5 15H4.5L3.5 5.5Z"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                  <path
                    d="M6.5 7V4.5C6.5 3.12 7.62 2 9 2C10.38 2 11.5 3.12 11.5 4.5V7"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                </svg>
                <span>
                  {%- if current_variant.available -%}
                    Add to Cart
                  {%- else -%}
                    Sold Out
                  {%- endif -%}
                </span>
              </button>
            {%- endform -%}
          {%- endif -%}
          {%- endif -%}

          </div><!-- /.calder-pdp__purchase-row -->
      </div><!-- /.calder-pdp__purchase -->

      {% comment %}
        ==========================================================
        SAVE / SHARE
        ==========================================================
      {% endcomment %}

      <div class="calder-pdp__actions">
        {%- if section.settings.show_wishlist -%}
          <div
            class="calder-pdp__action calder-pdp__action--wishlist"
            data-render="wishlist-{{ product_form_id }}"
          >
            {% render 'wishlist-component-toggle-button',
              product: product,
              current_variant: current_variant
            %}
          </div>
        {%- endif -%}
        {%- if section.settings.show_share -%}
          <button
            class="calder-pdp__action-btn"
            data-calder-share
            type="button"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 18 18"
              fill="none"
              aria-hidden="true"
            >
              <circle cx="14" cy="3.5" r="2" stroke="currentColor" stroke-width="1.4"/>
              <circle cx="4" cy="9" r="2" stroke="currentColor" stroke-width="1.4"/>
              <circle cx="14" cy="14.5" r="2" stroke="currentColor" stroke-width="1.4"/>
              <path d="M5.75 8L12.25 4.5" stroke="currentColor" stroke-width="1.4"/>
              <path d="M5.75 10L12.25 13.5" stroke="currentColor" stroke-width="1.4"/>
            </svg>
            <span>
              {{ section.settings.share_text }}
            </span>
          </button>
        {%- endif -%}
      </div>

      {% comment %}
        ==========================================================
        TRUST ROW
        ==========================================================
      {% endcomment %}

      {%- if
        section.settings.show_trust_made_to_order
        or section.settings.show_trust_shipping
        or section.settings.show_trust_checkout
      -%}
        
      {%- endif -%}

      {% comment %}
        ==========================================================
        APP BLOCKS
        Keeps compatibility with product apps without allowing
        them to break the approved upper product composition.
        ==========================================================
      {% endcomment %}

      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div
            class="calder-pdp__app-block"
            {{ block.shopify_attributes }}
          >
            {% render block %}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

      <div class="calder-pdp__trust">
          {%- if section.settings.show_trust_made_to_order -%}
            <div class="calder-pdp__trust-item">
              <svg class="calder-feature__icon" width="24" height="24" viewBox="0 0 512 512" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                <path d="M393.87 190a32.1 32.1 0 0 1-45.25 0l-26.57-26.57a32.09 32.09 0 0 1 0-45.26L382.19 58a1 1 0 0 0-.3-1.64c-38.82-16.64-89.15-8.16-121.11 23.57-30.58 30.35-32.32 76-21.12 115.84a31.93 31.93 0 0 1-9.06 32.08L64 380a48.17 48.17 0 1 0 68 68l153.86-167a31.93 31.93 0 0 1 31.6-9.13c39.54 10.59 84.54 8.6 114.72-21.19 32.49-32 39.5-88.56 23.75-120.93a1 1 0 0 0-1.6-.26Z" stroke="currentColor" stroke-linecap="round" stroke-miterlimit="10" stroke-width="32"/>
                <circle cx="96" cy="416" r="16" fill="currentColor"/>
              </svg>
              <span>
                {{ section.settings.trust_made_to_order }}
              </span>
            </div>
          {%- endif -%}
          {%- if section.settings.show_trust_shipping -%}
            <div class="calder-pdp__trust-item">
              <svg class="calder-feature__icon" width="24" height="24" viewBox="0 0 512 512" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                <circle cx="256" cy="160" r="128" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="32"/>
                <path d="M143.65 227.82 48 400l86.86-.42a16 16 0 0 1 13.82 7.8L192 480l88.33-194.32" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="32"/>
                <path d="M366.54 224 464 400l-86.86-.42a16 16 0 0 0-13.82 7.8L320 480l-64-140.8" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="32"/>
                <circle cx="256" cy="160" r="64" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="32"/>
              </svg>
              <span>
                {{ section.settings.trust_shipping }}
              </span>
            </div>
          {%- endif -%}
          {%- if section.settings.show_trust_checkout -%}
            <div class="calder-pdp__trust-item">
              <svg class="calder-feature__icon" width="24" height="24" viewBox="0 0 512 512" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                <path d="M336 176 225.2 304 176 255.8" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="32"/>
                <path d="M463.1 112.37C373.68 96.33 336.71 84.45 256 48c-80.71 36.45-117.68 48.33-207.1 64.37C32.7 369.13 240.58 457.79 256 464c15.42-6.21 223.3-94.87 207.1-351.63" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="32"/>
              </svg>
              <span>
                {{ section.settings.trust_checkout }}
              </span>
            </div>
          {%- endif -%}
        </div>

  </div>
</div>

{% comment %}
  ==============================================================
  PRODUCT DATA
  This is intentionally retained so Calder controls can access
  Shopify variants without maintaining a second hardcoded data
  model.
  ==============================================================
{% endcomment %}

<script
  type="application/json"
  data-calder-product-json="{{ section.id }}"
>
  {{ product.variants | json }}
</script>

<script>
(function() {
  function initCalderProduct(section) {
    if (!section || section.dataset.calderInitialized === 'true') {
      return;
    }
    section.dataset.calderInitialized = 'true';
/* ==========================================================
       QUANTITY
       ========================================================== */
    var qtyInput = section.querySelector('[data-calder-qty-input]');
    var qtyMinus = section.querySelector('[data-calder-qty-minus]');
    var qtyPlus = section.querySelector('[data-calder-qty-plus]');
    function normalizeQuantity() {
      if (!qtyInput) return 1;
      var value = parseInt(qtyInput.value, 10);
      if (isNaN(value) || value < 1) {
        value = 1;
      }
      qtyInput.value = value;
      return value;
    }
    function syncQuantity() {
      var quantity = normalizeQuantity();
      /*
        Native Lumia buy button snippet may create its own
        product-form quantity input. Synchronize any quantity
        field inside this section.
      */
      var formQuantityInputs = section.querySelectorAll(
        'form[action*="/cart/add"] input[name="quantity"], [data-calder-form-quantity]'
      );
      formQuantityInputs.forEach(function(input) {
        input.value = quantity;
      });
    }
    if (qtyMinus && qtyInput) {
      qtyMinus.addEventListener('click', function() {
        var value = normalizeQuantity();
        qtyInput.value = Math.max(1, value - 1);
        syncQuantity();
      });
    }
    if (qtyPlus && qtyInput) {
      qtyPlus.addEventListener('click', function() {
        var value = normalizeQuantity();
        qtyInput.value = value + 1;
        syncQuantity();
      });
    }
    if (qtyInput) {
      qtyInput.addEventListener('change', syncQuantity);
      qtyInput.addEventListener('input', syncQuantity);
      syncQuantity();
    }
    /* ── CALDER FINISH CHIPS (Center, Barrel, Hardware) ── */
    var finishChips = section.querySelectorAll('[data-calder-finish]');
    finishChips.forEach(function(chip) {
      chip.addEventListener('click', function() {
        var group = chip.closest('[data-calder-finishes]');
        var groupChips = group ? group.querySelectorAll('[data-calder-finish]') : finishChips;
        var finishType = chip.dataset.type || 'center';
        groupChips.forEach(function(item) {
          item.classList.remove('is-selected');
          item.setAttribute('aria-pressed', 'false');
        });
        chip.classList.add('is-selected');
        chip.setAttribute('aria-pressed', 'true');
        section.dispatchEvent(
          new CustomEvent('calder:finish-selected', {
            bubbles: true,
            detail: {
              type: finishType,
              value: chip.dataset.value
            }
          })
        );
        if (finishType === 'hardware') {
          var hardwareSelect = section.querySelector('[data-calder-hardware-rivet]');
          var hardwareProperty = section.querySelector('[data-calder-hw-rivet-property]');
          if (hardwareSelect) hardwareSelect.value = chip.dataset.value;
          if (hardwareProperty) hardwareProperty.value = chip.dataset.value;
        }
      });
    });
    /* ── CALDER DIAMETER PILLS ── */
    var diameterPills = section.querySelectorAll('[data-calder-diameter-option]');
    diameterPills.forEach(function(pill) {
      pill.addEventListener('click', function() {
        var group = pill.closest('[data-calder-diameter]');
        var groupPills = group ? group.querySelectorAll('[data-calder-diameter-option]') : diameterPills;
        groupPills.forEach(function(item) {
          item.classList.remove('is-selected');
          item.setAttribute('aria-pressed', 'false');
        });
        pill.classList.add('is-selected');
        pill.setAttribute('aria-pressed', 'true');
      });
    });
    /* ── Sync hardware rivet dropdown to hidden form property ── */
    var hwRivetSelect = section.querySelector('[data-calder-hardware-rivet]');
    var hwRivetInput = section.querySelector('[data-calder-hw-rivet-property]');
    if (hwRivetSelect && hwRivetInput) {
      hwRivetSelect.addEventListener('change', function () {
        hwRivetInput.value = this.value || '';
      });
    }
    /* ==========================================================
       FITMENT
       ========================================================== */
    var fitmentPanel = section.querySelector('[data-calder-fitment]');
    if (fitmentPanel) {
      var fitmentAction =
        fitmentPanel.querySelector('[data-calder-fitment-action]');
      var fitmentLabel =
        fitmentPanel.querySelector('[data-calder-fitment-label]');
      var fitmentText =
        fitmentPanel.querySelector('[data-calder-fitment-text]');
      var fitmentVehicle =
        fitmentPanel.querySelector('[data-calder-fitment-vehicle]');
      var fitmentActionText =
        fitmentPanel.querySelector('[data-calder-fitment-action-text]');
      function renderVehicle(vehicle) {
        if (
          !vehicle ||
          !vehicle.year ||
          !vehicle.make
        ) {
          return;
        }
        var vehicleString = vehicle.display_name || [
          vehicle.year,
          vehicle.make,
          vehicle.model,
          (vehicle.trim && vehicle.trim !== vehicle.display_name) ? vehicle.trim : ''
        ]
        .filter(Boolean)
        .join(' ');
        fitmentPanel.classList.remove(
          'calder-pdp__fitment--unset'
        );
        fitmentPanel.classList.add(
          'calder-pdp__fitment--confirmed'
        );
        if (fitmentLabel) {
          fitmentLabel.textContent = 'Fits Your Vehicle';
        }
        if (fitmentText) {
          fitmentText.hidden = true;
        }
        if (fitmentVehicle) {
          fitmentVehicle.textContent = vehicleString;
          fitmentVehicle.hidden = false;
        }
        if (fitmentActionText) {
          fitmentActionText.textContent = 'Change Vehicle';
        }
        if (fitmentPanel.querySelector('[data-calder-fitment-reset]')) {
          fitmentPanel.querySelector('[data-calder-fitment-reset]').hidden = false;
        }
      }
      function clearVehicle() {
        fitmentPanel.classList.add(
          'calder-pdp__fitment--unset'
        );
        fitmentPanel.classList.remove(
          'calder-pdp__fitment--confirmed'
        );
        if (fitmentLabel) {
          fitmentLabel.textContent =
            {{ section.settings.fitment_unset_heading | json }};
        }
        if (fitmentText) {
          fitmentText.textContent =
            {{ section.settings.text_no_vehicle | json }};
          fitmentText.hidden = false;
        }
        if (fitmentVehicle) {
          fitmentVehicle.textContent = '';
          fitmentVehicle.hidden = true;
        }
        var ckIcon = fitmentPanel.querySelector('.calder-pdp__fitment-icon-check');
        var wrIcon = fitmentPanel.querySelector('.calder-pdp__fitment-icon-warn');
        if (ckIcon) { ckIcon.hidden = false; }
        if (wrIcon) { wrIcon.hidden = true; }
        if (fitmentPanel.querySelector('[data-calder-fitment-reset]')) {
          fitmentPanel.querySelector('[data-calder-fitment-reset]').hidden = true;
        }
        if (fitmentActionText) {
          fitmentActionText.textContent =
            {{ section.settings.action_text | json }};
        }
      }
      document.addEventListener(
        'calder:vehicle-selected',
        function(event) {
          if (event.detail) {
            ffvVehicle = event.detail;
            ffvResolved = null;
            ffvUpdateStatus();
          }
        }
      );

      /* ── Mini vehicle form: inline Select/Change Vehicle (no page scroll) ── */
      var fitmentForm = fitmentPanel.querySelector('[data-calder-fitment-form]');
      var ffvYear = fitmentPanel.querySelector('[data-calder-ffv-year]');
      var ffvMake = fitmentPanel.querySelector('[data-calder-ffv-make]');
      var ffvModel = fitmentPanel.querySelector('[data-calder-ffv-model]');
      var ffvApply = fitmentPanel.querySelector('[data-calder-ffv-apply]');
      var ffvData = null;
      var ffvVehicle = null;
      var ffvResolved = null;

      function ffvSaveVehicle(vehicle) {
        try {
          localStorage.setItem('calder_selected_vehicle', JSON.stringify(Object.assign({}, vehicle, {
            year: vehicle.y || vehicle.year,
            make: vehicle.m || vehicle.make,
            model: vehicle.M || vehicle.model,
            display_name: vehicle.display_name || [vehicle.y || vehicle.year, vehicle.m || vehicle.make, vehicle.M || vehicle.model].filter(Boolean).join(' ')
          })));
        } catch (e) {}
      }
      function ffvLoadSaved() {
        try { var raw = localStorage.getItem('calder_selected_vehicle'); return raw ? JSON.parse(raw) : null; } catch (e) { return null; }
      }
      function ffvVehiclePatterns() {
        var out = [];
        if (!ffvVehicle) { return out; }
        [ffvVehicle.b, ffvVehicle.bolt_pattern].forEach(function (raw) {
          if (!raw) { return; }
          var v = String(raw).trim().toLowerCase().replace(/\s+/g, '').replace(/\.\d+$/, '');
          if (v && out.indexOf(v) === -1) { out.push(v); }
        });
        return out;
      }
      function ffvUpdateStatus() {
        if (!ffvVehicle) { clearVehicle(); return; }
        var designPatterns = (ffvResolved && ffvResolved.designPatterns) || [];
        var vPats = ffvVehiclePatterns();
        var matches = designPatterns.length > 0 && vPats.length > 0 && vPats.some(function (p) {
          return designPatterns.indexOf(p) !== -1;
        });
        var checkIcon = fitmentPanel.querySelector('.calder-pdp__fitment-icon-check');
        var warnIcon = fitmentPanel.querySelector('.calder-pdp__fitment-icon-warn');
        if (matches) {
          fitmentPanel.classList.remove('calder-pdp__fitment--unset');
          fitmentPanel.classList.add('calder-pdp__fitment--confirmed');
          fitmentPanel.classList.remove('calder-pdp__fitment--verify');
          if (fitmentLabel) { fitmentLabel.textContent = 'Fits Your Vehicle'; }
          if (checkIcon) { checkIcon.hidden = false; }
          if (warnIcon) { warnIcon.hidden = true; }
        } else {
          fitmentPanel.classList.remove('calder-pdp__fitment--unset');
          fitmentPanel.classList.add('calder-pdp__fitment--confirmed', 'calder-pdp__fitment--verify');
          if (fitmentLabel) { fitmentLabel.textContent = 'Verification Required'; }
          if (checkIcon) { checkIcon.hidden = true; }
          if (warnIcon) { warnIcon.hidden = false; }
        }
        if (fitmentVehicle) {
          var vs = ffvVehicle.display_name || [ffvVehicle.year, ffvVehicle.make, ffvVehicle.model].filter(Boolean).join(' ');
          fitmentVehicle.textContent = vs;
          fitmentVehicle.hidden = false;
        }
        if (fitmentText) { fitmentText.hidden = true; }
        if (fitmentActionText) { fitmentActionText.textContent = 'Change Vehicle'; }
        if (fitmentReset) { fitmentReset.hidden = false; }
      }
      function ffvPopulate(select, values, selected) {
        select.innerHTML = '';
        var ph = document.createElement('option');
        ph.value = '';
        ph.textContent = select.getAttribute('aria-label') || '';
        select.appendChild(ph);
        values.forEach(function (v) {
          var o = document.createElement('option');
          o.value = String(v);
          o.textContent = String(v);
          select.appendChild(o);
        });
        if (selected != null && values.map(String).indexOf(String(selected)) !== -1) {
          select.value = String(selected);
        } else {
          select.value = '';
        }
      }
      function ffvRefresh() {
        if (!ffvData) { return; }
        var years = [];
        ffvData.forEach(function (v) { if (years.indexOf(v.y) === -1) { years.push(v.y); } });
        years.sort(function (a, b) { return b - a; });
        var saved = ffvLoadSaved();
        ffvPopulate(ffvYear, years, saved && (saved.y || saved.year));
        ffvYear.dispatchEvent(new Event('change', { bubbles: true }));
        if (saved && (saved.m || saved.make)) {
          ffvMake.value = String(saved.m || saved.make);
          ffvMake.dispatchEvent(new Event('change', { bubbles: true }));
          if (saved.M || saved.model) {
            ffvModel.value = String(saved.M || saved.model);
            ffvModel.dispatchEvent(new Event('change', { bubbles: true }));
          }
        }
        ffvUpdateApply();
      }
      function ffvUpdateApply() {
        if (ffvApply) { ffvApply.disabled = !(ffvYear.value && ffvMake.value && ffvModel.value); }
      }
      function ffvCascadeMake() {
        var makes = [];
        ffvData.forEach(function (v) { if (String(v.y) === ffvYear.value && makes.indexOf(v.m) === -1) { makes.push(v.m); } });
        makes.sort();
        ffvPopulate(ffvMake, makes);
        ffvMake.disabled = !ffvYear.value;
        ffvCascadeModel();
      }
      function ffvCascadeModel() {
        var models = [];
        ffvData.forEach(function (v) { if (String(v.y) === ffvYear.value && v.m === ffvMake.value && models.indexOf(v.M) === -1) { models.push(v.M); } });
        models.sort();
        ffvPopulate(ffvModel, models);
        ffvModel.disabled = !ffvMake.value;
        ffvUpdateApply();
      }
      function ffvToggle(open) {
        if (!fitmentForm) { return; }
        var willOpen = open == null ? fitmentForm.hidden : open;
        fitmentForm.hidden = !willOpen;
        if (fitmentAction) { fitmentAction.setAttribute('aria-expanded', willOpen ? 'true' : 'false'); }
        if (willOpen) {
          if (ffvData) { ffvRefresh(); }
          else {
            fetch({{ 'calder-fitment-data.json' | asset_url | json }}, { headers: { Accept: 'application/json' } })
              .then(function (r) { return r.json(); })
              .then(function (parsed) { ffvData = parsed.vehicles || []; window.__cwFitmentData = ffvData; ffvRefresh(); })
              .catch(function () {});
          }
        }
      }
      if (ffvYear) {
        ffvYear.addEventListener('change', function () {
          if (ffvData) { ffvCascadeMake(); } else { ffvUpdateApply(); }
        });
        ffvMake.addEventListener('change', function () {
          if (ffvData) { ffvCascadeModel(); } else { ffvUpdateApply(); }
        });
        ffvModel.addEventListener('change', ffvUpdateApply);
      }
      if (ffvApply) {
        ffvApply.addEventListener('click', function () {
          if (!ffvData || !ffvYear.value || !ffvMake.value || !ffvModel.value) { return; }
          var match = null;
          for (var i = 0; i < ffvData.length; i++) {
            var v = ffvData[i];
            if (String(v.y) === ffvYear.value && v.m === ffvMake.value && v.M === ffvModel.value) { match = v; break; }
          }
          if (!match) { return; }
          ffvSaveVehicle(match);
          ffvVehicle = Object.assign({}, match, { year: match.y, make: match.m, model: match.M, display_name: [match.y, match.m, match.M].filter(Boolean).join(' ') });
          ffvResolved = null;
          ffvUpdateStatus();
          ffvToggle(false);
          document.dispatchEvent(new CustomEvent('calder:vehicle-selected', { detail: ffvVehicle }));
        });
      }
      if (fitmentAction) {
        fitmentAction.addEventListener('click', function () { ffvToggle(); });
      }
      var fitmentReset = fitmentPanel.querySelector('[data-calder-fitment-reset]');
      function ffvResetVehicle() {
        try { localStorage.removeItem('calder_selected_vehicle'); } catch (e) {}
        ffvVehicle = null;
        ffvResolved = null;
        if (fitmentForm && !fitmentForm.hidden) { ffvToggle(false); }
        if (fitmentReset) { fitmentReset.hidden = true; }
        clearVehicle();
        document.dispatchEvent(new CustomEvent('calder:vehicle-cleared'));
      }
      if (fitmentReset) {
        fitmentReset.addEventListener('click', ffvResetVehicle);
      }
      document.addEventListener('click', function (evt) {
        if (fitmentForm && !fitmentForm.hidden && fitmentPanel && !fitmentPanel.contains(evt.target)) {
          ffvToggle(false);
        }
      });
      document.addEventListener('keydown', function (evt) {
        if (evt.key === 'Escape' && fitmentForm && !fitmentForm.hidden) { ffvToggle(false); }
      });
      document.addEventListener('calder:universal-resolved', function (event) {
        ffvResolved = event && event.detail ? event.detail : null;
        if (ffvVehicle) { ffvUpdateStatus(); }
      });
      document.addEventListener('calder:vehicle-cleared', function () {
        ffvVehicle = null;
        ffvResolved = null;
        clearVehicle();
      });
      try {
        var savedVehicle = ffvLoadSaved();
        if (savedVehicle) {
          ffvVehicle = savedVehicle;
          ffvUpdateStatus();
        }
      } catch (error) {
        console.warn(
          'Calder vehicle state could not be restored.',
          error
        );
      }
    }
    /* ==========================================================
       SHARE
       ========================================================== */
    var shareButton =
      section.querySelector('[data-calder-share]');
    if (shareButton) {
      shareButton.addEventListener('click', function() {
        var shareData = {
          title: document.title,
          text: {{ product.title | json }},
          url: window.location.href
        };
        if (navigator.share) {
          navigator.share(shareData).catch(function() {});
          return;
        }
        if (navigator.clipboard) {
          navigator.clipboard
            .writeText(window.location.href)
            .then(function() {
              var label =
                shareButton.querySelector('span');
              if (!label) return;
              var originalText = label.textContent;
              label.textContent = 'Link Copied';
              window.setTimeout(function() {
                label.textContent = originalText;
              }, 1600);
            });
        }
      });
    }
    /* ==========================================================
       NATIVE PRODUCT FORM QUANTITY SYNC
       Lumia controls submission/AJAX. Calder only synchronizes
       the approved-layout quantity control.
       ========================================================== */
    var productForms =
      section.querySelectorAll('form[action*="/cart/add"]');
    productForms.forEach(function(form) {
      form.addEventListener('submit', function() {
        syncQuantity();
      });
    });
  }
  function initCurrentSection() {
    var section =
      document.getElementById(
        'CalderProduct-{{ section.id }}'
      );
    initCalderProduct(section);
  }
  if (document.readyState === 'loading') {
    document.addEventListener(
      'DOMContentLoaded',
      initCurrentSection
    );
  } else {
    initCurrentSection();
  }
  document.addEventListener(
    'shopify:section:load',
    function(event) {
      var section =
        event.target.querySelector(
          '#CalderProduct-{{ section.id }}'
        );
      if (section) {
        initCalderProduct(section);
      }
    }
  );
})();
</script>

