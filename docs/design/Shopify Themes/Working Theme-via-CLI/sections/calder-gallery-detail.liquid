{% comment %}Calder detail v2: shared vehicle/wheel gallery build metaobject template{% endcomment %}
{{ 'calder-gallery-v2.css' | asset_url | stylesheet_tag }}
{% assign qs = request.query_string | default: '' | split: '&' %}
{% assign handle = '' %}
{% for pair in qs %}{% assign kv = pair | split: '=' %}{% if kv[0] == 'build' %}{% assign handle = kv[1] | url_decode %}{% endif %}{% endfor %}
{% assign entry = shop.metaobjects.gallery_build[handle] %}
{% assign fallback = section.blocks | where: 'type', 'build' | first %}
{% if entry == blank and handle == blank and fallback != blank %}{% assign entry = fallback.settings %}{% endif %}
{% if entry != blank %}
{% assign title = entry.title.value | default: entry.title | default: entry.wheel_model.value | default: entry.wheel_model %}
{% assign series = entry.wheel_series.value | default: entry.wheel_series %}
{% assign model = entry.wheel_model.value | default: entry.wheel_model %}
{% assign finish = entry.overall_finish.value | default: entry.overall_finish %}
{% assign gallery_type = entry.gallery_type.value | default: entry.gallery_type | default: 'wheel' %}
{% assign description = entry.description.value | default: entry.description | default: entry.fitment_notes.value %}
{% assign images = entry.gallery_images.value %}
{% assign featured = entry.featured_image.value | default: entry.featured_image | default: entry.image %}
<section class="cg-detail" data-gallery-detail data-autoplay="{{ section.settings.hero_auto_rotate }}" data-interval="{{ section.settings.hero_rotate_seconds | times: 1000 }}">
 <div class="cg-detail-hero" style="--cg-detail-height:{{ section.settings.hero_height }}px;--cg-overlay:{{ section.settings.hero_overlay | divided_by: 100.0 }}">
  <div class="cg-detail-visual">
   <div class="cg-detail-breadcrumb"><a href="/pages/{{ gallery_type }}-gallery">{{ gallery_type | capitalize }} Gallery</a> › {{ title | escape }}</div>
   <div class="cg-detail-slides" data-slides>
   {% assign slide_index = 0 %}
   {% if featured != blank %}<img class="cg-detail-slide is-active" data-slide="{{ slide_index }}" src="{{ featured | image_url: width: 1900 }}" alt="{{ title | escape }}" width="1600" height="1100" fetchpriority="high">{% assign slide_index = slide_index | plus: 1 %}{% endif %}
   {% for image in images %}{% if image != featured %}<img class="cg-detail-slide" data-slide="{{ slide_index }}" src="{{ image | image_url: width: 1900 }}" alt="{{ title | escape }} view {{ slide_index | plus: 1 }}" width="1600" height="1100" loading="lazy">{% assign slide_index = slide_index | plus: 1 %}{% endif %}{% endfor %}
   {% if entry.image_2 != blank %}<img class="cg-detail-slide" data-slide="{{ slide_index }}" src="{{ entry.image_2 | image_url: width: 1900 }}" alt="Alternate view" width="1600" height="1100" loading="lazy">{% assign slide_index = slide_index | plus: 1 %}{% endif %}
   {% if entry.image_3 != blank %}<img class="cg-detail-slide" data-slide="{{ slide_index }}" src="{{ entry.image_3 | image_url: width: 1900 }}" alt="Alternate view" width="1600" height="1100" loading="lazy">{% assign slide_index = slide_index | plus: 1 %}{% endif %}
   {% for block in section.blocks %}{% if block.type == 'hero_slide' and block.settings.image != blank %}<img class="cg-detail-slide" data-slide="{{ slide_index }}" src="{{ block.settings.image | image_url: width: 1900 }}" alt="{{ block.settings.alt | escape }}" width="1600" height="1100" loading="lazy">{% assign slide_index = slide_index | plus: 1 %}{% endif %}{% endfor %}
   </div>
   {% if slide_index > 1 %}<button class="cg-slide-prev" type="button" aria-label="Previous slide">‹</button><button class="cg-slide-next" type="button" aria-label="Next slide">›</button>{% endif %}
   <span class="cg-slide-counter" data-slide-counter>01 / {{ slide_index | prepend: '0' | slice: -2, 2 }}</span>
  </div>
  <div class="cg-detail-summary"><p class="cg-eyebrow">{{ series | escape }} SERIES</p><h1>{{ section.settings.hero_text_title | default: title | escape }}</h1><p>{{ description | escape }}</p><p class="cg-detail-finish">FINISH SHOWN<br><strong>{{ finish | escape }}</strong></p><a class="cg-btn cg-btn-gold" href="#wheel-specifications">VIEW WHEEL SPECS →</a><a class="cg-btn cg-btn-outline" href="{{ section.settings.fitment_url | default: '/pages/fitment-finder' }}">FIND YOUR FIT</a></div>
  {% if section.settings.show_thumbnails and slide_index > 1 %}<div class="cg-detail-thumbs" data-slide-thumbs>{% if featured != blank %}<button type="button" class="is-active" data-index="0"><img src="{{ featured | image_url: width: 180 }}" alt="View 1" width="110" height="75"></button>{% endif %}{% assign thumb_index = 1 %}{% for image in images %}{% if image != featured %}<button type="button" data-index="{{ thumb_index }}"><img src="{{ image | image_url: width: 180 }}" alt="View {{ thumb_index | plus: 1 }}" width="110" height="75"></button>{% assign thumb_index = thumb_index | plus: 1 %}{% endif %}{% endfor %}{% for block in section.blocks %}{% if block.type == 'hero_slide' and block.settings.image != blank %}<button type="button" data-index="{{ thumb_index }}"><img src="{{ block.settings.image | image_url: width: 180 }}" alt="View {{ thumb_index | plus: 1 }}" width="110" height="75"></button>{% assign thumb_index = thumb_index | plus: 1 %}{% endif %}{% endfor %}</div>{% endif %}
 </div>
 {% if section.settings.show_trusted %}<div class="cg-trusted"><div class="cg-container"><div><span>{{ section.settings.trusted_eyebrow | escape }}</span><h2>{{ section.settings.trusted_heading | escape }}</h2></div><div class="cg-brand-logos">{% for block in section.blocks %}{% if block.type == 'brand' %}<div class="cg-brand-logo">{% if block.settings.logo != blank %}<img src="{{ block.settings.logo | image_url: width: 220 }}" alt="{{ block.settings.name | escape }}" width="150" height="70" loading="lazy">{% else %}<span>{{ block.settings.name | escape }}</span>{% endif %}</div>{% endif %}{% endfor %}</div></div></div>{% endif %}
 {% if section.settings.show_specs %}<section id="wheel-specifications" class="cg-specs" style="background-color:{{ section.settings.specs_background }};{% if section.settings.specs_image != blank %}--cg-spec-image:url('{{ section.settings.specs_image | image_url: width: 1400 }}');{% elsif featured != blank %}--cg-spec-image:url('{{ featured | image_url: width: 1400 }}');{% endif %}"><div class="cg-specs-art"></div><div class="cg-specs-content"><span class="cg-eyebrow">{{ series | escape }} SERIES</span><h2>{{ title | escape }}</h2><p>WHEEL SPECIFICATIONS</p><dl class="cg-spec-grid"><div><dt>WHEEL MODEL</dt><dd>{{ model | escape }}</dd></div><div><dt>SERIES</dt><dd>{{ series | escape }}</dd></div><div><dt>CONSTRUCTION</dt><dd>{{ entry.construction.value | default: entry.construction | default: 'Contact for details' | escape }}</dd></div><div><dt>FINISH SHOWN</dt><dd>{{ finish | escape }}</dd></div><div><dt>FRONT WHEEL SIZE</dt><dd>{{ entry.front_wheel_size.value | default: entry.front_wheel_size | escape }}</dd></div><div><dt>REAR WHEEL SIZE</dt><dd>{{ entry.rear_wheel_size.value | default: entry.rear_wheel_size | escape }}</dd></div><div><dt>BOLT PATTERN</dt><dd>{{ entry.bolt_pattern.value | default: entry.bolt_pattern | default: 'Custom fitment available' | escape }}</dd></div><div><dt>WEIGHT</dt><dd>{{ entry.weight.value | default: entry.weight | escape }}</dd></div><div><dt>LOAD RATING</dt><dd>{{ entry.load_rating.value | default: entry.load_rating | escape }}</dd></div>{% if gallery_type == 'vehicle' %}<div><dt>VEHICLE</dt><dd>{{ entry.vehicle_year.value }} {{ entry.vehicle_make.value }} {{ entry.vehicle_model.value }}</dd></div><div><dt>TIRE BRAND</dt><dd>{{ entry.tire_brand.value | escape }}</dd></div><div><dt>FITMENT NOTES</dt><dd>{{ entry.fitment_notes.value | escape }}</dd></div>{% endif %}</dl></div></section>{% endif %}
 {% if section.settings.show_related %}<div class="cg-container cg-mini-wrap"><section class="cg-mini"><div class="cg-mini-heading"><h2>{{ section.settings.vehicle_gallery_heading | escape }}</h2><a href="/pages/vehicle-gallery">VIEW ALL VEHICLE GALLERY →</a></div><div class="cg-mini-grid">{% assign related_count = 0 %}{% for build in shop.metaobjects.gallery_build.values %}{% assign kind = build.gallery_type.value | default: build.gallery_type %}{% if kind == 'vehicle' and build.wheel_model.value == model and build.system.handle != handle %}{% assign related_image = build.featured_image.value | default: build.gallery_images.value.first %}{% capture related_name %}{{ build.vehicle_make.value }} {{ build.vehicle_model.value }}{% endcapture %}{% assign link = build.system.url | default: '' %}{% if link == blank %}{% assign link = '/pages/gallery-build?build=' | append: build.system.handle %}{% endif %}{% render 'calder-gallery-card', image: related_image, heading: related_name, url: link, series: build.wheel_model.value, finish: build.overall_finish.value %}{% assign related_count = related_count | plus: 1 %}{% if related_count >= 4 %}{% break %}{% endif %}{% endif %}{% endfor %}</div></section><section class="cg-mini"><div class="cg-mini-heading"><h2>{{ section.settings.wheel_gallery_heading | escape }}</h2><a href="/pages/wheel-gallery">VIEW ALL WHEELS →</a></div><div class="cg-mini-grid">{% assign related_count = 0 %}{% for build in shop.metaobjects.gallery_build.values %}{% assign kind = build.gallery_type.value | default: build.gallery_type %}{% if kind == 'wheel' and build.system.handle != handle %}{% assign related_image = build.featured_image.value | default: build.gallery_images.value.first %}{% assign link = build.system.url | default: '' %}{% if link == blank %}{% assign link = '/pages/gallery-build?build=' | append: build.system.handle %}{% endif %}{% render 'calder-gallery-card', image: related_image, heading: build.wheel_model.value, url: link, series: build.wheel_series.value, finish: build.overall_finish.value %}{% assign related_count = related_count | plus: 1 %}{% if related_count >= 5 %}{% break %}{% endif %}{% endif %}{% endfor %}</div></section></div>{% endif %}
</section>
{% else %}<section class="cg-not-found"><h1>Gallery item not found</h1><p>Choose a published Gallery Build entry from the gallery listing.</p><a href="/pages/wheel-gallery">Back to Wheel Gallery</a></section>{% endif %}
<script src="{{ 'calder-gallery-v2.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Calder Gallery Detail",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Links"
    },
    {
      "type": "url",
      "id": "builder_url",
      "label": "Builder page URL"
    },
    {
      "type": "url",
      "id": "fitment_url",
      "label": "Fitment page URL"
    },
    {
      "type": "header",
      "content": "Section Width"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width source",
      "options": [
        {
          "value": "global",
          "label": "Use store width"
        },
        {
          "value": "custom",
          "label": "Custom width"
        }
      ],
      "default": "global"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 1178,
      "max": 1978,
      "step": 8,
      "unit": "px",
      "label": "Custom width",
      "default": 1178
    },
    {
      "type": "range",
      "id": "hero_height",
      "label": "Hero height",
      "min": 400,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "hero_overlay",
      "label": "Hero overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "show_thumbnails",
      "label": "Show slider thumbnails",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hero_auto_rotate",
      "label": "Auto rotate slides",
      "default": false
    },
    {
      "type": "range",
      "id": "hero_rotate_seconds",
      "label": "Seconds per slide",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 6
    },
    {
      "type": "text",
      "id": "hero_text_title",
      "label": "Override hero title (optional)"
    },
    {
      "type": "checkbox",
      "id": "show_trusted",
      "label": "Show vehicle brand strip",
      "default": true
    },
    {
      "type": "text",
      "id": "trusted_eyebrow",
      "label": "Brand strip eyebrow",
      "default": "TRUSTED BY WORLD-CLASS BRANDS"
    },
    {
      "type": "text",
      "id": "trusted_heading",
      "label": "Brand strip heading",
      "default": "LUXURY VEHICLES"
    },
    {
      "type": "checkbox",
      "id": "show_specs",
      "label": "Show specifications",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "specs_image",
      "label": "Specifications background image"
    },
    {
      "type": "color",
      "id": "specs_background",
      "label": "Specs background",
      "default": "#0b1117"
    },
    {
      "type": "checkbox",
      "id": "show_related",
      "label": "Show mini galleries",
      "default": true
    },
    {
      "type": "text",
      "id": "vehicle_gallery_heading",
      "label": "Vehicle gallery heading",
      "default": "VEHICLES WITH THIS WHEEL"
    },
    {
      "type": "text",
      "id": "wheel_gallery_heading",
      "label": "Wheel gallery heading",
      "default": "OTHER CALDER WHEELS"
    }
  ],
  "blocks": [
    {
      "type": "hero_slide",
      "name": "Additional hero slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        }
      ]
    },
    {
      "type": "brand",
      "name": "Vehicle brand logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Brand logo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Brand name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "build",
      "name": "Fallback gallery item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Featured image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Build title"
        },
        {
          "type": "text",
          "id": "vehicle_year",
          "label": "Vehicle year"
        },
        {
          "type": "text",
          "id": "vehicle_make",
          "label": "Vehicle make"
        },
        {
          "type": "text",
          "id": "vehicle_model",
          "label": "Vehicle model"
        },
        {
          "type": "text",
          "id": "wheel_model",
          "label": "Wheel model"
        },
        {
          "type": "text",
          "id": "wheel_series",
          "label": "Wheel series"
        },
        {
          "type": "text",
          "id": "front_wheel_size",
          "label": "Front wheel size"
        },
        {
          "type": "text",
          "id": "overall_finish",
          "label": "Overall finish"
        },
        {
          "type": "url",
          "id": "product_url",
          "label": "Product URL"
        },
        {
          "type": "text",
          "id": "gallery_handle",
          "label": "Gallery Build metaobject handle"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Slide image 2"
        },
        {
          "type": "image_picker",
          "id": "image_3",
          "label": "Slide image 3"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "construction",
          "label": "Construction"
        },
        {
          "type": "text",
          "id": "bolt_pattern",
          "label": "Bolt pattern"
        },
        {
          "type": "text",
          "id": "weight",
          "label": "Weight"
        },
        {
          "type": "text",
          "id": "load_rating",
          "label": "Load rating"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Calder Gallery Detail",
      "settings": {}
    }
  ]
}
{% endschema %}
