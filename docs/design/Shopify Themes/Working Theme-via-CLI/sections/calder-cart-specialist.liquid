{% comment %}Calder Wheels | Theme Editor controlled cart specialist banner{% endcomment %}
{% if section.settings.show_banner %}
<section class="calder-cart-specialist-section" {{ section.shopify_attributes }}>
  <div class="calder-cart-specialist-inner">
    <div class="calder-cart-specialist-banner{% if section.settings.background_image != blank %} has-image{% endif %}"
      {% if section.settings.background_image != blank %}style="--calder-specialist-image: url('{{ section.settings.background_image | image_url: width: 2000 }}');"{% endif %}>
      <div class="calder-cart-specialist-banner__copy">
        {% if section.settings.eyebrow != blank %}<p class="calder-cart-specialist-banner__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
        {% if section.settings.description != blank %}<p class="calder-cart-specialist-banner__description">{{ section.settings.description | escape }}</p>{% endif %}
      </div>
      {% if section.settings.button_label != blank %}<a class="calder-cart-specialist-banner__button" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}
    </div>
  </div>
</section>
{% endif %}
<style>
.calder-site.template-cart .calder-cart-specialist-section{background:var(--calder-white);padding:0 1rem 4rem}
.calder-site.template-cart .calder-cart-specialist-inner{max-width:var(--calder-container);margin:auto}
.calder-site.template-cart .calder-cart-specialist-banner{position:relative;isolation:isolate;overflow:hidden;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:36px;min-height:250px;padding:30px 36px 30px clamp(36px,33%,395px);background:var(--calder-gradient-navy);color:var(--calder-white)}
.calder-site.template-cart .calder-cart-specialist-banner.has-image{background-image:linear-gradient(90deg,rgba(3,26,39,.12) 0%,rgba(3,26,39,.7) 33%,rgba(3,26,39,.97) 70%),var(--calder-specialist-image);background-size:cover;background-position:center center}
.calder-site.template-cart .calder-cart-specialist-banner__copy{min-width:0}
.calder-site.template-cart .calder-cart-specialist-banner__eyebrow{margin:0 0 5px;font:500 11px/1.4 var(--calder-ui-font);letter-spacing:.16em;text-transform:uppercase;color:var(--calder-champagne)}
.calder-site.template-cart .calder-cart-specialist-banner h2{margin:0 0 4px;color:var(--calder-white);font:700 clamp(19px,2vw,24px)/1.2 var(--calder-heading-font);letter-spacing:-.02em;text-transform:uppercase}
.calder-site.template-cart .calder-cart-specialist-banner__description{margin:0;color:var(--calder-white);font:400 13px/1.5 var(--calder-ui-font)}
.calder-site.template-cart .calder-cart-specialist-banner__button{display:inline-flex;justify-content:center;align-items:center;gap:14px;min-width:205px;min-height:44px;padding:10px 22px;border:1px solid var(--calder-gold);border-radius:var(--calder-btn-radius);color:var(--calder-white);background:transparent;font:700 11px/1.2 var(--calder-ui-font);letter-spacing:.17em;text-decoration:none;text-transform:uppercase;white-space:nowrap}
.calder-site.template-cart .calder-cart-specialist-banner__button span{color:var(--calder-champagne);font-size:18px}
.calder-site.template-cart .calder-cart-specialist-banner__button:hover{background:var(--calder-deep-navy);color:var(--calder-white)}
@media(max-width:900px){.calder-site.template-cart .calder-cart-specialist-banner{padding-left:28%;gap:18px}.calder-site.template-cart .calder-cart-specialist-banner__button{min-width:150px}}
@media(max-width:767px){.calder-site.template-cart .calder-cart-specialist-banner{grid-template-columns:1fr;gap:20px;padding:28px 24px;min-height:180px}.calder-site.template-cart .calder-cart-specialist-banner.has-image{background-image:linear-gradient(90deg,rgba(3,26,39,.82),rgba(3,26,39,.85)),var(--calder-specialist-image)}.calder-site.template-cart .calder-cart-specialist-banner__button{justify-self:start}}
</style>
{% schema %}
{
 "name":"Calder wheel specialist",
 "settings":[
  {"type":"checkbox","id":"show_banner","label":"Show specialist banner","default":true},
  {"type":"image_picker","id":"background_image","label":"Banner background image"},
  {"type":"text","id":"eyebrow","label":"Eyebrow","default":"QUESTIONS ABOUT YOUR SETUP?"},
  {"type":"text","id":"heading","label":"Heading","default":"CONTACT A WHEEL SPECIALIST"},
  {"type":"textarea","id":"description","label":"Description","default":"Get expert advice on fitment, finishes, and configuration."},
  {"type":"text","id":"button_label","label":"Button label","default":"GET IN TOUCH"},
  {"type":"url","id":"button_link","label":"Button link"}
 ],
 "presets":[{"name":"Calder wheel specialist"}]
}
{% endschema %}
