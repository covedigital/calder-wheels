<section
  class="home-newsletter"
  id="home-newsletter-{{ section.id }}"
>
  <!-- Background -->
  <div class="home-newsletter__background" aria-hidden="true">
    {% if section.settings.background_image != blank %}
      {{
        section.settings.background_image
        | image_url: width: 2400
        | image_tag:
          widths: '768, 1200, 1600, 1920, 2400',
          loading: 'lazy',
          class: 'home-newsletter__background-image',
          alt: ''
      }}
    {% endif %}
  </div>

  <div class="home-newsletter__overlay" aria-hidden="true"></div>

  <div class="home-newsletter__container">

    <!-- =========================================================
         TOP ROW — NEWSLETTER CONTENT + FORM
         ========================================================= -->
    <div class="home-newsletter__top">

      <div class="home-newsletter__content">

        {% if section.settings.eyebrow != blank %}
          <div class="home-newsletter__eyebrow">
            {{ section.settings.eyebrow }}
          </div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="home-newsletter__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.body_text != blank %}
          <div class="home-newsletter__description">
            {{ section.settings.body_text }}
          </div>
        {% endif %}

      </div>

      <div class="home-newsletter__form-wrapper">

        {% form 'customer', class: 'home-newsletter__form' %}

          <input
            type="hidden"
            name="contact[tags]"
            value="newsletter"
          >

          <label
            class="visually-hidden"
            for="NewsletterEmail-{{ section.id }}"
          >
            Email address
          </label>

          <input
            id="NewsletterEmail-{{ section.id }}"
            type="email"
            name="contact[email]"
            class="home-newsletter__input"
            value="{% if customer %}{{ customer.email }}{% endif %}"
            placeholder="{{ section.settings.placeholder | escape }}"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            required
          >

          <button
            type="submit"
            class="home-newsletter__submit"
            name="commit"
          >
            <span>{{ section.settings.button_text }}</span>

            <span
              class="home-newsletter__submit-arrow"
              aria-hidden="true"
            >
              →
            </span>
          </button>

          {% if form.posted_successfully? %}
            <p class="home-newsletter__message home-newsletter__message--success">
              Thanks for subscribing.
            </p>
          {% endif %}

          {% if form.errors %}
            <div class="home-newsletter__message home-newsletter__message--error">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

        {% endform %}

      </div>

    </div>

    <!-- =========================================================
         BOTTOM ROW — NEWSLETTER BENEFITS
         ========================================================= -->
    {% if section.blocks.size > 0 %}
      <div class="home-newsletter__benefits">

        {% for block in section.blocks %}
          <div
            class="home-newsletter__benefit"
            {{ block.shopify_attributes }}
          >

            <div class="home-newsletter__benefit-icon">

              {% if block.settings.icon != blank %}
                {{
                  block.settings.icon
                  | image_url: width: 96
                  | image_tag:
                    widths: '48, 72, 96',
                    loading: 'lazy',
                    alt: '',
                    class: 'home-newsletter__benefit-icon-image'
                }}
              {% else %}

                {% case forloop.index %}

                  {% when 1 %}
                    <!-- Diamond -->
                    <svg viewBox="0 0 32 32" aria-hidden="true">
                      <path d="M6 8h20l4 6-14 14L2 14l4-6Z"/>
                      <path d="m2 14 28 0M10 8l-3 6 9 14 9-14-3-6M7 14l3-6m15 6-3-6"/>
                    </svg>

                  {% when 2 %}
                    <!-- Target -->
                    <svg viewBox="0 0 32 32" aria-hidden="true">
                      <circle cx="16" cy="16" r="13"/>
                      <circle cx="16" cy="16" r="8"/>
                      <circle cx="16" cy="16" r="3"/>
                    </svg>

                  {% when 3 %}
                    <!-- Calendar -->
                    <svg viewBox="0 0 32 32" aria-hidden="true">
                      <rect x="5" y="7" width="22" height="21" rx="2"/>
                      <path d="M10 4v6M22 4v6M5 13h22"/>
                      <rect x="10" y="17" width="4" height="4"/>
                      <rect x="18" y="17" width="4" height="4"/>
                    </svg>

                  {% else %}
                    <!-- Location -->
                    <svg viewBox="0 0 32 32" aria-hidden="true">
                      <path d="M16 29s10-9 10-17A10 10 0 0 0 6 12c0 8 10 17 10 17Z"/>
                      <circle cx="16" cy="12" r="3.5"/>
                    </svg>

                {% endcase %}

              {% endif %}

            </div>

            <div class="home-newsletter__benefit-title">
              {{ block.settings.title }}
            </div>

          </div>
        {% endfor %}

      </div>
    {% endif %}

  </div>
</section>

<style>
  /* ============================================================
     CALDER HOME NEWSLETTER
     Approved mockup implementation
     ============================================================ */

  #home-newsletter-{{ section.id }} {
    --newsletter-container: 1440px;
    --newsletter-gutter: clamp(24px, 5vw, 80px);
    --newsletter-gold: #c79b70;
    --newsletter-white: #ffffff;
    --newsletter-border: rgba(255, 255, 255, 0.13);

    position: relative;
    width: 100%;
    min-height: 270px;
    overflow: hidden;
    background: #061c29;
    color: var(--newsletter-white);
  }


  /* ------------------------------------------------------------
     BACKGROUND
     ------------------------------------------------------------ */

  #home-newsletter-{{ section.id }} .home-newsletter__background,
  #home-newsletter-{{ section.id }} .home-newsletter__overlay {
    position: absolute;
    inset: 0;
  }

  #home-newsletter-{{ section.id }} .home-newsletter__background {
    z-index: 0;
  }

  #home-newsletter-{{ section.id }} .home-newsletter__background-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 52%;
  }

  #home-newsletter-{{ section.id }} .home-newsletter__overlay {
    z-index: 1;

    /*
      Strong blue/black overlay is intentional.
      The approved design treats the scenic image as atmosphere,
      not as the primary visual element.
    */
    background:
      linear-gradient(
        90deg,
        rgba(3, 20, 31, 0.78) 0%,
        rgba(3, 20, 31, 0.65) 48%,
        rgba(3, 20, 31, 0.68) 100%
      );
  }


  /* ------------------------------------------------------------
     CONTAINER
     ------------------------------------------------------------ */

  #home-newsletter-{{ section.id }} .home-newsletter__container {
    position: relative;
    z-index: 2;

    width: min(
      calc(100% - (var(--newsletter-gutter) * 2)),
      var(--newsletter-container)
    );

    margin-inline: auto;
  }


  /* ------------------------------------------------------------
     TOP NEWSLETTER ROW
     ------------------------------------------------------------ */

  #home-newsletter-{{ section.id }} .home-newsletter__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(480px, 0.85fr);
    align-items: center;
    column-gap: clamp(48px, 7vw, 120px);

    min-height: 195px;
    padding: 42px 0 34px;
  }


  /* ------------------------------------------------------------
     COPY
     ------------------------------------------------------------ */

  #home-newsletter-{{ section.id }} .home-newsletter__content {
    max-width: 680px;
  }

  #home-newsletter-{{ section.id }} .home-newsletter__eyebrow {
    margin: 0 0 10px;

    color: var(--newsletter-gold);

    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;

    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  #home-newsletter-{{ section.id }} .home-newsletter__heading {
    margin: 0 0 8px;

    color: #ffffff;

    font-size: clamp(26px, 2.2vw, 36px);
    font-weight: 600;
    line-height: 1.05;

    letter-spacing: 0.015em;
    text-transform: uppercase;
  }

  #home-newsletter-{{ section.id }} .home-newsletter__description {
    margin: 0;

    color: rgba(255, 255, 255, 0.88);

    font-size: 15px;
    font-weight: 400;
    line-height: 1.5;
  }


  /* ------------------------------------------------------------
     FORM
     ------------------------------------------------------------ */

  #home-newsletter-{{ section.id }} .home-newsletter__form-wrapper {
    width: 100%;
  }

  #home-newsletter-{{ section.id }} .home-newsletter__form {
    position: relative;

    display: grid;
    grid-template-columns: minmax(0, 1fr) 205px;
    gap: 14px;

    width: 100%;
  }

  #home-newsletter-{{ section.id }} .home-newsletter__input {
    width: 100%;
    height: 58px;

    padding: 0 20px;

    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 0;

    background: #ffffff;
    color: #15222a;

    font: inherit;
    font-size: 14px;

    outline: none;

    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  #home-newsletter-{{ section.id }} .home-newsletter__input::placeholder {
    color: #7d858c;
    opacity: 1;
  }

  #home-newsletter-{{ section.id }} .home-newsletter__input:focus {
    border-color: var(--newsletter-gold);
    box-shadow: 0 0 0 1px var(--newsletter-gold);
  }

  #home-newsletter-{{ section.id }} .home-newsletter__submit {
    display: flex;
    align-items: center;
    justify-content: space-between;

    width: 100%;
    height: 58px;

    padding: 0 24px;

    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 0;

    background: rgba(173, 128, 91, 0.92);
    color: #ffffff;

    font: inherit;
    font-size: 12px;
    font-weight: 700;

    letter-spacing: 0.13em;
    text-transform: uppercase;

    cursor: pointer;

    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  #home-newsletter-{{ section.id }} .home-newsletter__submit:hover {
    background: #bd8e67;
    border-color: #bd8e67;
  }

  #home-newsletter-{{ section.id }} .home-newsletter__submit-arrow {
    margin-left: 18px;

    font-size: 17px;
    font-weight: 400;
    line-height: 1;

    transform: translateY(-1px);
  }


  /* ------------------------------------------------------------
     FORM MESSAGES
     ------------------------------------------------------------ */

  #home-newsletter-{{ section.id }} .home-newsletter__message {
    grid-column: 1 / -1;

    margin: 8px 0 0;

    font-size: 13px;
    line-height: 1.4;
  }

  #home-newsletter-{{ section.id }} .home-newsletter__message--success {
    color: #ffffff;
  }

  #home-newsletter-{{ section.id }} .home-newsletter__message--error {
    color: #f3c5c5;
  }


  /* ------------------------------------------------------------
     BENEFIT ROW
     ------------------------------------------------------------ */

  #home-newsletter-{{ section.id }} .home-newsletter__benefits {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));

    min-height: 74px;

    border-top: 1px solid var(--newsletter-border);
  }

  #home-newsletter-{{ section.id }} .home-newsletter__benefit {
    display: flex;
    align-items: center;

    gap: 18px;

    padding: 18px 0;
  }

  #home-newsletter-{{ section.id }} .home-newsletter__benefit:not(:first-child) {
    padding-left: clamp(24px, 3vw, 48px);
  }

  #home-newsletter-{{ section.id }} .home-newsletter__benefit-icon {
    display: flex;
    align-items: center;
    justify-content: center;

    flex: 0 0 32px;

    width: 32px;
    height: 32px;

    color: #ffffff;
  }

  #home-newsletter-{{ section.id }} .home-newsletter__benefit-icon svg {
    display: block;

    width: 30px;
    height: 30px;

    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #home-newsletter-{{ section.id }} .home-newsletter__benefit-icon-image {
    display: block;

    width: 30px;
    height: 30px;

    object-fit: contain;
  }

  #home-newsletter-{{ section.id }} .home-newsletter__benefit-title {
    color: rgba(255, 255, 255, 0.94);

    font-size: 11px;
    font-weight: 700;
    line-height: 1.2;

    letter-spacing: 0.17em;
    text-transform: uppercase;

    white-space: nowrap;
  }


  /* ------------------------------------------------------------
     TABLET
     ------------------------------------------------------------ */

  @media screen and (max-width: 1100px) {

    #home-newsletter-{{ section.id }} .home-newsletter__top {
      grid-template-columns: minmax(0, 0.9fr) minmax(420px, 1fr);
      column-gap: 40px;
    }

    #home-newsletter-{{ section.id }} .home-newsletter__form {
      grid-template-columns: minmax(0, 1fr) 170px;
    }

    #home-newsletter-{{ section.id }} .home-newsletter__benefit {
      gap: 12px;
    }

    #home-newsletter-{{ section.id }} .home-newsletter__benefit:not(:first-child) {
      padding-left: 16px;
    }

    #home-newsletter-{{ section.id }} .home-newsletter__benefit-title {
      font-size: 10px;
      letter-spacing: 0.12em;
    }

  }


  /* ------------------------------------------------------------
     SMALL TABLET
     ------------------------------------------------------------ */

  @media screen and (max-width: 900px) {

    #home-newsletter-{{ section.id }} .home-newsletter__top {
      grid-template-columns: 1fr;

      gap: 28px;

      padding: 44px 0 36px;
    }

    #home-newsletter-{{ section.id }} .home-newsletter__content {
      max-width: 620px;
    }

    #home-newsletter-{{ section.id }} .home-newsletter__form {
      max-width: 680px;
    }

    #home-newsletter-{{ section.id }} .home-newsletter__benefits {
      grid-template-columns: repeat(2, 1fr);

      padding: 8px 0;
    }

    #home-newsletter-{{ section.id }} .home-newsletter__benefit,
    #home-newsletter-{{ section.id }} .home-newsletter__benefit:not(:first-child) {
      padding: 15px 0;
    }

  }


  /* ------------------------------------------------------------
     MOBILE
     ------------------------------------------------------------ */

  @media screen and (max-width: 600px) {

    #home-newsletter-{{ section.id }} {
      --newsletter-gutter: 20px;
    }

    #home-newsletter-{{ section.id }} .home-newsletter__top {
      padding: 40px 0 32px;
    }

    #home-newsletter-{{ section.id }} .home-newsletter__eyebrow {
      font-size: 10px;
    }

    #home-newsletter-{{ section.id }} .home-newsletter__heading {
      font-size: 27px;
    }

    #home-newsletter-{{ section.id }} .home-newsletter__description {
      font-size: 14px;
    }

    #home-newsletter-{{ section.id }} .home-newsletter__form {
      grid-template-columns: 1fr;

      gap: 10px;
    }

    #home-newsletter-{{ section.id }} .home-newsletter__input,
    #home-newsletter-{{ section.id }} .home-newsletter__submit {
      height: 56px;
    }

    #home-newsletter-{{ section.id }} .home-newsletter__benefits {
      grid-template-columns: 1fr 1fr;

      column-gap: 18px;
    }

    #home-newsletter-{{ section.id }} .home-newsletter__benefit-title {
      white-space: normal;
    }

  }


  @media screen and (max-width: 420px) {

    #home-newsletter-{{ section.id }} .home-newsletter__benefits {
      grid-template-columns: 1fr;
    }

    #home-newsletter-{{ section.id }} .home-newsletter__benefit {
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    #home-newsletter-{{ section.id }} .home-newsletter__benefit:last-child {
      border-bottom: 0;
    }

  }
</style>

{% schema %}
{
  "name": "Home Newsletter",
  "tag": "section",
  "class": "section--home-newsletter",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "STAY IN THE LOOP"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "JOIN THE CALDER NEWSLETTER"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text",
      "default": "Be the first to know about new releases, exclusive builds, and more."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SUBSCRIBE"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Newsletter Benefit",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Custom icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "NEW RELEASES"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Newsletter",
      "category": "Home",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "title": "NEW RELEASES"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "EXCLUSIVE BUILDS"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "EVENTS & PARTNERSHIPS"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "SPECIAL OFFERS"
          }
        }
      ]
    }
  ]
}
{% endschema %}