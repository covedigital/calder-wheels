{{ 'build-your-wheel.css' | asset_url | stylesheet_tag }}
{{ 'wheel-configurator.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_id = section.id

  assign collection_handle = section.settings.collection
  assign wheel_collection = collections[collection_handle]
  assign default_product_handle = section.settings.default_product
  assign default_product = all_products[default_product_handle]

  assign seed_product = default_product
  unless seed_product
    if wheel_collection != blank and wheel_collection.products.size > 0
      assign seed_product = wheel_collection.products.first
    endif
  endunless

  assign hero_bg = section.settings.hero_bg
  assign hero_bg_mobile = section.settings.hero_bg_mobile | default: hero_bg
  assign hero_overlay = section.settings.hero_overlay_opacity | default: 0.65
  assign hero_eyebrow = section.settings.hero_eyebrow | default: 'CUSTOMIZE YOUR LOOK'
  assign hero_heading = section.settings.hero_heading | default: 'Build Your Wheel'
  assign hero_text = section.settings.hero_text | default: "Design a wheel that's uniquely yours. Choose your finishes, preview in real time, and order a wheel built to your style."
  assign hero_cta = section.settings.hero_cta | default: 'Start Building'

  assign config_heading = section.settings.config_heading | default: 'Build Your Wheel'
  assign config_subtitle = section.settings.config_subtitle | default: 'Select finishes to preview and order a wheel built to your style.'
  assign config_eyebrow = section.settings.config_eyebrow | default: 'CUSTOMIZE YOUR LOOK'

  assign benefits_eyebrow = section.settings.benefits_eyebrow | default: 'WHY CUSTOMIZE'
  assign benefits_heading = section.settings.benefits_heading | default: 'A Wheel Built Around You'
  assign benefits_text = section.settings.benefits_text | default: 'Complete control over finishes, fitment and style. No compromises.'

  assign fitment_bg = section.settings.fitment_bg
  assign fitment_bg_mobile = section.settings.fitment_bg_mobile | default: fitment_bg
  assign fitment_eyebrow = section.settings.fitment_eyebrow | default: 'FIND YOUR FIT'
  assign fitment_heading = section.settings.fitment_heading | default: 'Check Vehicle Fitment'
  assign fitment_text = section.settings.fitment_text | default: 'Make sure your custom configuration fits your vehicle before adding to cart.'
  assign fitment_btn = section.settings.fitment_btn | default: 'SEARCH VEHICLE FITMENT'
  assign fitment_url = section.settings.fitment_url | default: '/pages/fitment-finder'

  assign popular_heading = section.settings.popular_heading | default: 'Popular Configurations'
  assign popular_subtitle = section.settings.popular_subtitle | default: 'Explore some of the most popular finish combinations.'

  assign specialist_bg = section.settings.specialist_bg
  assign specialist_bg_mobile = section.settings.specialist_bg_mobile | default: specialist_bg
  assign specialist_eyebrow = section.settings.specialist_eyebrow | default: 'NEED HELP?'
  assign specialist_heading = section.settings.specialist_heading | default: 'Talk to a Wheel Specialist'
  assign specialist_text = section.settings.specialist_text | default: 'Get expert advice on finishes, fitment, and custom options.'
  assign specialist_quote_text = section.settings.specialist_quote_text | default: 'REQUEST A QUOTE'
  assign specialist_dealer_text = section.settings.specialist_dealer_text | default: 'FIND A DEALER'
  assign specialist_dealer_url = section.settings.specialist_dealer_url | default: '/pages/dealer-portal'

  assign show_360 = section.settings.show_360 | default: false
  assign lead_time_text = section.settings.lead_time_text | default: 'Ships in 5\u201310 business days'

  assign no_products_message = section.settings.no_products_message | default: 'No wheel designs are currently available for configuration.'
-%}

{% render 'calder-configuration-catalog', wheel_collection: wheel_collection %}
{% if seed_product %}
  {% render 'configurator-data', product: seed_product, section_id: section_id %}
{% endif %}

{% if wheel_collection != blank and wheel_collection.products.size > 0 %}
  <script id="byw-product-map-{{ section_id }}">
  window._bywProductData = window._bywProductData || {};
  window._calderProductData = window._calderProductData || {};
  </script>
  {% for product in wheel_collection.products limit: 20 %}
    <script id="byw-product-{{ product.id }}-{{ section_id }}">
    window._bywProductData['{{ product.id }}'] = {% render 'configurator-product-data', product: product %};
    window._calderProductData['{{ product.id }}'] = window._bywProductData['{{ product.id }}'];
    </script>
  {% endfor %}
{% endif %}

<div class="calder-builder-page">

  <!-- ============================================================
       SECTION 1 — BUILD YOUR WHEEL HERO
       ============================================================ -->

  <section class="cbp-hero" id="cbp-hero-{{ section_id }}">
    <div class="cbp-hero__bg" style="{% if hero_bg != blank %}background-image: url('{{ hero_bg | image_url: width: 2400 }}');{% endif %}">
      <div class="cbp-hero__overlay" style="opacity: {{ hero_overlay }};"></div>
    </div>
    <div class="cbp-hero__body container">
      <div class="cbp-hero__inner">
        <div class="cbp-hero__eyebrow">{{ hero_eyebrow }}</div>
        <h1 class="cbp-hero__heading">{{ hero_heading }}</h1>
        <p class="cbp-hero__text">{{ hero_text }}</p>
        <div class="cbp-hero__benefits">
          <div class="cbp-hero__benefit">
            <div class="cbp-hero__benefit-icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 15v-3M12 8.5v.5M7.8 21L12 18l4.2 3V3.5a1 1 0 0 0-.5-.9L12.7 1.2a1 1 0 0 0-1.4 0L7.3 2.6a1 1 0 0 0-.5.9V21z"/></svg></div>
            <div class="cbp-hero__benefit-label"><strong>Premium</strong> Craftsmanship</div>
          </div>
          <div class="cbp-hero__benefit-divider"></div>
          <div class="cbp-hero__benefit">
            <div class="cbp-hero__benefit-icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg></div>
            <div class="cbp-hero__benefit-label"><strong>Fully</strong> Customizable</div>
          </div>
          <div class="cbp-hero__benefit-divider"></div>
          <div class="cbp-hero__benefit">
            <div class="cbp-hero__benefit-icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg></div>
            <div class="cbp-hero__benefit-label"><strong>Made</strong> to Order</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION 2 — MAIN WHEEL CONFIGURATOR
       ============================================================ -->

  <section class="cbp-config" id="cbp-config-{{ section_id }}">

    {% if wheel_collection != blank and wheel_collection.products.size > 0 %}
    <div class="cbp-config__card container">

      <!-- Configurator Header -->
      <div class="cbp-config__header">
        <div class="cbp-config__eyebrow">{{ config_eyebrow }}</div>
        <h2 class="cbp-config__heading">{{ config_heading }}</h2>
        <p class="cbp-config__subtitle">{{ config_subtitle }}</p>
      </div>

      <!-- Wheel Design Selector -->
      <div class="cbp-config__designs" id="cbp-designs-{{ section_id }}">
        <label class="cbp-config__designs-label">Select Wheel Design</label>
        <div class="cbp-config__design-row" id="cbp-design-row-{{ section_id }}">
          {% for product in wheel_collection.products limit: 20 %}
            <button type="button"
              class="cbp-config__design-chip"
              data-byw-design
              data-product-id="{{ product.id }}"
              data-product-handle="{{ product.handle }}"
              data-product-title="{{ product.title | escape }}">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" loading="lazy" width="60" height="60">
              {% endif %}
              <span>{{ product.title }}</span>
            </button>
          {% endfor %}
        </div>
      </div>

      <!-- Three-Column Configurator -->
      <div class="cbp-config__layout">

        <!-- COLUMN 1 — WHEEL PREVIEW -->
        <div class="cbp-config__col cbp-config__col--preview">
          <div class="wheel-configurator wheel-configurator--calder"
               id="wheel-configurator-{{ section_id }}"
               data-product-id="{% if seed_product %}{{ seed_product.id }}{% endif %}"
               data-product-handle="{% if seed_product %}{{ seed_product.handle }}{% endif %}"
               data-section-id="{{ section_id }}">
            <div class="wheel-configurator__inner">
              <div class="wheel-configurator__visual">
                <div class="wheel-configurator__preview">
                  <div class="wheel-configurator__canvas" id="configurator-canvas-{{ section_id }}">
                    <div class="wheel-configurator__preview-loading">
                      <div class="loading-overlay__spinner" style="display:block;width:48px;height:48px;margin:0 auto;"><div data-load="loading"></div></div>
                      <p>Loading preview...</p>
                    </div>
                    <div class="wheel-configurator__preview-layers" style="display:none;">
                      <img class="wheel-configurator__layer wheel-configurator__layer--barrel" src="" alt="" data-layer="barrel">
                      <img class="wheel-configurator__layer wheel-configurator__layer--center" src="" alt="" data-layer="center">
                      <img class="wheel-configurator__layer wheel-configurator__layer--hardware" src="" alt="" data-layer="hardware">
                    </div>
                  </div>
                  <div class="cbp-config__preview-actions">
                    {% if show_360 %}
                    <button type="button" class="cbp-config__preview-action" id="configurator-360-{{ section_id }}">
                      <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="10" cy="10" r="8"/><path d="M14 10a4 4 0 1 1-4-4"/><path d="M14 3v4h-4"/></svg>
                      <span>360&deg; View</span>
                    </button>
                    {% endif %}
                    <button type="button" class="cbp-config__preview-action" id="configurator-zoom-{{ section_id }}">
                      <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="9" cy="9" r="5.5"/><path d="M16 16l-3.5-3.5M7 9h4M9 7v4"/></svg>
                      <span>Zoom</span>
                    </button>
                  </div>
                  <div class="wheel-configurator__actions" style="display:none;"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- COLUMN 2 — FINISH CONTROLS -->
        <div class="cbp-config__col cbp-config__col--controls">

          <div class="cbp-config__finish-group">
            <div class="cbp-config__finish-heading">
              <span class="cbp-config__badge">1</span>
              <div class="cbp-config__finish-titles">
                <h4 class="cbp-config__finish-label">Diameter</h4>
                <p class="cbp-config__finish-desc">Choose a wheel diameter.</p>
              </div>
            </div>
            <select class="wheel-configurator__diameter-select" id="configurator-diameters-{{ section_id }}" data-component="diameter" aria-label="Diameter">
              <option value="">Select Diameter</option>
            </select>
            <span class="wheel-configurator__stock-badge wheel-configurator__stock-badge--diameter" id="configurator-diameter-stock-{{ section_id }}" data-diameter-stock hidden></span>
          </div>

          <div class="cbp-config__finish-group">
            <div class="cbp-config__finish-heading">
              <span class="cbp-config__badge">2</span>
              <div class="cbp-config__finish-titles">
                <h4 class="cbp-config__finish-label">Center Finish</h4>
                <p class="cbp-config__finish-desc">Choose a finish for the center.</p>
              </div>
            </div>
            <div class="wheel-configurator__options" id="configurator-centers-{{ section_id }}" data-component="center" data-loaded="false">
              <div class="wheel-configurator__loading-options"><div data-load="loading"></div></div>
            </div>
          </div>

          <div class="cbp-config__finish-group">
            <div class="cbp-config__finish-heading">
              <span class="cbp-config__badge">3</span>
              <div class="cbp-config__finish-titles">
                <h4 class="cbp-config__finish-label">Barrel &amp; Lip Finish</h4>
                <p class="cbp-config__finish-desc">Choose a finish for the barrel and lip.</p>
              </div>
            </div>
            <div class="wheel-configurator__options" id="configurator-barrels-{{ section_id }}" data-component="barrel" data-loaded="false">
              <div class="wheel-configurator__loading-options"><div data-load="loading"></div></div>
            </div>
          </div>

          <div class="cbp-config__finish-group">
            <div class="cbp-config__finish-heading">
              <span class="cbp-config__badge">4</span>
              <div class="cbp-config__finish-titles">
                <h4 class="cbp-config__finish-label">Hardware &amp; Rivet Finish</h4>
                <p class="cbp-config__finish-desc">Choose a finish for the hardware and rivets.</p>
              </div>
            </div>
            <div class="wheel-configurator__options" id="configurator-hardwares-{{ section_id }}" data-component="hardware" data-loaded="false">
              <div class="wheel-configurator__loading-options"><div data-load="loading"></div></div>
            </div>
          </div>

          <div class="wheel-configurator__availability" id="configurator-availability-{{ section_id }}" style="display:none;"></div>
        </div>

        <!-- COLUMN 3 — CONFIGURATION SUMMARY -->
        <div class="cbp-config__col cbp-config__col--summary">
          <div class="cbp-config__summary-panel" id="configurator-summary-{{ section_id }}">
            <div class="cbp-config__summary-header">
              <span class="cbp-config__summary-title">YOUR CONFIGURATION</span>
              <button type="button" class="cbp-config__reset-btn" id="configurator-reset-{{ section_id }}">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 3v5h5M14 13V8H9"/><path d="M13.5 7.5A7 7 0 0 0 3.5 4L2 5M2.5 8.5A7 7 0 0 0 12.5 12l1.5-1"/></svg>
                <span>Reset</span>
              </button>
            </div>
            <div class="cbp-config__summary-rows">
              <div class="cbp-config__summary-row">
                <div class="cbp-config__summary-info">
                  <span class="cbp-config__summary-name">Diameter</span>
                  <strong id="configurator-summary-diameter">—</strong>
                </div>
              </div>
              <div class="cbp-config__summary-row">
                <div class="cbp-config__summary-info">
                  <span class="cbp-config__summary-name">Center Finish</span>
                  <strong id="configurator-summary-center">—</strong>
                </div>
              </div>
              <div class="cbp-config__summary-row">
                <div class="cbp-config__summary-info">
                  <span class="cbp-config__summary-name">Barrel &amp; Lip</span>
                  <strong id="configurator-summary-barrel">—</strong>
                </div>
              </div>
              <div class="cbp-config__summary-row">
                <div class="cbp-config__summary-info">
                  <span class="cbp-config__summary-name">Hardware</span>
                  <strong id="configurator-summary-hardware">—</strong>
                </div>
              </div>
            </div>
            <div class="cbp-config__summary-price">
              <span class="cbp-config__price-label">Price per wheel</span>
              <strong id="configurator-summary-price">—</strong>
            </div>
            <button type="button" id="configurator-add-{{ section_id }}" class="cbp-config__add-btn" disabled>
              <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="7" cy="18" r="1.2"/><circle cx="15" cy="18" r="1.2"/><path d="M2 3h2l2 10h8l2-8H4"/></svg>
              <span>Add to Cart</span>
            </button>
            <div class="cbp-config__save-share">
              <button type="button" class="cbp-config__save-btn" id="configurator-save-{{ section_id }}" data-action="save">
                <svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 17H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v7a2 2 0 0 1-2 2zM13 17v-4H7v4M7 1v4"/></svg>
                <span>Save Build</span>
              </button>
              <button type="button" class="cbp-config__share-btn" id="configurator-share-{{ section_id }}" data-action="share">
                <svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="6" cy="10" r="2.5"/><circle cx="14" cy="4" r="2.5"/><circle cx="14" cy="16" r="2.5"/><path d="M8.5 11.5l5 2M8.5 8.5l5-2"/></svg>
                <span>Share Build</span>
              </button>
            </div>
            <div class="cbp-config__bto-notice">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
              <div>
                <strong>Built to Order</strong>
                <span>{{ lead_time_text }}</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
    {% else %}
    <div class="cbp-config__empty container">
      <p>{{ no_products_message }}</p>
    </div>
    {% endif %}
  </section>

  <!-- ============================================================
       SECTION 3 — WHY CUSTOMIZE
       ============================================================ -->

  <section class="cbp-benefits" id="cbp-benefits-{{ section_id }}">
    <div class="container">
      <div class="cbp-benefits__header">
        <div class="cbp-benefits__eyebrow">{{ benefits_eyebrow }}</div>
        <h2 class="cbp-benefits__heading">{{ benefits_heading }}</h2>
        {% if benefits_text != blank %}
        <p class="cbp-benefits__text">{{ benefits_text }}</p>
        {% endif %}
      </div>
      <div class="cbp-benefits__grid">
        <div class="cbp-benefits__card">
          <div class="cbp-benefits__icon"><svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg></div>
          <h3 class="cbp-benefits__card-title">Unique to You</h3>
          <p class="cbp-benefits__card-text">Create a one-of-a-kind wheel that matches your style.</p>
        </div>
        <div class="cbp-benefits__card">
          <div class="cbp-benefits__icon"><svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="8" r="5"/><path d="M4 22v-4a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4v4"/></svg></div>
          <h3 class="cbp-benefits__card-title">Premium Finishes</h3>
          <p class="cbp-benefits__card-text">High-quality finishes built to last.</p>
        </div>
        <div class="cbp-benefits__card">
          <div class="cbp-benefits__icon"><svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg></div>
          <h3 class="cbp-benefits__card-title">Real-Time Preview</h3>
          <p class="cbp-benefits__card-text">See your configuration instantly as you build.</p>
        </div>
        <div class="cbp-benefits__card">
          <div class="cbp-benefits__icon"><svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M9 12l2 2 4-4"/><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
          <h3 class="cbp-benefits__card-title">Made to Order</h3>
          <p class="cbp-benefits__card-text">Built with precision and attention to detail.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION 4 — CHECK VEHICLE FITMENT
       ============================================================ -->

  <section class="cbp-fitment" id="cbp-fitment-{{ section_id }}" style="{% if fitment_bg != blank %}background-image: url('{{ fitment_bg | image_url: width: 2400 }}');{% endif %}">
    <div class="cbp-fitment__overlay" style="opacity: 0.7;"></div>
    <div class="container cbp-fitment__body">
      <div class="cbp-fitment__content">
        <div class="cbp-fitment__eyebrow">{{ fitment_eyebrow }}</div>
        <h2 class="cbp-fitment__heading">{{ fitment_heading }}</h2>
        <p class="cbp-fitment__text">{{ fitment_text }}</p>
        <a href="{{ fitment_url }}" class="cbp-fitment__btn">{{ fitment_btn }} &rarr;</a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION 5 — POPULAR CONFIGURATIONS
       ============================================================ -->

  <section class="cbp-popular" id="cbp-popular-{{ section_id }}">
    <div class="container">
      <div class="cbp-popular__header">
        <div class="cbp-popular__eyebrow">GET INSPIRED</div>
        <h2 class="cbp-popular__heading">{{ popular_heading }}</h2>
        {% if popular_subtitle != blank %}
        <p class="cbp-popular__subtitle">{{ popular_subtitle }}</p>
        {% endif %}
      </div>

      <div class="cbp-popular__carousel" id="cbp-carousel-{{ section_id }}">
        <button type="button" class="cbp-popular__arrow cbp-popular__arrow--prev" id="cbp-carousel-prev-{{ section_id }}" aria-label="Previous">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 5l-7 7 7 7"/></svg>
        </button>
        <div class="cbp-popular__track" id="cbp-carousel-track-{{ section_id }}">
          {% for block in section.blocks limit: 12 %}
            {%- liquid
              assign pop_image = block.settings.image
              assign pop_title = block.settings.title
              assign pop_center = block.settings.center_finish
              assign pop_barrel = block.settings.barrel_finish
              assign pop_hardware = block.settings.hardware_finish
              assign pop_link = block.settings.link
            -%}
            <div class="cbp-popular__card" {{ block.shopify_attributes }}>
              <div class="cbp-popular__card-img">
                {% if pop_image != blank %}
                  <img src="{{ pop_image | image_url: width: 400 }}" alt="{{ pop_title | escape }}" loading="lazy" width="200" height="200">
                {% else %}
                  <div class="cbp-popular__card-placeholder"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><circle cx="12" cy="12" r="5"/><circle cx="8" cy="12" r="1.5"/><circle cx="16" cy="12" r="1.5"/></svg></div>
                {% endif %}
              </div>
              <h3 class="cbp-popular__card-title">{{ pop_title }}</h3>
              {% if pop_center != blank or pop_barrel != blank or pop_hardware != blank %}
              <div class="cbp-popular__card-specs">
                {% if pop_center != blank %}<span>Center: {{ pop_center }}</span>{% endif %}
                {% if pop_barrel != blank %}<span>Lip: {{ pop_barrel }}</span>{% endif %}
                {% if pop_hardware != blank %}<span>Bolts: {{ pop_hardware }}</span>{% endif %}
              </div>
              {% endif %}
              <a href="{{ pop_link | default: '#' }}" class="cbp-popular__card-cta">View Details</a>
            </div>
          {% else %}
            <div class="cbp-popular__empty"><p>Add popular configurations in the theme editor.</p></div>
          {% endfor %}
        </div>
        <button type="button" class="cbp-popular__arrow cbp-popular__arrow--next" id="cbp-carousel-next-{{ section_id }}" aria-label="Next">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
      <div class="cbp-popular__dots" id="cbp-carousel-dots-{{ section_id }}"></div>
    </div>
  </section>

  <!-- ============================================================
       SECTION 6 — TALK TO A WHEEL SPECIALIST
       ============================================================ -->

  <section class="cbp-specialist" id="cbp-specialist-{{ section_id }}" style="{% if specialist_bg != blank %}background-image: url('{{ specialist_bg | image_url: width: 2400 }}');{% endif %}">
    <div class="cbp-specialist__overlay" style="opacity: 0.7;"></div>
    <div class="container cbp-specialist__body">
      <div class="cbp-specialist__content">
        <div class="cbp-specialist__eyebrow">{{ specialist_eyebrow }}</div>
        <h2 class="cbp-specialist__heading">{{ specialist_heading }}</h2>
        <p class="cbp-specialist__text">{{ specialist_text }}</p>
        <div class="cbp-specialist__actions">
          <a href="#" class="cbp-specialist__btn cbp-specialist__btn--primary" data-calder-quote-open>{{ specialist_quote_text }}</a>
          <a href="{{ specialist_dealer_url }}" class="cbp-specialist__btn cbp-specialist__btn--outline">{{ specialist_dealer_text }}</a>
        </div>
      </div>
    </div>
  </section>

</div>

{% render 'calder-quote-modal', section_id: section_id, product: seed_product %}

<script src="{{ 'calder-demo-inventory.js' | asset_url }}" defer></script>
<script src="{{ 'configurator-api.js' | asset_url }}" defer></script>
<script src="{{ 'configurator-app.js' | asset_url }}" defer></script>
<script src="{{ 'calder-builder-page.js' | asset_url }}" defer></script>

