{% comment %}

  ==============================================================

  PRODUCT DATA



  This is intentionally retained so Calder controls can access

  Shopify variants without maintaining a second hardcoded data

  model.

  ==============================================================

{% endcomment %}



<script

  type="application/json"

  data-calder-product-json="{{ section.id }}"

>

  {{ product.variants | json }}

</script>





<script>

(function() {



  function initCalderProduct(section) {



    if (!section || section.dataset.calderInitialized === 'true') {

      return;

    }



    section.dataset.calderInitialized = 'true';

/* ==========================================================

       QUANTITY

       ========================================================== */



    var qtyInput = section.querySelector('[data-calder-qty-input]');

    var qtyMinus = section.querySelector('[data-calder-qty-minus]');

    var qtyPlus = section.querySelector('[data-calder-qty-plus]');





    function normalizeQuantity() {



      if (!qtyInput) return 1;



      var value = parseInt(qtyInput.value, 10);



      if (isNaN(value) || value < 1) {

        value = 1;

      }



      qtyInput.value = value;



      return value;

    }





    function syncQuantity() {



      var quantity = normalizeQuantity();



      /*

        Native Lumia buy button snippet may create its own

        product-form quantity input. Synchronize any quantity

        field inside this section.

      */



      var formQuantityInputs = section.querySelectorAll(

        'form[action*="/cart/add"] input[name="quantity"], [data-calder-form-quantity]'

      );



      formQuantityInputs.forEach(function(input) {

        input.value = quantity;

      });



    }





    if (qtyMinus && qtyInput) {



      qtyMinus.addEventListener('click', function() {



        var value = normalizeQuantity();



        qtyInput.value = Math.max(1, value - 1);



        syncQuantity();



      });



    }





    if (qtyPlus && qtyInput) {



      qtyPlus.addEventListener('click', function() {



        var value = normalizeQuantity();



        qtyInput.value = value + 1;



        syncQuantity();



      });



    }





    if (qtyInput) {



      qtyInput.addEventListener('change', syncQuantity);

      qtyInput.addEventListener('input', syncQuantity);



      syncQuantity();



    }







    /* ── CALDER FINISH CHIPS (Center, Barrel, Hardware) ── */

    var finishChips = section.querySelectorAll('[data-calder-finish]');

    finishChips.forEach(function(chip) {

      chip.addEventListener('click', function() {

        var group = chip.closest('[data-calder-finishes]');
        var groupChips = group ? group.querySelectorAll('[data-calder-finish]') : finishChips;
        var finishType = chip.dataset.type || 'center';

        groupChips.forEach(function(item) {

          item.classList.remove('is-selected');
          item.setAttribute('aria-pressed', 'false');

        });

        chip.classList.add('is-selected');
        chip.setAttribute('aria-pressed', 'true');

        section.dispatchEvent(
          new CustomEvent('calder:finish-selected', {
            bubbles: true,
            detail: {
              type: finishType,
              value: chip.dataset.value
            }
          })
        );

        if (finishType === 'hardware') {
          var hardwareSelect = section.querySelector('[data-calder-hardware-rivet]');
          var hardwareProperty = section.querySelector('[data-calder-hw-rivet-property]');
          if (hardwareSelect) hardwareSelect.value = chip.dataset.value;
          if (hardwareProperty) hardwareProperty.value = chip.dataset.value;
        }
        /* Dispatch PDP variant change to sync configurator */
        dispatchPdpVariantChange(section);

      });

    });

    /* Show the complete barrel palette alongside Lumia native controls.
       These auxiliary buttons never submit a non-existent native variant. */
    (function () {
      var picker = section.querySelector('variant-radios, variant-selects');
      if (!picker) return;
      var groups = picker.querySelectorAll('.prd-option');
      var barrelRow = null;
      groups.forEach(function (row) { if (/barrel/i.test((row.querySelector('.prd-option-title') || {}).textContent || '')) barrelRow = row; });
      if (!barrelRow) return;
      var target = barrelRow.querySelector('.prd-option-list') || barrelRow.querySelector('.td_d:last-child');
      if (!target || target.querySelector('[data-calder-finishes="barrel"]')) return;
      var wrap = document.createElement('div');
      wrap.className = 'calder-pdp__option-values calder-pdp__cross-product-barrel';
      wrap.setAttribute('data-calder-finishes', 'barrel');
      [['Black', 'Black', {{ 'finish-barrel-bk.png' | asset_url | json }}], ['Chrome', 'Polish', {{ 'finish-barrel-polish.png' | asset_url | json }}]].forEach(function (opt) {
        var chip = document.createElement('button');
        chip.type = 'button'; chip.className = 'calder-pdp__finish-chip';
        chip.dataset.calderFinish = ''; chip.dataset.type = 'barrel'; chip.dataset.value = opt[0];
        chip.setAttribute('aria-pressed', 'false');
        var img = document.createElement('img'); img.src = opt[2]; img.alt = ''; img.width = 30; img.height = 30;
        var swatch = document.createElement('span'); swatch.className = 'calder-pdp__swatch-material'; swatch.appendChild(img);
        var label = document.createElement('span'); label.className = 'calder-pdp__finish-name'; label.textContent = opt[1];
        chip.appendChild(swatch); chip.appendChild(label); wrap.appendChild(chip);
        chip.addEventListener('click', function () {
          wrap.querySelectorAll('button').forEach(function (b) { b.classList.remove('is-selected'); b.setAttribute('aria-pressed', 'false'); });
          chip.classList.add('is-selected'); chip.setAttribute('aria-pressed', 'true');
          dispatchPdpVariantChange(section);
        });
      });
      target.appendChild(wrap);
      var selected = picker.querySelector('input[name*="Barrel"]:checked');
      var nativeBarrel = selected ? selected.value : '';
      var initial = wrap.querySelector('[data-value="' + nativeBarrel + '"]');
      if (initial) { initial.classList.add('is-selected'); initial.setAttribute('aria-pressed', 'true'); }
    })();

    /* ── CALDER DIAMETER PILLS ── */

    var diameterPills = section.querySelectorAll('[data-calder-diameter-option]');

    diameterPills.forEach(function(pill) {
      pill.addEventListener('click', function() {
        var group = pill.closest('[data-calder-diameter]');
        var groupPills = group ? group.querySelectorAll('[data-calder-diameter-option]') : diameterPills;

        groupPills.forEach(function(item) {
          item.classList.remove('is-selected');
          item.setAttribute('aria-pressed', 'false');
        });

        pill.classList.add('is-selected');
        pill.setAttribute('aria-pressed', 'true');

        dispatchPdpVariantChange(section);
      });
    });

    /* ── Read all PDP selections for sync ── */
    function getPdpSelections(section) {
      var selections = {};

      var picker = section.querySelector('variant-selects') || section.querySelector('variant-radios');
      if (picker) {
        var selects = picker.querySelectorAll('select');
        if (selects.length) {
          selects.forEach(function (s) {
            var name = (s.name || '').toLowerCase();
            var val = s.value ? s.value.trim() : '';
            if (!val) return;
            if (name.indexOf('diameter') !== -1) selections.diameter = val;
            else if (name.indexOf('center') !== -1) selections.center = val;
            else if (name.indexOf('barrel') !== -1) selections.barrel = val;
            else {
              if (!selections.diameter) selections.diameter = val;
              else if (!selections.center) selections.center = val;
              else if (!selections.barrel) selections.barrel = val;
            }
          });
        } else {
          var fieldsets = picker.querySelectorAll('fieldset');
          fieldsets.forEach(function (fs) {
            var checked = fs.querySelector('input:checked');
            var val = checked ? (checked.value || '').trim() : '';
            if (!val) return;
            if (!selections.diameter) selections.diameter = val;
            else if (!selections.center) selections.center = val;
            else if (!selections.barrel) selections.barrel = val;
          });
        }
      }

      var diamGroup = section.querySelector('[data-calder-diameter]');
      if (diamGroup) {
        var selectedPill = diamGroup.querySelector('[data-calder-diameter-option].is-selected');
        if (selectedPill) selections.diameter = selectedPill.dataset.value || selectedPill.textContent.trim();
      }

      ['center', 'barrel', 'hardware'].forEach(function (type) {
        if (selections[type]) return;
        var group = section.querySelector('[data-calder-finishes="' + type + '"]');
        if (group) {
          var selectedChip = group.querySelector('[data-calder-finish].is-selected');
          if (selectedChip) selections[type] = selectedChip.dataset.value;
        }
      });

      var barrelOverride = section.querySelector('.calder-pdp__cross-product-barrel .is-selected');
      if (barrelOverride) selections.barrel = barrelOverride.dataset.value;
      var hwRivetSelect = section.querySelector('[data-calder-hardware-rivet]');
      if (hwRivetSelect && hwRivetSelect.value) {
        selections.hardware = hwRivetSelect.value.trim();
      }

      return selections;
    }

    /* ── Dispatch PDP variant change event to configurator ── */
    function dispatchPdpVariantChange(section) {
      try {
        var selections = getPdpSelections(section);
        section.dispatchEvent(new CustomEvent('calder:pdp-variant-change', {
          bubbles: true,
          detail: selections
        }));
      } catch (e) {
        /* Exception-safe: do not crash PDP if configurator listener fails */
      }
    }

    /* PDP auxiliary finishes are a builder invitation, not native Shopify variants.
       Keep the native purchase form only when the current product supports the
       exact diameter/center/barrel and the preset hardware finish. */
    (function () {
      var buy = section.querySelector('.calder-pdp__buy');
      if (!buy) return;
      var form = buy.querySelector('form');
      if (!form) return;
      var customize = document.createElement('button');
      customize.type = 'button';
      customize.className = 'calder-pdp__add-btn calder-pdp__customize-link';
      customize.textContent = 'Customize This Wheel';
      customize.hidden = true;
      buy.appendChild(customize);
      customize.addEventListener('click', function () {
        var builder = document.querySelector('.calder-pdp .wheel-configurator, .calder-pdp .cbp-config, .calder-pdp [id^="wheel-configurator-"], .wheel-configurator, .cbp-config, [id^="cbp-config-"]');
        if (builder) builder.scrollIntoView({behavior:'smooth',block:'start'});
      });
      var handle = {{ product.handle | json }};
      var nativeVariants = {{ product.variants | json }};
      var hardwareSelect = section.querySelector('[data-calder-hardware-rivet]');
      var presetHardware = hardwareSelect ? hardwareSelect.value : '';
      var norm = function (value) { return String(value || '').trim().toLowerCase(); };
      function updateAction() {
        var sel = getPdpSelections(section);
        if (!sel.diameter || !sel.center || !sel.barrel) return;
        var local = nativeVariants.some(function (variant) {
          return variant.available && norm(variant.option1) === norm(sel.diameter) &&
            norm(variant.option2) === norm(sel.center) && norm(variant.option3) === norm(sel.barrel);
        });
        var currentPreset = local && (!presetHardware || norm(sel.hardware) === norm(presetHardware));
        form.hidden = !currentPreset;
        customize.hidden = currentPreset;
      }
      section.addEventListener('calder:pdp-variant-change', updateAction);
      setTimeout(updateAction, 0);
    })();

    /* ── Listen for native variant ID changes and sync to configurator ── */
    var nativeIdInput = section.querySelector('input[name="id"]');
    if (nativeIdInput && window.MutationObserver) {
      var lastPdpVariantId = nativeIdInput.value;
      var pdpVariantObserver = new MutationObserver(function () {
        if (nativeIdInput.value !== lastPdpVariantId) {
          lastPdpVariantId = nativeIdInput.value;
          dispatchPdpVariantChange(section);
        }
      });
      pdpVariantObserver.observe(nativeIdInput, {
        attributes: true,
        attributeFilter: ['value']
      });
    }

    /* ── Sync hardware rivet dropdown to hidden form property ── */
    var hwRivetSelect = section.querySelector('[data-calder-hardware-rivet]');
    var hwRivetInput = section.querySelector('[data-calder-hw-rivet-property]');
    if (hwRivetSelect && hwRivetInput) {
      hwRivetSelect.addEventListener('change', function () {
        hwRivetInput.value = this.value || '';
        dispatchPdpVariantChange(section);
      });
    }







    /* ==========================================================

       FITMENT

       ========================================================== */



    var fitmentPanel = section.querySelector('[data-calder-fitment]');



    if (fitmentPanel) {



      var fitmentAction =

        fitmentPanel.querySelector('[data-calder-fitment-action]');



      var fitmentLabel =

        fitmentPanel.querySelector('[data-calder-fitment-label]');



      var fitmentText =

        fitmentPanel.querySelector('[data-calder-fitment-text]');



      var fitmentVehicle =

        fitmentPanel.querySelector('[data-calder-fitment-vehicle]');



      var fitmentActionText =

        fitmentPanel.querySelector('[data-calder-fitment-action-text]');





      function renderVehicle(vehicle) {



        if (

          !vehicle ||

          !vehicle.year ||

          !vehicle.make

        ) {

          return;

        }



        var vehicleString = vehicle.display_name || [

          vehicle.year,

          vehicle.make,

          vehicle.model,

          (vehicle.trim && vehicle.trim !== vehicle.display_name) ? vehicle.trim : ''

        ]

        .filter(Boolean)

        .join(' ');





        fitmentPanel.classList.remove(

          'calder-pdp__fitment--unset'

        );



        fitmentPanel.classList.add(

          'calder-pdp__fitment--confirmed'

        );





        if (fitmentLabel) {

          fitmentLabel.textContent = 'Fits Your Vehicle';

        }



        if (fitmentText) {

          fitmentText.hidden = true;

        }



        if (fitmentVehicle) {



          fitmentVehicle.textContent = vehicleString;

          fitmentVehicle.hidden = false;



        }



        if (fitmentActionText) {

          fitmentActionText.textContent = 'Change Vehicle';

        }



      }





      function clearVehicle() {



        fitmentPanel.classList.add(

          'calder-pdp__fitment--unset'

        );



        fitmentPanel.classList.remove(

          'calder-pdp__fitment--confirmed'

        );





        if (fitmentLabel) {

          fitmentLabel.textContent =

            {{ section.settings.fitment_unset_heading | json }};

        }



        if (fitmentText) {



          fitmentText.textContent =

            {{ section.settings.text_no_vehicle | json }};



          fitmentText.hidden = false;



        }



        if (fitmentVehicle) {



          fitmentVehicle.textContent = '';

          fitmentVehicle.hidden = true;



        }



        if (fitmentActionText) {



          fitmentActionText.textContent =

            {{ section.settings.action_text | json }};



        }



      }





      document.addEventListener(

        'calder:vehicle-selected',

        function(event) {



          if (event.detail) {

            renderVehicle(event.detail);

          }



        }

      );





      document.addEventListener(

        'calder:vehicle-cleared',

        clearVehicle

      );





      try {



        var savedVehicle =

          localStorage.getItem('calder_selected_vehicle');



        if (savedVehicle) {



          renderVehicle(

            JSON.parse(savedVehicle)

          );



        }



      } catch (error) {



        console.warn(

          'Calder vehicle state could not be restored.',

          error

        );



      }





      if (fitmentAction) {



        fitmentAction.addEventListener('click', function() {



          document.dispatchEvent(

            new CustomEvent('calder:open-fitment')

          );





          var fitmentFinder =

            document.querySelector(

              '.section--fitment-finder, .fitment-finder'

            );





          if (fitmentFinder) {



            fitmentFinder.scrollIntoView({

              behavior: 'smooth',

              block: 'start'

            });



          }



        });



      }



    }







    /* ==========================================================

       SHARE

       ========================================================== */



    var shareButton =

      section.querySelector('[data-calder-share]');





    if (shareButton) {



      shareButton.addEventListener('click', function() {



        var shareData = {

          title: document.title,

          text: {{ product.title | json }},

          url: window.location.href

        };





        if (navigator.share) {



          navigator.share(shareData).catch(function() {});



          return;



        }





        if (navigator.clipboard) {



          navigator.clipboard

            .writeText(window.location.href)

            .then(function() {



              var label =

                shareButton.querySelector('span');



              if (!label) return;



              var originalText = label.textContent;



              label.textContent = 'Link Copied';



              window.setTimeout(function() {

                label.textContent = originalText;

              }, 1600);



            });



        }



      });



    }







    /* ==========================================================

       NATIVE PRODUCT FORM QUANTITY SYNC



       Lumia controls submission/AJAX. Calder only synchronizes

       the approved-layout quantity control.

       ========================================================== */



    var productForms =

      section.querySelectorAll('form[action*="/cart/add"]');





    productForms.forEach(function(form) {



      form.addEventListener('submit', function() {



        syncQuantity();



      });



    });



  }







  function initCurrentSection() {



    var section =

      document.getElementById(

        'CalderProduct-{{ section.id }}'

      );



    initCalderProduct(section);



  }





  if (document.readyState === 'loading') {



    document.addEventListener(

      'DOMContentLoaded',

      initCurrentSection

    );



  } else {



    initCurrentSection();



  }





  document.addEventListener(

    'shopify:section:load',

    function(event) {



      var section =

        event.target.querySelector(

          '#CalderProduct-{{ section.id }}'

        );



      if (section) {

        initCalderProduct(section);

      }



    }

  );



})();

</script>





