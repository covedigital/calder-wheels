{% comment %}theme-check-disable NestedSnippet{% endcomment %}
{%- liquid
  assign gallery_images = section.settings.gallery_images
  if product.metafields.custom.real_world_gallery.value
    assign gallery_images = product.metafields.custom.real_world_gallery.value
  endif
  unless gallery_images
    assign gallery_images = array
    for i in (1..4)
      assign img_setting = 'gallery_image_' | append: i
      if section.settings[img_setting] != blank
        assign gallery_images = gallery_images | push: section.settings[img_setting]
      endif
    endfor
  endunless
-%}

<div class="calder-gallery-section">
  <div class="container">
    <div class="calder-gallery-section__header">
      <div>
        <h2 class="calder-gallery-section__heading">{{ section.settings.heading | default: 'See It in the Real World' }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="calder-gallery-section__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
      <a href="{{ section.settings.gallery_link | default: '/pages/gallery' }}" class="calder-gallery-section__action">
        {{ section.settings.action_text | default: 'View Gallery' }} &rarr;
      </a>
    </div>
    <div class="calder-gallery-grid">
      {%- if gallery_images -%}
        {%- for image in gallery_images -%}
          <div class="calder-gallery-grid__item">
            {%- if image.src -%}
              <img src="{{ image.src | img_url: '400x' }}" alt="{{ image.alt | default: 'Real world installation' }}" loading="lazy" width="400" height="300">
            {%- elsif image -%}
              <img src="{{ image | img_url: '400x' }}" alt="Real world installation" loading="lazy" width="400" height="300">
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="calder-gallery-grid__item">
            <div style="width:100%;height:100%;background:var(--c-bg-alt);display:flex;align-items:center;justify-content:center;color:var(--c-text-dim);font-size:12px;">Gallery Image {{ i }}</div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Calder Real World Gallery",
  "tag": "section",
  "class": "calder-gallery-wrap",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "See It in the Real World" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "action_text", "label": "Action text", "default": "View Gallery" },
    { "type": "url", "id": "gallery_link", "label": "Gallery link" },
    { "type": "image_picker", "id": "gallery_image_1", "label": "Gallery image 1" },
    { "type": "image_picker", "id": "gallery_image_2", "label": "Gallery image 2" },
    { "type": "image_picker", "id": "gallery_image_3", "label": "Gallery image 3" },
    { "type": "image_picker", "id": "gallery_image_4", "label": "Gallery image 4" },
    { "type": "paragraph", "content": "Gallery images can also be populated from product metafield 'real_world_gallery'." }
  ],
  "presets": [
    { "name": "Calder Real World Gallery", "category": "Calder" }
  ]
}
{% endschema %}