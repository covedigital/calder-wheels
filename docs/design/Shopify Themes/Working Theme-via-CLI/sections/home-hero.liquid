{{ 'home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_image = section.settings.hero_image
  assign hero_video_type = section.settings.hero_video_type | default: 'url'
  assign hero_video_url = section.settings.hero_video_url
  assign hero_video_file = section.settings.hero_video_file
  assign is_youtube = false
  if hero_video_type == 'youtube' and hero_video_url != blank
    assign is_youtube = true
  endif
  assign eyebrow = section.settings.eyebrow | default: 'Precision Engineering'
  assign heading = section.settings.heading | default: 'MADE WITH<br>PRECISION'
  assign body_text = section.settings.body_text | default: 'Forged from the finest materials. Engineered for those who demand performance.'
  assign primary_cta_text = section.settings.primary_cta_text | default: 'Explore Wheels'
  assign primary_cta_url = section.settings.primary_cta_url | default: '/collections/all'
  assign secondary_cta_text = section.settings.secondary_cta_text | default: 'Build Yours'
  assign secondary_cta_url = section.settings.secondary_cta_url | default: '/pages/configurator'
  assign proof_1 = section.settings.proof_1 | default: 'Premium Materials'
  assign proof_2 = section.settings.proof_2 | default: 'Custom Engineered'
  assign proof_3 = section.settings.proof_3 | default: 'Proven Performance'
  assign proof_icon_1 = section.settings.proof_icon_1
  assign proof_icon_2 = section.settings.proof_icon_2
  assign proof_icon_3 = section.settings.proof_icon_3
  assign section_animation_enabled = section.settings.section_animation | default: true
  if settings.animation_sections == false
    assign section_animation_enabled = false
  endif
  if section.settings.section_decoration_top != 'none' or section.settings.section_decoration_bottom != 'none'
    assign section_animation_enabled = false
  endif
-%}

<section class="home-hero{% if section_animation_enabled %} show-on-scroll{% endif %}" id="home-hero-{{ section.id }}">
  <div class="home-hero__media">
    {% if section.settings.hero_media_type == 'video' %}
      {% if is_youtube %}
        <div class="home-hero__video-embed" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;">
          <iframe src="https://www.youtube-nocookie.com/embed/{{ hero_video_url | replace: 'https://www.youtube.com/watch?v=', '' | replace: 'https://youtu.be/', '' | replace: 'https://www.youtube-nocookie.com/embed/', '' | url_encode }}?autoplay=1&loop=1&mute=1&controls=0&playlist={{ hero_video_url | replace: 'https://www.youtube.com/watch?v=', '' | replace: 'https://youtu.be/', '' | replace: 'https://www.youtube-nocookie.com/embed/', '' }}" width="100%" height="100%" style="width:100%;height:100%;object-fit:cover;border:0;" frameborder="0" allow="autoplay;encrypted-media" allowfullscreen></iframe>
        </div>
      {% elsif hero_video_type == 'file' and hero_video_file != blank %}
        <video class="home-hero__video" autoplay muted loop playsinline poster="{{ hero_image | image_url: width: 1920 }}">
          <source src="{{ hero_video_file | image_url: width: 1920 }}" type="video/mp4">
        </video>
      {% elsif hero_video_url != blank %}
        <video class="home-hero__video" autoplay muted loop playsinline poster="{{ hero_image | image_url: width: 1920 }}">
          <source src="{{ hero_video_url }}" type="video/mp4">
        </video>
      {% endif %}
    {% elsif hero_image != blank %}
      <img src="{{ hero_image | image_url: width: 1920 }}" alt="{{ heading | strip_html }}" width="1920" height="1000" loading="eager" fetchpriority="high" style="width:100%;height:100%;object-fit:cover;object-position:60% 50%;">
    {% else %}
      <div style="width:100%;height:100%;background:#0E2A3E;"></div>
    {% endif %}
  </div>
  <div class="home-hero__overlay"></div>
  <div class="home-hero__container">
    <div class="home-hero__content">
      <div class="home-hero__eyebrow">{{ eyebrow }}</div>
      <h1 class="home-hero__heading">{{ heading }}</h1>
      <div class="home-hero__body">{{ body_text }}</div>
      <div class="home-hero__actions">
        <a href="{{ primary_cta_url }}" class="home-hero__btn-primary">
          {{ primary_cta_text }}
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
            <path d="M4 2L8 6L4 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="{{ secondary_cta_url }}" class="home-hero__btn-secondary">
          {{ secondary_cta_text }}
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
            <path d="M4 2L8 6L4 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
      <div class="home-hero__proof-points">
        <span class="home-hero__proof">
          {% if proof_icon_1 != blank %}
            <img class="home-hero__proof-icon home-hero__proof-icon--custom" src="{{ proof_icon_1 | image_url: width: 48 }}" alt="" width="24" height="24" loading="lazy">
          {% else %}
            <svg class="home-hero__proof-icon" viewBox="0 0 14 14" fill="none">
              <path d="M7 1L9 5L13 5.5L10 8.5L10.5 13L7 11L3.5 13L4 8.5L1 5.5L5 5L7 1Z" fill="currentColor"/>
            </svg>
          {% endif %}
          {{ proof_1 }}
        </span>
        <span class="home-hero__proof">
          {% if proof_icon_2 != blank %}
            <img class="home-hero__proof-icon home-hero__proof-icon--custom" src="{{ proof_icon_2 | image_url: width: 48 }}" alt="" width="24" height="24" loading="lazy">
          {% else %}
            <svg class="home-hero__proof-icon" viewBox="0 0 14 14" fill="none">
              <path d="M7 1L9 5L13 5.5L10 8.5L10.5 13L7 11L3.5 13L4 8.5L1 5.5L5 5L7 1Z" fill="currentColor"/>
            </svg>
          {% endif %}
          {{ proof_2 }}
        </span>
        <span class="home-hero__proof">
          {% if proof_icon_3 != blank %}
            <img class="home-hero__proof-icon home-hero__proof-icon--custom" src="{{ proof_icon_3 | image_url: width: 48 }}" alt="" width="24" height="24" loading="lazy">
          {% else %}
            <svg class="home-hero__proof-icon" viewBox="0 0 14 14" fill="none">
              <path d="M7 1L9 5L13 5.5L10 8.5L10.5 13L7 11L3.5 13L4 8.5L1 5.5L5 5L7 1Z" fill="currentColor"/>
            </svg>
          {% endif %}
          {{ proof_3 }}
        </span>
      </div>
    </div>
    {% if section.settings.caption_title != blank %}
    <div class="home-hero__caption-box">
      <div class="home-hero__caption-title">{{ section.settings.caption_title }}</div>
      {% if section.settings.caption_subtitle != blank %}
      <div class="home-hero__caption-subtitle">{{ section.settings.caption_subtitle }}</div>
      {% endif %}
    </div>
    {% endif %}
  </div>
</section>

