{{ 'home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_image = section.settings.hero_image
  assign eyebrow = section.settings.eyebrow | default: 'Precision Engineering'
  assign heading = section.settings.heading | default: 'MADE WITH<br>PRECISION'
  assign body_text = section.settings.body_text | default: 'Forged from the finest materials. Engineered for those who demand performance.'
  assign primary_cta_text = section.settings.primary_cta_text | default: 'Explore Wheels'
  assign primary_cta_url = section.settings.primary_cta_url | default: '/collections/all'
  assign secondary_cta_text = section.settings.secondary_cta_text | default: 'Build Yours'
  assign secondary_cta_url = section.settings.secondary_cta_url | default: '/pages/configurator'
  assign proof_1 = section.settings.proof_1 | default: 'Premium Materials'
  assign proof_2 = section.settings.proof_2 | default: 'Custom Engineered'
  assign proof_3 = section.settings.proof_3 | default: 'Proven Performance'
-%}

<section class="home-hero" id="home-hero-{{ section.id }}">
  <div class="home-hero__media">
    {% if hero_image != blank %}
      <img src="{{ hero_image | image_url: width: 1920 }}" alt="{{ heading | strip_html }}" width="1920" height="1000" loading="eager" fetchpriority="high" style="width:100%;height:100%;object-fit:cover;object-position:60% 50%;">
    {% else %}
      <div style="width:100%;height:100%;background:#0E2A3E;"></div>
    {% endif %}
  </div>
  <div class="home-hero__overlay"></div>
  <div class="home-hero__container">
    <div class="home-hero__content">
      <div class="home-hero__eyebrow">{{ eyebrow }}</div>
      <h1 class="home-hero__heading">{{ heading }}</h1>
      <div class="home-hero__body">{{ body_text }}</div>
      <div class="home-hero__actions">
        <a href="{{ primary_cta_url }}" class="home-hero__btn-primary">
          {{ primary_cta_text }}
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
            <path d="M4 2L8 6L4 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="{{ secondary_cta_url }}" class="home-hero__btn-secondary">
          {{ secondary_cta_text }}
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
            <path d="M4 2L8 6L4 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
      <div class="home-hero__proof-points">
        <span class="home-hero__proof">
          <svg class="home-hero__proof-icon" viewBox="0 0 14 14" fill="none">
            <path d="M7 1L9 5L13 5.5L10 8.5L10.5 13L7 11L3.5 13L4 8.5L1 5.5L5 5L7 1Z" fill="currentColor"/>
          </svg>
          {{ proof_1 }}
        </span>
        <span class="home-hero__proof">
          <svg class="home-hero__proof-icon" viewBox="0 0 14 14" fill="none">
            <path d="M7 1L9 5L13 5.5L10 8.5L10.5 13L7 11L3.5 13L4 8.5L1 5.5L5 5L7 1Z" fill="currentColor"/>
          </svg>
          {{ proof_2 }}
        </span>
        <span class="home-hero__proof">
          <svg class="home-hero__proof-icon" viewBox="0 0 14 14" fill="none">
            <path d="M7 1L9 5L13 5.5L10 8.5L10.5 13L7 11L3.5 13L4 8.5L1 5.5L5 5L7 1Z" fill="currentColor"/>
          </svg>
          {{ proof_3 }}
        </span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home Hero",
  "tag": "section",
  "class": "section section--home-hero",
  "settings": [
    {
      "type": "header",
      "content": "Hero Image"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero background image"
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Hero image (mobile)"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Precision Engineering"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "MADE WITH<br>PRECISION"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text",
      "default": "Forged from the finest materials. Engineered for those who demand performance."
    },
    {
      "type": "header",
      "content": "Primary CTA"
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary CTA text",
      "default": "Explore Wheels"
    },
    {
      "type": "url",
      "id": "primary_cta_url",
      "label": "Primary CTA link"
    },
    {
      "type": "header",
      "content": "Secondary CTA"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary CTA text",
      "default": "Build Yours"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Secondary CTA link"
    },
    {
      "type": "header",
      "content": "Proof Points"
    },
    {
      "type": "text",
      "id": "proof_1",
      "label": "Proof point 1",
      "default": "Premium Materials"
    },
    {
      "type": "text",
      "id": "proof_2",
      "label": "Proof point 2",
      "default": "Custom Engineered"
    },
    {
      "type": "text",
      "id": "proof_3",
      "label": "Proof point 3",
      "default": "Proven Performance"
    }
  ],
  "presets": [
    {
      "name": "Home Hero",
      "category": "Home"
    }
  ]
}
{% endschema %}