    },
    {
      "type": "text",
      "id": "tab_1_label",
      "label": "Tab 1 label",
      "default": "By Vehicle"
    },
    {
      "type": "text",
      "id": "tab_2_label",
      "label": "Tab 2 label",
      "default": "By Wheel Style"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Your FIT"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Select your vehicle to see compatible wheels, real builds, and fitment details."
    },
    {
      "type": "header",
      "content": "Fitment Form — By Vehicle"
    },
    {
      "type": "text",
      "id": "label_year",
      "label": "Year label",
      "default": "YEAR"
    },
    {
      "type": "text",
      "id": "placeholder_year",
      "label": "Year placeholder",
      "default": "Year"
    },
    {
      "type": "text",
      "id": "label_make",
      "label": "Make label",
      "default": "MAKE"
    },
    {
      "type": "text",
      "id": "placeholder_make",
      "label": "Make placeholder",
      "default": "Make"
    },
    {
      "type": "text",
      "id": "label_model",
      "label": "Model label",
      "default": "MODEL"
    },
    {
      "type": "text",
      "id": "placeholder_model",
      "label": "Model placeholder",
      "default": "Model"
    },
    {
      "type": "text",
      "id": "label_trim",
      "label": "Trim label",
      "default": "TRIM"
    },
    {
      "type": "text",
      "id": "placeholder_trim",
      "label": "Trim placeholder",
      "default": "Trim"
    },
    {
      "type": "header",
      "content": "Fitment Form — By Wheel Style"
    },
    {
      "type": "text",
      "id": "placeholder_diameter",
      "label": "Diameter placeholder",
      "default": "All Diameters"
    },
    {
      "type": "text",
      "id": "placeholder_width",
      "label": "Width placeholder",
      "default": "All Widths"
    },
    {
      "type": "text",
      "id": "placeholder_bolt",
      "label": "Bolt Pattern placeholder",
      "default": "All Bolt Patterns"
    },
    {
      "type": "text",
      "id": "placeholder_finish",
      "label": "Finish placeholder",
      "default": "All Finishes"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Find Wheels"
    },
    {
      "type": "header",
      "content": "Fitment Guide"
    },
    {
      "type": "text",
      "id": "guide_button_text",
      "label": "By Vehicle card button text",
      "default": "SEE FITMENT"
    },
    {
      "type": "text",
      "id": "guide_reset_text",
      "label": "By Vehicle card reset text",
      "default": "RESET"
    },
    {
      "type": "header",
      "content": "SECTION GENERAL"
    },
    {
      "type": "checkbox",
      "id": "section_animation",
      "label": "Enable soft appearing of section",
      "default": true,
      "info": "Global sections animation disabling in Theme Settings / General / Sections. AUTODISABLED if section has top or bottom separator."
    },
    {
      "type": "header",
      "content": "SECTION WIDTH"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Select width source",
      "options": [
        {
          "value": "global",
          "label": "Use store width"
