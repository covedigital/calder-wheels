<nav class="collection-category-nav" id="collection-category-nav-{{ section.id }}">
  <div class="collection-category-nav__container">
    <div class="collection-category-nav__tiles">

      {% for block in section.blocks %}
        <a href="{{ block.settings.url | default: '#' }}"
          class="collection-category-nav__tile{% if block.settings.active %} collection-category-nav__tile--active{% endif %}"
          {{ block.shopify_attributes }}>
          <div class="collection-category-nav__tile-bg">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 300 | image_tag: widths: '150, 300', loading: 'lazy', class: 'collection-category-nav__tile-image', alt: block.settings.title }}
            {% endif %}
            <div class="collection-category-nav__tile-overlay"></div>
          </div>
          <div class="collection-category-nav__tile-content">
            <div class="collection-category-nav__tile-icon">
              {% case block.settings.icon %}
                {% when 'grid' %}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
                  </svg>
                {% when 'monoblock' %}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><line x1="12" y1="3" x2="12" y2="7"/><line x1="12" y1="17" x2="12" y2="21"/><line x1="3" y1="12" x2="7" y2="12"/><line x1="17" y1="12" x2="21" y2="12"/>
                  </svg>
                {% when '3piece' %}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/><path d="M12 3a9 9 0 019 9"/>
                  </svg>
                {% when 'car' %}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 17h14M5 17a2 2 0 01-2-2V9l3-4h12l3 4v6a2 2 0 01-2 2M5 17l2 2m12-2l-2 2"/>
                    <circle cx="7" cy="15" r="1.5"/><circle cx="17" cy="15" r="1.5"/>
                  </svg>
                {% when 'sparkles' %}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3l1.5 4.5L18 9l-4.5 1.5L12 15l-1.5-4.5L6 9l4.5-1.5L12 3z"/><path d="M18.5 14.5L19 16l1.5.5-1.5.5-.5 1.5-.5-1.5-1.5-.5 1.5-.5.5-1.5z"/>
                  </svg>
                {% else %}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/>
                  </svg>
              {% endcase %}
            </div>
            <span class="collection-category-nav__tile-label">{{ block.settings.title }}</span>
          </div>
        </a>
      {% endfor %}

    </div>
  </div>
</nav>

{% schema %}
{
  "name": "Collection Category Nav",
  "class": "section--collection-category-nav",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "category",
      "name": "Category Tile",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "All Wheels"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "grid", "label": "Grid (All Wheels)" },
            { "value": "monoblock", "label": "Monoblock" },
            { "value": "3piece", "label": "3-Piece" },
            { "value": "car", "label": "Car (By Vehicle)" },
            { "value": "sparkles", "label": "Sparkles (By Style)" }
          ],
          "default": "grid"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Tile background image"
        },
        {
          "type": "checkbox",
          "id": "active",
          "label": "Active state",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Category Navigation",
      "category": "Collection",
      "blocks": [
        { "type": "category", "settings": { "title": "All Wheels", "icon": "grid", "active": true } },
        { "type": "category", "settings": { "title": "Forged Monoblock", "icon": "monoblock" } },
        { "type": "category", "settings": { "title": "Forged 3-Piece", "icon": "3piece" } },
        { "type": "category", "settings": { "title": "By Vehicle", "icon": "car" } },
        { "type": "category", "settings": { "title": "By Style", "icon": "sparkles" } }
      ]
    }
  ]
}
{% endschema %}