{% comment %}theme-check-disable UnusedAssign{% endcomment %}
{%- liquid
  assign layout = 'calder-wheel-gallery'
  assign store_width = settings.container_max_width
  if section.settings.section_width == 'custom'
    assign store_width = section.settings.container_max_width
  endif
  assign per_page = section.settings.per_page | default: 12
  assign perf_page_int = per_page | plus: 0
  assign builder_url = section.settings.builder_url | default: '/pages/build-your-wheel'
-%}
{{ 'calder-gallery.css' | asset_url | stylesheet_tag }}
{% render 'section-wrapper', placement: 'top' %}
<div class="holder" {% render 'section-style' %}>
  <div class="container">
    <div class="calder-gallery-hero">
      <div class="calder-gallery-hero__eyebrow">Calder Wheels</div>
      <h1 class="calder-gallery-hero__title">{{ section.settings.hero_title | default: 'Wheel Gallery' }}</h1>
      {%- assign subtitle = section.settings.hero_subtitle | default: 'Explore Calder wheel designs, finishes, and configurations. Each wheel can be customized to match your vision.' -%}
      {%- if subtitle != blank -%}
        <div class="calder-gallery-hero__subtitle">{{ subtitle }}</div>
      {%- endif -%}
    </div>
    <nav class="calder-gallery-nav" aria-label="Gallery type">
      <ul class="calder-gallery-nav__list">
        <li class="calder-gallery-nav__item"><a href="/pages/vehicle-gallery" class="calder-gallery-nav__link">Vehicle Gallery</a></li>
        <li class="calder-gallery-nav__item"><a href="/pages/wheel-gallery" class="calder-gallery-nav__link calder-gallery-nav__link--active">Wheel Gallery</a></li>
      </ul>
    </nav>
    {%- liquid
      assign all_builds = shop.metaobjects.gallery_build.values
      assign use_metaobjects = false
      if all_builds.size > 0
        assign use_metaobjects = true
      endif
    -%}
    {%- if use_metaobjects -%}
      {%- liquid
        assign wheel_builds = '' | split: ''
        assign all_wheels = '' | split: ''
        assign all_series = '' | split: ''
        assign all_finishes = '' | split: ''
        for build in all_builds
          assign gtype = build.gallery_type | default: ''
          if gtype == 'wheel'
            assign wheel_builds = wheel_builds | push: build
            assign wheel = build.wheel_model | default: '' | strip
            assign series = build.wheel_series | default: '' | strip
            assign finish = build.overall_finish | default: build.center_finish | default: '' | strip
            if wheel != '' and all_wheels contains wheel
            else
              assign all_wheels = all_wheels | push: wheel
            endif
            if series != '' and all_series contains series
            else
              assign all_series = all_series | push: series
            endif
            if finish != '' and all_finishes contains finish
            else
              assign all_finishes = all_finishes | push: finish
            endif
          endif
        endfor
        assign all_wheels = all_wheels | uniq | sort
        assign all_series = all_series | uniq | sort
        assign all_finishes = all_finishes | uniq | sort
      -%}
      {%- assign filter_opts = all_wheels | join: ',' | append: '|' | append: all_series | join: ',' | append: '|' | append: all_finishes | join: ',' -%}
      {%- render 'calder-gallery-filters', filter_keys: 'wheel,series,finish', filter_labels: 'Wheel Model,Series,Finish', filter_options: filter_opts -%}
      <div class="calder-gallery-grid" data-calder-gallery data-items-per-page="{{ per_page }}">
        {%- for build in wheel_builds -%}
          {%- liquid
            assign heading = build.wheel_model | default: 'Wheel'
            assign series = build.wheel_series | default: ''
            assign finish = build.overall_finish | default: build.center_finish | default: ''
            assign meta_lines = '' | split: ''
            if series != ''
              assign meta_lines = meta_lines | push: series
            endif
            if finish != ''
              assign meta_lines = meta_lines | push: finish
            endif
            assign badges = '' | split: ''
            assign detail_url = '/pages/gallery-build?build=' | append: build.system.handle
            assign dataset = ''
            if build.wheel_model != blank
              assign dataset = dataset | append: ' data-wheel="' | append: build.wheel_model | append: '"'
            endif
            if build.wheel_series != blank
              assign dataset = dataset | append: ' data-series="' | append: build.wheel_series | append: '"'
            endif
            if finish != blank
              assign dataset = dataset | append: ' data-finish="' | append: finish | append: '"'
            endif
            assign featured_image = build.featured_image
            if featured_image == blank
              assign featured_image = build.gallery_images.value.first
            endif
          -%}
          {%- render 'calder-gallery-card', image: featured_image, heading: heading, meta_lines: meta_lines, badges: badges, url: detail_url, type: 'wheel', dataset_attrs: dataset -%}
        {%- endfor -%}
      </div>
      {%- if wheel_builds.size > perf_page_int -%}
        <div class="calder-gallery-loadmore"><button type="button" class="calder-gallery-loadmore__btn">Load More</button></div>
      {%- endif -%}
      <div class="calder-gallery-empty" style="display:none;">
        <div class="calder-gallery-empty__title">No Matching Wheels Found</div>
        <div class="calder-gallery-empty__text">Try adjusting your filters or explore all Calder wheel designs.</div>
        <button type="button" class="calder-gallery-empty__reset">Reset Filters</button>
      </div>
    {%- else -%}
      {%- assign block_builds = section.blocks | where: 'type', 'wheel_build' -%}
      {%- if block_builds.size > 0 -%}
        {%- liquid
          assign all_wheels = '' | split: ''
          assign all_series = '' | split: ''
          assign all_finishes = '' | split: ''
          for block in block_builds
            assign wheel = block.settings.wheel_model | strip
            assign series = block.settings.wheel_series | strip
            assign finish = block.settings.finish | strip
            if wheel != '' and all_wheels contains wheel
            else
              assign all_wheels = all_wheels | push: wheel
            endif
            if series != '' and all_series contains series
            else
              assign all_series = all_series | push: series
            endif
            if finish != '' and all_finishes contains finish
            else
              assign all_finishes = all_finishes | push: finish
            endif
          endfor
          assign all_wheels = all_wheels | uniq | sort
          assign all_series = all_series | uniq | sort
          assign all_finishes = all_finishes | uniq | sort
        -%}
        {%- assign filter_opts = all_wheels | join: ',' | append: '|' | append: all_series | join: ',' | append: '|' | append: all_finishes | join: ',' -%}
        {%- render 'calder-gallery-filters', filter_keys: 'wheel,series,finish', filter_labels: 'Wheel Model,Series,Finish', filter_options: filter_opts -%}
        <div class="calder-gallery-grid" data-calder-gallery data-items-per-page="{{ per_page }}">
          {%- for block in block_builds -%}
            {%- liquid
              assign heading = block.settings.wheel_model | default: 'Wheel'
              assign series = block.settings.wheel_series | default: ''
              assign finish = block.settings.finish | default: ''
              assign meta_lines = '' | split: ''
              if series != ''
                assign meta_lines = meta_lines | push: series
              endif
              if finish != ''
                assign meta_lines = meta_lines | push: finish
              endif
              assign badges = '' | split: ''
              assign detail_url = builder_url
              if block.settings.detail_url != blank
                assign detail_url = block.settings.detail_url
              endif
              assign dataset = ''
              if block.settings.wheel_model != blank
                assign dataset = dataset | append: ' data-wheel="' | append: block.settings.wheel_model | append: '"'
              endif
              if block.settings.wheel_series != blank
                assign dataset = dataset | append: ' data-series="' | append: block.settings.wheel_series | append: '"'
              endif
              if block.settings.finish != blank
                assign dataset = dataset | append: ' data-finish="' | append: block.settings.finish | append: '"'
              endif
            -%}
            {%- render 'calder-gallery-card', image: block.settings.image, heading: heading, meta_lines: meta_lines, badges: badges, url: detail_url, type: 'wheel', dataset_attrs: dataset -%}
          {%- endfor -%}
        </div>
        {%- if block_builds.size > perf_page_int -%}
          <div class="calder-gallery-loadmore"><button type="button" class="calder-gallery-loadmore__btn">Load More</button></div>
        {%- endif -%}
        <div class="calder-gallery-empty" style="display:none;">
          <div class="calder-gallery-empty__title">No Matching Wheels Found</div>
          <div class="calder-gallery-empty__text">Try adjusting your filters or explore all Calder wheel designs.</div>
          <button type="button" class="calder-gallery-empty__reset">Reset Filters</button>
        </div>
      {%- else -%}
        <div class="calder-gallery-empty">
          <div class="calder-gallery-empty__title">Wheel Gallery</div>
          <div class="calder-gallery-empty__text">Wheel gallery entries will appear here once added. Use the theme editor to add entries, or create Gallery Build metaobjects in Shopify Admin.</div>
        </div>
      {%- endif -%}
    {%- endif -%}
    {%- if section.settings.show_cta -%}
      <div class="calder-gallery-cta">
        <div class="calder-gallery-cta__inner">
          <div class="calder-gallery-cta__heading">{{ section.settings.cta_heading | default: 'Build Your Wheel' }}</div>
          <div class="calder-gallery-cta__text">{{ section.settings.cta_text | default: 'Configure your perfect Calder wheel. Choose your design, finishes, and see your build come to life.' }}</div>
          <a href="{{ section.settings.cta_url | default: builder_url }}" class="calder-gallery-cta__btn">{{ section.settings.cta_label | default: 'Build Your Wheel' }}</a>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>
{% render 'section-wrapper' %}
<script src="{{ 'calder-gallery.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Calder Wheel Gallery",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_title", "label": "Hero title", "default": "Wheel Gallery" },
    { "type": "textarea", "id": "hero_subtitle", "label": "Hero subtitle" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "per_page", "min": 6, "max": 48, "step": 3, "label": "Items per page", "default": 12 },
    { "type": "header", "content": "Builder" },
    { "type": "url", "id": "builder_url", "label": "Builder page URL" },
    { "type": "header", "content": "CTA" },
    { "type": "checkbox", "id": "show_cta", "label": "Show CTA", "default": true },
    { "type": "text", "id": "cta_heading", "label": "CTA heading", "default": "Build Your Wheel" },
    { "type": "textarea", "id": "cta_text", "label": "CTA text" },
    { "type": "url", "id": "cta_url", "label": "CTA link" },
    { "type": "text", "id": "cta_label", "label": "CTA button label", "default": "Build Your Wheel" },
    { "type": "header", "content": "Section Width" },
    { "type": "select", "id": "section_width", "label": "Width source", "options": [{ "value": "global", "label": "Use store width" }, { "value": "custom", "label": "Custom width" }], "default": "global" },
    { "type": "range", "id": "container_max_width", "min": 1178, "max": 1978, "step": 8, "unit": "px", "label": "Custom width", "default": 1178 }
  ],
  "blocks": [
    {
      "type": "wheel_build", "name": "Wheel Gallery Entry",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Wheel image" },
        { "type": "text", "id": "wheel_model", "label": "Wheel model" },
        { "type": "text", "id": "wheel_series", "label": "Series" },
        { "type": "text", "id": "finish", "label": "Finish" },
        { "type": "url", "id": "detail_url", "label": "Detail or Builder URL" }
      ]
    }
  ],
  "presets": [{ "name": "Calder Wheel Gallery", "settings": { "hero_title": "Wheel Gallery", "per_page": 12 } }]
}
{% endschema %}