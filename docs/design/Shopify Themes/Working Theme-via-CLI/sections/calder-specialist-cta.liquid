{% comment %}theme-check-disable NestedSnippet{% endcomment %}
{%- if section.settings.background_image -%}
<div class="calder-specialist-cta has-bg" style="background-image:url({{ section.settings.background_image | img_url: '1920x' }})">
{%- else -%}
<div class="calder-specialist-cta">
{%- endif -%}
  <div class="container calder-specialist-cta__inner">
    <div class="calder-specialist-cta__content">
      <div class="calder-eyebrow">Need Help With Fitment?</div>
      <h2 class="calder-specialist-cta__heading">{{ section.settings.heading | default: 'Contact a Wheel Specialist' }}</h2>
      <p class="calder-specialist-cta__text">{{ section.settings.text | default: 'Have questions about fitment, finishes, or lead times? Our team of wheel specialists is here to help you find the perfect setup.' }}</p>
      <a href="{{ section.settings.button_link | default: '/pages/contact' }}" class="calder-specialist-cta__action">
        {{ section.settings.button_text | default: 'Get in Touch' }} &rarr;
      </a>
      <div class="calder-specialist-cta__methods">
        <span class="calder-specialist-cta__method">
          <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M16 12.5v2a1.3 1.3 0 01-1.3 1.3A11.7 11.7 0 013 4.3 1.3 1.3 0 014.3 3h2a.8.8 0 01.7.5l1.2 2.7a.8.8 0 01-.2.9l-1.6 1.6a10.3 10.3 0 005.2 5.2l1.6-1.6a.8.8 0 01.9-.2l2.7 1.2a.8.8 0 01.5.7z"/></svg>
          {{ section.settings.phone | default: '(555) 123-4567' }}
        </span>
        <span class="calder-specialist-cta__method">
          <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M3 4.5h12a1.5 1.5 0 011.5 1.5v7.5a1.5 1.5 0 01-1.5 1.5H3A1.5 1.5 0 011.5 13.5V6A1.5 1.5 0 013 4.5z"/><path d="M1.5 6l7.5 5 7.5-5"/></svg>
          {{ section.settings.email | default: 'hello@calderwheels.com' }}
        </span>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Calder Specialist CTA",
  "tag": "section",
  "class": "calder-specialist-wrap",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Talk to a Wheel Specialist" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Have questions about fitment, finishes, or lead times? Our team of wheel specialists is here to help you find the perfect setup." },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Get in Touch" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "phone", "label": "Phone number", "default": "(555) 123-4567" },
    { "type": "text", "id": "email", "label": "Email", "default": "hello@calderwheels.com" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" }
  ],
  "presets": [
    { "name": "Calder Specialist CTA", "category": "Calder" }
  ]
}
{% endschema %}