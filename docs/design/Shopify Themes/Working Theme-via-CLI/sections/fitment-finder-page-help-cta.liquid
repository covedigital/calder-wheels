{%- liquid
  assign section_animation_enabled = section.settings.section_animation | default: true
  if settings.animation_sections == false
    assign section_animation_enabled = false
  endif
  if section.settings.section_decoration_top != 'none' or section.settings.section_decoration_bottom != 'none'
    assign section_animation_enabled = false
  endif
-%}

<style>
  .section--fitment-finder-help-cta {
    position: relative;
    margin-top: 0;
    margin-bottom: 0;
    width: 100%;
  }

  .fitment-finder-help-cta {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 350px;
    margin: 0;
    overflow: hidden;
    margin-top: 4rem;
  }

  .fitment-finder-help-cta__media,
  .fitment-finder-help-cta__overlay {
    position: absolute;
    inset: 0;
  }

  .fitment-finder-help-cta__media {
    z-index: 0;
  }

  .fitment-finder-help-cta__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .fitment-finder-help-cta__image-placeholder {
    width: 100%;
    height: 100%;
    background:
      linear-gradient(
        135deg,
        #0E2A3E 0%,
        #071A26 100%
      );
  }

  .fitment-finder-help-cta__overlay {
    z-index: 1;
    background:
      linear-gradient(
        90deg,
        rgba(4, 25, 38, 0.96) 0%,
        rgba(4, 29, 43, 0.90) 38%,
        rgba(4, 29, 43, 0.70) 68%,
        rgba(4, 20, 30, 0.48) 100%
      );
  }

  .fitment-finder-help-cta__content {
    position: relative;
    z-index: 3;
    width: calc(100% - 48px);
    max-width: var(--container-max-width, 1178px);
    margin-left: auto;
    margin-right: auto;
    padding: 38px 0;
    box-sizing: border-box;
    display: grid;
    grid-template-columns:
      minmax(320px, 1fr)
      auto;
    grid-template-areas:
      "heading actions"
      "body    actions";
    column-gap: clamp(50px, 7vw, 120px);
    row-gap: 10px;
    align-items: center;
  }

  .fitment-finder-help-cta__heading {
    grid-area: heading;
    margin: 0;
    max-width: 430px;
    color: #FFFFFF;
    font-size: clamp(26px, 2.25vw, 38px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 0.025em;
    text-transform: uppercase;
  }

  .fitment-finder-help-cta__body {
    grid-area: body;
    margin: 4px 0 0;
    max-width: 470px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.55;
  }

  .fitment-finder-help-cta__actions {
    grid-area: actions;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 18px;
    flex-wrap: nowrap;
    margin: 0;
  }

  .fitment-finder-help-cta__btn-primary,
  .fitment-finder-help-cta__btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 58px;
    padding: 0 30px;
    box-sizing: border-box;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .fitment-finder-help-cta__btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 22px;
    background: var(--calder-gradient-button, linear-gradient(135deg, #C2A48A, #D4B48C));
    color: var(--calder-navy-dark, #071A26);
    font-weight: 700;
    font-size: .65rem;
    letter-spacing: .02em;
    text-transform: uppercase;
    border: 1px solid transparent;
    border-radius: 4px;
    cursor: pointer;
    text-decoration: none;
    box-shadow: var(--calder-shadow-gold, 0 2px 8px rgba(194, 164, 138, 0.3));
    transition: background .25s ease,transform .25s ease,box-shadow .25s ease;
  }

  .fitment-finder-help-cta__btn-primary:hover {
    background: #E0AE70;
    border-color: #E0AE70;
    color: #071A26;
    transform: translateY(-1px);
  }

  .fitment-finder-help-cta__btn-primary::after {
    content: "\2192";
    margin-left: 18px;
    font-family: Arial, sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  .fitment-finder-help-cta__btn-primary:hover::after {
    transform: translateX(3px);
  }

  .fitment-finder-help-cta__btn-secondary {
    min-width: 315px;
    background: rgba(0, 20, 32, 0.20);
    border: 1px solid rgba(255, 255, 255, 0.70);
    color: #FFFFFF;
  }

  .fitment-finder-help-cta__btn-secondary:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: #FFFFFF;
    color: #FFFFFF;
    transform: translateY(-1px);
  }

  .fitment-finder-help-cta__decorative {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    z-index: 2;
    width: 30%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    overflow: hidden;
    pointer-events: none;
  }

  .fitment-finder-help-cta__decorative-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: right center;
  }

  @media (max-width: 1199px) {
    .fitment-finder-help-cta__content {
      grid-template-columns:
        minmax(280px, 1fr)
        minmax(420px, auto);
      column-gap: 40px;
    }

    .fitment-finder-help-cta__actions {
      gap: 12px;
    }

    .fitment-finder-help-cta__btn-primary {
      min-width: 190px;
    }

    .fitment-finder-help-cta__btn-secondary {
      min-width: 250px;
    }

    .fitment-finder-help-cta__btn-primary,
    .fitment-finder-help-cta__btn-secondary {
      padding-left: 20px;
      padding-right: 20px;
      font-size: 10px;
    }
  }

  @media (max-width: 900px) {
    .fitment-finder-help-cta {
      min-height: 280px;
    }

    .fitment-finder-help-cta__content {
      width: calc(100% - 48px);
      grid-template-columns: 1fr;
      grid-template-areas:
        "heading"
        "body"
        "actions";
      row-gap: 12px;
    }

    .fitment-finder-help-cta__actions {
      justify-content: flex-start;
      margin-top: 14px;
    }
  }

  @media (max-width: 600px) {
    .fitment-finder-help-cta {
      min-height: 390px;
    }

    .fitment-finder-help-cta__content {
      width: calc(100% - 40px);
      padding: 36px 0;
    }

    .fitment-finder-help-cta__heading {
      max-width: 340px;
      font-size: clamp(24px, 8vw, 32px);
    }

    .fitment-finder-help-cta__body {
      max-width: 360px;
      font-size: 13px;
    }

    .fitment-finder-help-cta__actions {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }

    .fitment-finder-help-cta__btn-primary,
    .fitment-finder-help-cta__btn-secondary {
      width: 100%;
      min-width: 0;
      min-height: 54px;
    }

    .fitment-finder-help-cta__decorative {
      width: 55%;
      opacity: 0.35;
    }
  }

  @media screen and (max-width: 1024px) {
    .fitment-finder-help-cta__content {
      max-width: 100%;
      padding: 28px 24px;
    }

    .fitment-finder-help-cta__decorative {
      display: none;
    }
  }

  @media screen and (max-width: 600px) {
    .fitment-finder-help-cta__actions {
      flex-direction: column;
      align-items: flex-start;
    }

    .fitment-finder-help-cta__btn-primary,
    .fitment-finder-help-cta__btn-secondary {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<section class="{% if section_animation_enabled %}show-on-scroll {% endif %}fitment-finder-help-cta" id="fitment-finder-help-cta-{{ section.id }}">
  <div class="fitment-finder-help-cta__media" aria-hidden="true">
    {% if section.settings.help_cta_bg_image != blank %}
      {{ section.settings.help_cta_bg_image | image_url: width: 1200 | image_tag: widths: '600, 900, 1200', loading: 'lazy', class: 'fitment-finder-help-cta__image', alt: '' }}
    {% else %}
      <div class="fitment-finder-help-cta__image-placeholder"></div>
    {% endif %}
  </div>

  <div class="fitment-finder-help-cta__overlay" aria-hidden="true"></div>

  <div class="fitment-finder-help-cta__content">
    {% if section.settings.heading != blank %}
      <h2 class="fitment-finder-help-cta__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.body_text != blank %}
      <div class="fitment-finder-help-cta__body">{{ section.settings.body_text }}</div>
    {% endif %}

    <div class="fitment-finder-help-cta__actions">
      {% if section.settings.primary_cta_text != blank %}
        <a href="{{ section.settings.primary_cta_url }}" class="fitment-finder-help-cta__btn-primary">
          {{ section.settings.primary_cta_text }}
        </a>
      {% endif %}
      {% if section.settings.secondary_cta_text != blank %}
        <a href="{{ section.settings.secondary_cta_url }}" class="fitment-finder-help-cta__btn-secondary">
          {{ section.settings.secondary_cta_text }}
        </a>
      {% endif %}
    </div>
  </div>

  {% if section.settings.decorative_image != blank %}
    <div class="fitment-finder-help-cta__decorative" aria-hidden="true">
      {{ section.settings.decorative_image | image_url: width: 400 | image_tag: widths: '200, 400', loading: 'lazy', class: 'fitment-finder-help-cta__decorative-image', alt: '' }}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Fitment Finder Help CTA",
  "tag": "section",
  "class": "section--fitment-finder-help-cta",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "help_cta_bg_image",
      "label": "Background image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "NEED HELP FINDING<br>THE RIGHT SETUP?"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text",
      "default": "Our wheel specialists can help you find the perfect fitment for your vehicle."
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary CTA",
      "default": "Find Your Fit"
    },
    {
      "type": "url",
      "id": "primary_cta_url",
      "label": "Primary CTA link"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary CTA",
      "default": "Contact a Wheel Specialist"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Secondary CTA link"
    },
    {
      "type": "header",
      "content": "Decorative"
    },
    {
      "type": "image_picker",
      "id": "decorative_image",
      "label": "Decorative wheel image"
    },
    {
      "type": "header",
      "content": "SECTION GENERAL"
    },
    {
      "type": "checkbox",
      "id": "section_animation",
      "label": "Enable soft appearing of section",
      "default": true,
      "info": "Global sections animation disabling in Theme Settings / General / Sections. AUTODISABLED if section has top or bottom separator."
    },
    {
      "type": "header",
      "content": "SECTION WIDTH"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Select width source",
      "options": [
        {
          "value": "global",
          "label": "Use store width"
        },
        {
          "value": "custom",
          "label": "Custom width"
        }
      ],
      "default": "global",
      "info": "Store width you can set in Theme Settings / General"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 1178,
      "max": 1978,
      "step": 8,
      "unit": "px",
      "label": "Custom width",
      "default": 1178
    },
    {
      "type": "header",
      "content": "SECTION MARGIN"
    },
    {
      "type": "range",
      "id": "spacing_sections",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Vertical space above the section on Desktop",
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "use_global_desktop_space",
      "label": "Use global space on desktop",
      "default": true,
      "info": "from Theme Settings / General / Layout"
    },
    {
      "type": "range",
      "id": "spacing_sections_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Vertical space above the section on Mobile",
      "default": 70
