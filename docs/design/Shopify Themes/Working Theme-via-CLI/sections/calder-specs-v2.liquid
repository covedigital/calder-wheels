{%- liquid
  assign spec_series = product.metafields.custom.series.value | default: 'Calder Series'
  assign spec_construction = product.metafields.custom.construction.value
  assign spec_bolt = product.metafields.custom.bolt_pattern.value
  assign spec_load = product.metafields.custom.load_rating.value
  assign spec_finish = product.metafields.custom.finish.value
  assign spec_title = product.metafields.custom.design_code.value | default: product.title
  assign spec_photo = section.settings.specs_feature_image | default: product.featured_image

  assign bom_data = product.metafields.custom.bom.value
  assign bom_components = bom_data.components | default: bom_data
  assign center_finishes = ''
  assign barrel_finishes = ''
  assign hardware_finishes = ''
  if bom_components != blank
    for c in bom_components
      if c.type == 'center'
        assign center_finishes = center_finishes | append: c.name | append: ', '
      elsif c.type == 'barrel'
        assign barrel_finishes = barrel_finishes | append: c.name | append: ', '
      elsif c.type == 'hardware'
        assign hardware_finishes = hardware_finishes | append: c.name | append: ', '
      endif
    endfor
  endif
  assign center_finishes = center_finishes | remove_last: ', '
  assign barrel_finishes = barrel_finishes | remove_last: ', '
  assign hardware_finishes = hardware_finishes | remove_last: ', '

  assign spec_sizes = ''
  assign seen_diameters = '|'
  for v in product.variants
    assign diameter = v.option1 | default: v.title | strip
    if diameter contains 'in' or diameter contains '"'
      assign diameter_token = '|' | append: diameter | append: '|'
      unless seen_diameters contains diameter_token
        if spec_sizes != blank
          assign spec_sizes = spec_sizes | append: ', '
        endif
        assign spec_sizes = spec_sizes | append: diameter
        assign seen_diameters = seen_diameters | append: diameter | append: '|'
      endunless
    endif
  endfor
-%}
<section class="cw-spec-feature-v2 cw-spec-feature-v2--{{ section.settings.panel_order | default: 'visual_left' }}" aria-labelledby="cw-spec-title-{{ section.id }}">
  <div class="cw-spec-feature-v2__container">

    <div class="cw-spec-feature-v2__visual">
      {%- if section.settings.engineering_image != blank -%}
        {{ section.settings.engineering_image | image_url: width: 1600 | image_tag: class: 'cw-spec-feature-v2__engineering-image', alt: product.title, loading: 'lazy', widths: '600,900,1200,1600', sizes: '(max-width: 900px) 100vw, 50vw' }}
      {%- elsif spec_photo != blank -%}
        {{ spec_photo | image_url: width: 1600 | image_tag: class: 'cw-spec-feature-v2__engineering-image', alt: product.title, loading: 'lazy', widths: '600,900,1200,1600', sizes: '(max-width: 900px) 100vw, 50vw' }}
      {%- endif -%}
      <div class="cw-spec-feature-v2__engineering-overlay" aria-hidden="true"></div>
            <div class="cw-spec-feature-v2__engineering-body calder-engineering__body">

              <div class="cw-spec-feature-v2__engineering-intro calder-engineering__intro">

                <h3 class="cw-spec-feature-v2__engineering-title">
                  {{ section.settings.engineering_heading | default: 'Engineered to Perform' }}
                </h3>

                <p class="cw-spec-feature-v2__engineering-description">
                  {{ section.settings.engineering_text | default: 'Every Calder wheel is precision-engineered from aerospace-grade materials, assembled to order by master craftsmen, and validated through rigorous testing before delivery.' }}
                </p>

              </div>


              {%- comment -%}
                ======================================================
                ENGINEERING CAPABILITIES
                ======================================================
              {%- endcomment -%}

              <div class="cw-spec-feature-v2__engineering-capabilities calder-engineering__capabilities">


