                    </svg>
                  </div>

                  <div class="cw-spec-feature-v2__engineering-cap-text">
                    <strong>CNC Machined</strong>
                    <span>Precision to ±0.005mm</span>
                  </div>

                </div>


                {%- comment -%} Strength Tested {%- endcomment -%}

                <div class="cw-spec-feature-v2__engineering-cap">

                  <div class="cw-spec-feature-v2__engineering-cap-icon" aria-hidden="true">
