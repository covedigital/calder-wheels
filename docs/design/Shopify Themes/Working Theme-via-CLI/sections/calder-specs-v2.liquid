    </div>
    <div class="cw-spec-feature-v2__content">
      <div class="cw-spec-feature-v2__intro">
        <p class="cw-spec-feature-v2__eyebrow">{{ spec_series | escape }}</p>
        <h2 id="cw-spec-title-{{ section.id }}" class="cw-spec-feature-v2__title">{{ spec_title | escape }}</h2>
        <p class="cw-spec-feature-v2__subtitle">{{ section.settings.specs_heading | default: 'Wheel Specifications' | escape }}</p>
      </div>
      <div class="cw-spec-feature-v2__columns">
        <div class="cw-spec-feature-v2__column">
          <div class="cw-spec-feature-v2__item"><span class="cw-spec-feature-v2__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5M3 17l9 5 9-5"/></svg></span><div><span class="cw-spec-feature-v2__label">Series</span><span class="cw-spec-feature-v2__value">{{ spec_series | escape }}</span></div></div>
          <div class="cw-spec-feature-v2__item"><span class="cw-spec-feature-v2__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z"/><path d="M10 2h4l.6 2.4 2 1.1 2.3-.8 2 3.4-1.8 1.7v2.4l1.8 1.7-2 3.4-2.3-.8-2 1.1L14 22h-4l-.6-2.4-2-1.1-2.3.8-2-3.4 1.8-1.7v-2.4L3.1 10l2-3.4 2.3.8 2-1.1L10 2Z"/></svg></span><div><span class="cw-spec-feature-v2__label">Construction</span><span class="cw-spec-feature-v2__value">{{ spec_construction | default: 'Contact for details' | escape }}</span></div></div>
          <div class="cw-spec-feature-v2__item"><span class="cw-spec-feature-v2__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m14 5 5 5M4 20l5-1 11-11a3.5 3.5 0 0 0-5-5L4 14l-1 6 1 0ZM11 8l5 5"/></svg></span><div><span class="cw-spec-feature-v2__label">Finish Shown</span><span class="cw-spec-feature-v2__value">{{ spec_finish | default: center_finishes | default: 'Available by configuration' | escape }}</span></div></div>
          <div class="cw-spec-feature-v2__item"><span class="cw-spec-feature-v2__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="M12 3v3M21 12h-3M12 21v-3M3 12h3"/></svg></span><div><span class="cw-spec-feature-v2__label">Available Finishes</span><span class="cw-spec-feature-v2__value">{{ center_finishes | default: barrel_finishes | default: hardware_finishes | default: 'See available finishes' | escape }}</span></div></div>
        </div>
        <div class="cw-spec-feature-v2__column cw-spec-feature-v2__column--right">
          <div class="cw-spec-feature-v2__item"><span class="cw-spec-feature-v2__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M7 17 17 7M10 7h7v7"/></svg></span><div><span class="cw-spec-feature-v2__label">Sizes</span><span class="cw-spec-feature-v2__value">{{ spec_sizes | default: 'Contact for sizes' | escape }}</span></div></div>
          <div class="cw-spec-feature-v2__item"><span class="cw-spec-feature-v2__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 6 18 2l4 4-4 4M15 9 5 19a2.1 2.1 0 0 1-3-3L12 6M12 6l6 6"/></svg></span><div><span class="cw-spec-feature-v2__label">Bolt Patterns</span><span class="cw-spec-feature-v2__value">{{ spec_bolt | default: 'Custom fitment available' | escape }}</span></div></div>
          <div class="cw-spec-feature-v2__item"><span class="cw-spec-feature-v2__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="M12 3v3M21 12h-3M12 21v-3M3 12h3"/></svg></span><div><span class="cw-spec-feature-v2__label">Center Cap</span><span class="cw-spec-feature-v2__value">Calder Branded</span></div></div>
          <div class="cw-spec-feature-v2__item"><span class="cw-spec-feature-v2__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 8V6a4 4 0 0 1 8 0v2H8ZM6 8h12l3 13H3L6 8Z"/><text x="12" y="17" text-anchor="middle" font-size="7" fill="currentColor" stroke="none">B</text></svg></span><div><span class="cw-spec-feature-v2__label">Weight</span><span class="cw-spec-feature-v2__value">{{ product.metafields.custom.weight.value | default: 'Contact for weight' | escape }}</span></div></div>
          <div class="cw-spec-feature-v2__item"><span class="cw-spec-feature-v2__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 20 6v6c0 5-3 8-8 10-5-2-8-5-8-10V6l8-4Z"/><path d="m8 12 3 3 5-6"/></svg></span><div><span class="cw-spec-feature-v2__label">Load Rating</span><span class="cw-spec-feature-v2__value">{{ spec_load | default: 'Contact for rating' | escape }}</span></div></div>
        </div>
      </div>
    </div>

  </div>
</section>


{% schema %}
{
  "name": "Calder Specs V2",
  "tag": "section",
  "class": "calder-specs-v2-wrap",
  "settings": [
    {
      "type": "select",
      "id": "panel_order",
      "label": "Panel arrangement",
      "options": [
        {
          "value": "visual_left",
          "label": "Engineering left / Specifications right"
        },
        {
          "value": "visual_right",
          "label": "Specifications left / Engineering right"
        }
      ],
      "default": "visual_left"
    },
    {
      "type": "image_picker",
      "id": "specs_feature_image",
      "label": "Specifications close-up image"
    },
    {
      "type": "header",
      "content": "Specifications"
    },
    {
      "type": "text",
      "id": "specs_heading",
      "label": "Heading",
      "default": "Wheel Specifications"
    },
    {
      "type": "header",
      "content": "Engineering"
    },
    {
      "type": "text",
      "id": "engineering_heading",
      "label": "Heading",
      "default": "Engineered to Perform"
    },
    {
      "type": "textarea",
      "id": "engineering_text",
      "label": "Description",
      "default": "Every Calder wheel is precision-engineered from aerospace-grade materials, assembled to order by master craftsmen, and validated through rigorous testing before delivery."
    },
    {
      "type": "image_picker",
      "id": "engineering_image",
      "label": "Engineering background image"
    },
    {
      "type": "header",
      "content": "SECTION GENERAL"
    },
    {
      "type": "checkbox",
      "id": "section_animation",
      "label": "Enable soft appearing of section",
      "default": true,
      "info": "Global sections animation disabling in Theme Settings / General / Sections. AUTODISABLED if section has top or bottom separator."
    },
    {
      "type": "header",
      "content": "SECTION WIDTH"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Select width source",
      "options": [
        {
          "value": "global",
          "label": "Use store width"
        },
        {
          "value": "custom",
          "label": "Custom width"
        }
      ],
      "default": "global",
      "info": "Store width you can set in Theme Settings / General"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 1178,
      "max": 1978,
      "step": 8,
      "unit": "px",
      "label": "Custom width",
      "default": 1178,
      "info": "The specified width may differ from the actual width of the section because this section uses a smart grid for the most successful arrangement of columns in rows and for best view. Columns are not scaled, but added when the section width is increased."
    },
    {
      "type": "header",
      "content": "SECTION MARGIN"
    },
    {
      "type": "range",
      "id": "spacing_sections",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Vertical space above the section on Desktop",
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "use_global_desktop_space",
      "label": "Use global space on desktop",
      "default": true,
      "info": "from Theme Settings / General / Layout"
    },
    {
      "type": "range",
      "id": "spacing_sections_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Vertical space above the section on Mobile",
      "default": 70
    },
    {
