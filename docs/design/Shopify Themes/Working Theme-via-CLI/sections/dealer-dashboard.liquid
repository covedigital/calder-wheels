  </div>
</div>
{% else %}
              {% render 'dealer-activity-list', seed_activity: '' %}
{% endif %}
            </div>
            <div class="dp-columns__secondary">
              {% render 'dealer-featured-wheels',
                featured_products: section.settings.featured_products,
                featured_collection: section.settings.featured_collection
              %}
            </div>
          </div>
        </div>

        <div class="dp-footer">
          <div>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</div>
          <div class="dp-footer__links">
            <a href="/pages/dealer-dashboard">Dealer Portal</a>
            <a href="/policies/terms-of-service">Terms &amp; Conditions</a>
            <a href="/policies/privacy-policy">Privacy Policy</a>
          </div>
        </div>
      </main>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Dealer Dashboard",
  "tag": "section",
  "class": "section section--dealer-dashboard",
  "settings": [
    {
      "type": "header",
      "content": "Dealer Demo Mode"
    },
    {
      "type": "checkbox",
      "id": "dealer_demo_mode",
      "label": "Enable demo mode",
      "default": true,
      "info": "Show presentation seed data for backend-dependent components"
    },
    {
      "type": "header",
      "content": "Branding"
    },
    {
      "type": "image_picker",
      "id": "dealer_logo",
      "label": "Custom dealer portal logo"
    },
    {
      "type": "range",
