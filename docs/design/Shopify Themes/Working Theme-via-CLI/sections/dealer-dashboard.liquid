      "min": 80,
      "max": 180,
      "default": 120,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "dealer_portal_subtitle",
      "label": "Dealer Portal subtitle",
      "default": "DEALER PORTAL"
    },
