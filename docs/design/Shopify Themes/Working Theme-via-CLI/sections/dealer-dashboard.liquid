      <span class="dp-activity__item-time">Yesterday at 3:18 PM</span>
      <span class="dp-activity__item-arrow">&#8594;</span>
    </div>
    <div class="dp-activity__item">
      <div class="dp-activity__item-icon">&#9654;</div>
      <span class="dp-activity__item-msg">Order CW-1049 shipped</span>
      <span class="dp-activity__item-time">Sep 14, 2026</span>
      <span class="dp-activity__item-arrow">&#8594;</span>
    </div>
    <div class="dp-activity__item">
