{{ 'fitment-finder.css' | asset_url | stylesheet_tag }}
{% render 'fitment-data' %}
{% render 'fitment-catalog' %}

{%- liquid
  assign store_width = settings.container_max_width
  if section.settings.section_width == 'custom'
    assign store_width = section.settings.container_max_width
  endif
  assign bg_image = section.settings.background_image
  assign heading = section.settings.heading | default: 'Find Your Fit'
  assign subheading = section.settings.subheading
  assign button_text = section.settings.button_text | default: 'View Compatible Wheels'
  assign placeholder_year = section.settings.placeholder_year | default: 'Select Year'
  assign placeholder_make = section.settings.placeholder_make | default: 'Select Make'
  assign placeholder_model = section.settings.placeholder_model | default: 'Select Model'
  assign placeholder_generation = section.settings.placeholder_generation | default: 'Select Generation'
-%}

<div
  class="fitment-finder hf-fitment"
  id="calder-fitment-finder-{{ section.id }}"
  data-section-id="{{ section.id }}"
  style="--container-max-width: {{ store_width }}px; {% if bg_image != blank %}--fitment-bg: url({{ bg_image | img_url: '1920x' }});{% endif %}"
>
  <div class="fitment-finder__inner container">
    <div class="fitment-finder__content">
      {% if heading != blank %}
        <h2 class="fitment-finder__heading">{{ heading }}</h2>
      {% endif %}
      {% if subheading != blank %}
        <p class="fitment-finder__subheading">{{ subheading }}</p>
      {% endif %}
    </div>

    <div class="hf-fitment__tabs" role="tablist" aria-label="Browse wheels">
      <button type="button" class="hf-fitment__tab hf-fitment__tab--active" data-tab="vehicle" role="tab" aria-selected="true" aria-controls="hf-panel-vehicle-{{ section.id }}">By Vehicle</button>
      <button type="button" class="hf-fitment__tab" data-tab="style" role="tab" aria-selected="false" aria-controls="hf-panel-style-{{ section.id }}">By Wheel Style</button>
    </div>
    <div id="hf-panel-vehicle-{{ section.id }}" class="hf-fitment__panel hf-fitment__panel--active" role="tabpanel">
    <div class="fitment-finder__selects">
      <div class="fitment-finder__select-row">
        <div class="fitment-finder__select-col">
          <select id="hf-year-{{ section.id }}" class="form-control fitment-finder__select" data-fitment="year">
            <option value="">{{ placeholder_year }}</option>
          </select>
        </div>
        <div class="fitment-finder__select-col">
          <select id="hf-make-{{ section.id }}" class="form-control fitment-finder__select" data-fitment="make" disabled>
            <option value="">{{ placeholder_make }}</option>
          </select>
        </div>
        <div class="fitment-finder__select-col">
          <select id="hf-model-{{ section.id }}" class="form-control fitment-finder__select" data-fitment="model" disabled>
            <option value="">{{ placeholder_model }}</option>
          </select>
        </div>
        <div class="fitment-finder__select-col">
          <select id="hf-trim-{{ section.id }}" class="form-control fitment-finder__select" data-fitment="generation" disabled>
            <option value="">{{ placeholder_generation }}</option>
          </select>
        </div>
      </div>

      <div class="fitment-finder__action">
        <button
          id="hf-submit-{{ section.id }}"
          class="btn btn--primary fitment-finder__submit"
          disabled
          data-section-id="{{ section.id }}"
        >
          {{ button_text }}
        </button>
      </div>
    </div>

    </div>
    <div id="hf-panel-style-{{ section.id }}" class="hf-fitment__panel" role="tabpanel" hidden>
      <div class="fitment-finder__selects">
        <div class="fitment-finder__select-row">
          <div class="fitment-finder__select-col">
            <label class="hf-visually-hidden" for="hf-wheel-model-{{ section.id }}">Wheel model</label>
            <select id="hf-wheel-model-{{ section.id }}" class="form-control fitment-finder__select" data-wheel-filter="model">
              <option value="">All Wheel Models</option>
              {%- assign calder_collection = collections['all-calder-wheels'] -%}
              {%- if calder_collection != blank -%}
                {%- for product in calder_collection.products limit: 50 -%}
                  <option value="{{ product.title | escape }}">{{ product.title | escape }}</option>
                {%- endfor -%}
              {%- endif -%}
            </select>
          </div>
          <div class="fitment-finder__select-col">
            <label class="hf-visually-hidden" for="hf-diameter-{{ section.id }}">Diameter</label>
            <select id="hf-diameter-{{ section.id }}" class="form-control fitment-finder__select"><option value="">All Diameters</option></select>
          </div>
          <div class="fitment-finder__select-col">
            <label class="hf-visually-hidden" for="hf-finish-{{ section.id }}">Finish</label>
            <select id="hf-finish-{{ section.id }}" class="form-control fitment-finder__select"><option value="">All Finishes</option></select>
          </div>
          <div class="fitment-finder__select-col">
            <label class="hf-visually-hidden" for="hf-bolt-{{ section.id }}">Bolt pattern</label>
            <select id="hf-bolt-{{ section.id }}" class="form-control fitment-finder__select"><option value="">All Bolt Patterns</option></select>
          </div>
        </div>
        <div class="fitment-finder__action">
          <button type="button" id="hf-style-submit-{{ section.id }}" class="btn btn--primary fitment-finder__submit">Find Wheels</button>
        </div>
      </div>
    </div>

    <div id="hf-results-{{ section.id }}" class="fitment-finder__results" style="display: none;"></div>
  </div>
</div>

<script src="{{ 'fitment-finder.js' | asset_url }}" defer></script>

