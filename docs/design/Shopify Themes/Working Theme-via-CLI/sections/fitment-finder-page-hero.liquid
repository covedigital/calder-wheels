{%- liquid
  assign section_animation_enabled = section.settings.section_animation | default: true
  if settings.animation_sections == false
    assign section_animation_enabled = false
  endif
  if section.settings.section_decoration_top != 'none' or section.settings.section_decoration_bottom != 'none'
    assign section_animation_enabled = false
  endif
-%}

<style>
  .section--fitment-finder-hero {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--calder-dark, #050505);
    color: var(--calder-white, #ffffff);
  }

  .fitment-finder-hero {
    position: relative;
    width: 100%;
    min-height: 380px;
    overflow: hidden;
    background: var(--calder-dark, #050505);
    color: var(--calder-white, #ffffff);
  }

  .fitment-finder-hero__media,
  .fitment-finder-hero__overlay {
    position: absolute;
    inset: 0;
  }

  .fitment-finder-hero__media {
    z-index: 0;
  }

  .fitment-finder-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }

  .fitment-finder-hero__image-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--calder-navy, #0a1628) 0%, var(--calder-surface, #1a1a2e) 50%, var(--calder-blue, #0f3460) 100%);
  }

  .fitment-finder-hero__overlay {
    z-index: 1;
    background: linear-gradient(
      90deg,
      #0a0a0abf 0%,
      #0a0a0aab 95%,
      #0a0a0a4d 100%
    );
  }

  .fitment-finder-hero__container {
    position: relative;
    z-index: 2;
    width: min(calc(100% - 48px), var(--calder-content-max-width, 1178px));
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 380px;
    padding: 64px 0;
  }

  .fitment-finder-hero__content {
    max-width: 520px;
    position: relative;
    z-index: 3;
  }

  .fitment-finder-hero__eyebrow {
    margin: 0 0 14px;
    color: var(--calder-champagne, #C2A48A);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .fitment-finder-hero__heading {
    margin: 0 0 18px;
    color: var(--calder-white, #ffffff);
    font-size: clamp(34px, 4vw, 54px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .fitment-finder-hero__heading span {
    color: var(--calder-champagne, #C2A48A);
  }

  .fitment-finder-hero__body {
    margin: 0;
    color: rgba(255, 255, 255, 0.85);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.55;
    max-width: 440px;
  }

  .fitment-finder-hero__standards {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    flex-shrink: 0;
    position: relative;
    z-index: 3;
  }

  .fitment-finder-hero__standards-heading {
    color: var(--calder-champagne, #C2A48A);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-align: right;
    line-height: 1.3;
    white-space: pre-line;
  }

  .fitment-finder-hero__standards-divider {
    width: 1px;
    height: 20px;
    background: rgba(194, 164, 138, 0.4);
    margin: 4px auto;
  }

  .fitment-finder-hero__standard {
    display: flex;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.80);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .fitment-finder-hero__standard svg {
    flex: 0 0 14px;
  }

  .fitment-finder-hero__standard svg path {
    fill: var(--calder-champagne, #C2A48A);
  }

  .fitment-finder-hero__decorative {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    z-index: 2;
    width: 45%;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    overflow: hidden;
    pointer-events: none;
  }

  .fitment-finder-hero__decorative-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: right center;
  }

  @media screen and (max-width: 1024px) {
    .fitment-finder-hero__standards {
      display: none;
    }

    .fitment-finder-hero__decorative {
      display: none;
    }

    .fitment-finder-hero__container {
      min-height: 280px;
      padding: 48px 0;
    }

    .fitment-finder-hero__content {
      max-width: 100%;
    }
  }

  @media screen and (max-width: 600px) {
    .fitment-finder-hero__container {
      min-height: 240px;
      padding: 40px 0;
    }

    .fitment-finder-hero__heading {
      font-size: 26px;
    }

    .fitment-finder-hero__body {
      font-size: 14px;
    }
  }
</style>

<section class="{% if section_animation_enabled %}show-on-scroll {% endif %}fitment-finder-hero" id="fitment-finder-hero-{{ section.id }}">
  <div class="fitment-finder-hero__media" aria-hidden="true">
    {% if section.settings.hero_image != blank %}
      {{ section.settings.hero_image | image_url: width: 2400 | image_tag: widths: '768, 1200, 1600, 1920, 2400', loading: 'eager', fetchpriority: 'high', class: 'fitment-finder-hero__image', alt: '' }}
    {% else %}
      <div class="fitment-finder-hero__image-placeholder"></div>
    {% endif %}
  </div>

  <div class="fitment-finder-hero__overlay" aria-hidden="true"></div>

  <div class="fitment-finder-hero__container">
    <div class="fitment-finder-hero__content">
      {% if section.settings.eyebrow != blank %}
        <div class="fitment-finder-hero__eyebrow">{{ section.settings.eyebrow }}</div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="fitment-finder-hero__heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.body_text != blank %}
        <div class="fitment-finder-hero__body">{{ section.settings.body_text }}</div>
      {% endif %}
    </div>

    <div class="fitment-finder-hero__standards">
      {% if section.settings.standards_heading != blank %}
        <div class="fitment-finder-hero__standards-heading">{{ section.settings.standards_heading }}</div>
      {% endif %}
      <div class="fitment-finder-hero__standards-divider" aria-hidden="true"></div>
      <div class="fitment-finder-hero__standard">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M7 1L9 5L13 5.5L10 8.5L10.5 13L7 11L3.5 13L4 8.5L1 5.5L5 5L7 1Z" fill="#C2A48A"/>
        </svg>
        <span>{{ section.settings.standard_1 | default: 'OEM Quality' }}</span>
      </div>
      <div class="fitment-finder-hero__standard">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M7 1L9 5L13 5.5L10 8.5L10.5 13L7 11L3.5 13L4 8.5L1 5.5L5 5L7 1Z" fill="#C2A48A"/>
        </svg>
        <span>{{ section.settings.standard_2 | default: 'TUV Certified' }}</span>
      </div>
      <div class="fitment-finder-hero__standard">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M7 1L9 5L13 5.5L10 8.5L10.5 13L7 11L3.5 13L4 8.5L1 5.5L5 5L7 1Z" fill="#C2A48A"/>
        </svg>
        <span>{{ section.settings.standard_3 | default: 'Built to Order' }}</span>
      </div>
    </div>
  </div>

  {% if section.settings.decorative_image != blank %}
    <div class="fitment-finder-hero__decorative" aria-hidden="true">
      {{ section.settings.decorative_image | image_url: width: 800 | image_tag: widths: '400, 600, 800', loading: 'lazy', class: 'fitment-finder-hero__decorative-image', alt: '' }}
    </div>
  {% endif %}
</section>

