{{ 'fitment-finder.css' | asset_url | stylesheet_tag }}
{{ 'home.css' | asset_url | stylesheet_tag }}
{% render 'fitment-data' %}

<section class="hf-fitment" id="calder-fitment-finder-{{ section.id }}" data-section-id="{{ section.id }}">
  <!-- Background fills behind the shell -->
  <div class="hf-fitment__bg-hero" aria-hidden="true"></div>
  <div class="hf-fitment__bg-light" aria-hidden="true"></div>

  <div class="hf-fitment__shell">
    <!-- Tabs -->
    <div class="hf-fitment__tabs" role="tablist" aria-label="Fitment search method">
      <button class="hf-fitment__tab hf-fitment__tab--active hf-fitment__tab--vehicle" role="tab" aria-selected="true" data-tab="vehicle" id="hf-tab-vehicle-{{ section.id }}">
        <svg class="hf-fitment__tab-icon" width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <rect x="2" y="5" width="12" height="8" rx="1.5" stroke="currentColor" stroke-width="1.2" fill="none"/>
          <circle cx="5.5" cy="11" r="1.5" stroke="currentColor" stroke-width="1" fill="none"/>
          <circle cx="10.5" cy="11" r="1.5" stroke="currentColor" stroke-width="1" fill="none"/>
          <path d="M4 5V4a2 2 0 012-2h4a2 2 0 012 2v1" stroke="currentColor" stroke-width="1" fill="none"/>
        </svg>
        <span>{{ section.settings.tab_1_label | default: 'By Vehicle' }}</span>
      </button>
      <button class="hf-fitment__tab hf-fitment__tab--style" role="tab" aria-selected="false" data-tab="style" id="hf-tab-style-{{ section.id }}">
        <svg class="hf-fitment__tab-icon" width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.2" fill="none"/>
          <circle cx="8" cy="8" r="2.5" stroke="currentColor" stroke-width="1" fill="none"/>
          <line x1="8" y1="2" x2="8" y2="4" stroke="currentColor" stroke-width="1"/>
          <line x1="8" y1="12" x2="8" y2="14" stroke="currentColor" stroke-width="1"/>
          <line x1="2" y1="8" x2="4" y2="8" stroke="currentColor" stroke-width="1"/>
          <line x1="12" y1="8" x2="14" y2="8" stroke="currentColor" stroke-width="1"/>
        </svg>
        <span>{{ section.settings.tab_2_label | default: 'By Wheel Style' }}</span>
      </button>
    </div>

    <!-- Main panel -->
    <div class="hf-fitment__panel" role="tabpanel">
      <!-- Technical artwork (absolutely positioned, shared across tabs) -->
      <div class="hf-fitment__art" aria-hidden="true">
        {%- assign art_svg = 'technical-wheel-bg.svg' | asset_url -%}
        <img src="{{ art_svg }}" alt="" class="hf-fitment__art-img" loading="lazy">
      </div>

      <!-- Inner layout: finder + vehicle divider + vehicle status -->
      <div class="hf-fitment__layout">
        <div class="hf-fitment__finder">
          <!-- Heading -->
          <div class="hf-fitment__heading-group">
            <h2 class="hf-fitment__heading">FIND YOUR <span class="hf-fitment__heading-fit">FIT</span></h2>
            <p class="hf-fitment__description" data-description-vehicle>Select your vehicle to see compatible wheels, real builds, and fitment details.</p>
            <p class="hf-fitment__description" data-description-style hidden>Browse Calder wheels by size, bolt pattern, and finish.</p>
          </div>

          <!-- BY VEHICLE form -->
          <div id="hf-panel-vehicle-{{ section.id }}" class="hf-fitment__form-panel hf-fitment__form-panel--active">
            <div class="hf-fitment__controls">
              <div class="hf-fitment__control hf-fitment__control--year">
                <label class="hf-fitment__label" for="hf-year-{{ section.id }}">{{ section.settings.label_year | default: 'YEAR' }}</label>
                <select id="hf-year-{{ section.id }}" class="hf-fitment__select" data-fitment="year">
                  <option value="">{{ section.settings.placeholder_year | default: 'Year' }}</option>
                </select>
              </div>
              <div class="hf-fitment__control hf-fitment__control--make">
                <label class="hf-fitment__label" for="hf-make-{{ section.id }}">{{ section.settings.label_make | default: 'MAKE' }}</label>
                <select id="hf-make-{{ section.id }}" class="hf-fitment__select" data-fitment="make" disabled>
                  <option value="">{{ section.settings.placeholder_make | default: 'Make' }}</option>
                </select>
              </div>
              <div class="hf-fitment__control hf-fitment__control--model">
                <label class="hf-fitment__label" for="hf-model-{{ section.id }}">{{ section.settings.label_model | default: 'MODEL' }}</label>
                <select id="hf-model-{{ section.id }}" class="hf-fitment__select" data-fitment="model" disabled>
                  <option value="">{{ section.settings.placeholder_model | default: 'Model' }}</option>
                </select>
              </div>
              <div class="hf-fitment__control hf-fitment__control--trim">
                <label class="hf-fitment__label" for="hf-trim-{{ section.id }}">{{ section.settings.label_trim | default: 'TRIM' }}</label>
                <select id="hf-trim-{{ section.id }}" class="hf-fitment__select" data-fitment="trim" disabled>
                  <option value="">{{ section.settings.placeholder_trim | default: 'Trim' }}</option>
                </select>
              </div>
              <div class="hf-fitment__action">
                <button id="hf-submit-{{ section.id }}" class="hf-fitment__cta" disabled>
                  <span class="hf-fitment__cta-text">{{ section.settings.button_text | default: 'Find Wheels' }}</span>
                  <svg class="hf-fitment__cta-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M4 8h8M8 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- BY WHEEL STYLE form -->
          <div id="hf-panel-style-{{ section.id }}" class="hf-fitment__form-panel" hidden>
            <div class="hf-fitment__controls">
              <div class="hf-fitment__control">
                <label class="hf-fitment__label" for="hf-diameter-{{ section.id }}">DIAMETER</label>
                <select id="hf-diameter-{{ section.id }}" class="hf-fitment__select" data-fitment="diameter">
                  <option value="">{{ section.settings.placeholder_diameter | default: 'All Diameters' }}</option>
                </select>
              </div>
              <div class="hf-fitment__control">
                <label class="hf-fitment__label" for="hf-width-{{ section.id }}">WIDTH</label>
                <select id="hf-width-{{ section.id }}" class="hf-fitment__select" data-fitment="width">
                  <option value="">{{ section.settings.placeholder_width | default: 'All Widths' }}</option>
                </select>
              </div>
              <div class="hf-fitment__control">
                <label class="hf-fitment__label" for="hf-bolt-{{ section.id }}">BOLT PATTERN</label>
                <select id="hf-bolt-{{ section.id }}" class="hf-fitment__select" data-fitment="bolt">
                  <option value="">{{ section.settings.placeholder_bolt | default: 'All Bolt Patterns' }}</option>
                </select>
              </div>
              <div class="hf-fitment__control">
                <label class="hf-fitment__label" for="hf-finish-{{ section.id }}">FINISH</label>
                <select id="hf-finish-{{ section.id }}" class="hf-fitment__select" data-fitment="finish">
                  <option value="">{{ section.settings.placeholder_finish | default: 'All Finishes' }}</option>
                </select>
              </div>
              <div class="hf-fitment__action">
                <button id="hf-style-submit-{{ section.id }}" class="hf-fitment__cta">
                  <span class="hf-fitment__cta-text">{{ section.settings.button_text | default: 'Find Wheels' }}</span>
                  <svg class="hf-fitment__cta-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M4 8h8M8 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Vertical divider -->
        <div class="hf-fitment__divider" aria-hidden="true"></div>

        <!-- Selected vehicle region -->
        <div class="hf-fitment__vehicle" data-fitment-status hidden>
          <div class="hf-fitment__vehicle-inner">
            <div class="hf-fitment__vehicle-eyebrow">YOUR VEHICLE</div>
            <div class="hf-fitment__vehicle-name" data-fitment-vehicle-name></div>
            <div class="hf-fitment__vehicle-status">
              <svg class="hf-fitment__vehicle-check" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.2" fill="none"/>
                <path d="M5 8.5l2 2 4-5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span data-fitment-status-text>Fitment enabled across the site</span>
            </div>
            <div class="hf-fitment__vehicle-hdivider" aria-hidden="true"></div>
            <div class="hf-fitment__vehicle-actions">
              <button class="hf-fitment__vehicle-change" data-fitment-change>
                <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
                  <path d="M1.5 6.5a5 5 0 019.3-2.9M11.5 6.5a5 5 0 01-9.3 2.9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                  <path d="M9.5 1.5L11 3.5 9 4M3.5 11.5L2 9.5l2-.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Change Vehicle
              </button>
              <div class="hf-fitment__vehicle-action-divider" aria-hidden="true"></div>
              <button class="hf-fitment__vehicle-reset" data-fitment-reset>
                <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
                  <path d="M2.5 2.5l8 8M10.5 2.5l-8 8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                </svg>
                Reset
              </button>
            </div>
          </div>
        </div>
      </div>

      <div id="hf-results-{{ section.id }}" class="hf-fitment__results" style="display:none;"></div>
    </div>
  </div>
</section>

<script src="{{ 'fitment-finder.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Home Fitment Finder",
  "tag": "section",
  "class": "section--hf-fitment",
  "settings": [
    { "type": "header", "content": "Tabs" },
    { "type": "text", "id": "tab_1_label", "label": "Tab 1 label", "default": "By Vehicle" },
    { "type": "text", "id": "tab_2_label", "label": "Tab 2 label", "default": "By Wheel Style" },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find Your FIT" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Select your vehicle to see compatible wheels, real builds, and fitment details." },
    { "type": "header", "content": "Fitment Form — By Vehicle" },
    { "type": "text", "id": "label_year", "label": "Year label", "default": "YEAR" },
    { "type": "text", "id": "placeholder_year", "label": "Year placeholder", "default": "Year" },
    { "type": "text", "id": "label_make", "label": "Make label", "default": "MAKE" },
    { "type": "text", "id": "placeholder_make", "label": "Make placeholder", "default": "Make" },
    { "type": "text", "id": "label_model", "label": "Model label", "default": "MODEL" },
    { "type": "text", "id": "placeholder_model", "label": "Model placeholder", "default": "Model" },
    { "type": "text", "id": "label_trim", "label": "Trim label", "default": "TRIM" },
    { "type": "text", "id": "placeholder_trim", "label": "Trim placeholder", "default": "Trim" },
    { "type": "header", "content": "Fitment Form — By Wheel Style" },
    { "type": "text", "id": "placeholder_diameter", "label": "Diameter placeholder", "default": "All Diameters" },
    { "type": "text", "id": "placeholder_width", "label": "Width placeholder", "default": "All Widths" },
    { "type": "text", "id": "placeholder_bolt", "label": "Bolt Pattern placeholder", "default": "All Bolt Patterns" },
    { "type": "text", "id": "placeholder_finish", "label": "Finish placeholder", "default": "All Finishes" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Find Wheels" }
  ],
  "presets": [
    { "name": "Home Fitment Finder", "category": "Home" }
  ]
}
{% endschema %}