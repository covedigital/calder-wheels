{% comment %}theme-check-disable UnusedAssign{% endcomment %}
{%- liquid
  assign store_width = settings.container_max_width
  if section.settings.section_width == 'custom'
    assign store_width = section.settings.container_max_width
  endif
  assign builder_url = section.settings.builder_url | default: '/pages/build-your-wheel'
  assign fitment_url = section.settings.fitment_url | default: '/pages/fitment-finder'

  assign qs = request.query_string | default: '' | split: '&'
  assign build_handle = ''
  for pair in qs
    assign kv = pair | split: '='
    if kv[0] == 'build' and kv.size > 1
      assign build_handle = kv[1]
    endif
  endfor

  assign meta_build = false
  assign use_blocks = false
  assign block_builds = section.blocks | where: 'type', 'build'

  if build_handle != '' and shop.metaobjects.gallery_build[build_handle] != blank
    assign meta_build = shop.metaobjects.gallery_build[build_handle]
  elsif build_handle == '' and block_builds.size > 0
    assign use_blocks = true
  elsif build_handle == '' and shop.metaobjects.gallery_build.values.size > 0
    assign meta_build = shop.metaobjects.gallery_build.values[0]
  endif
-%}

{{ 'calder-gallery.css' | asset_url | stylesheet_tag }}

{% render 'section-wrapper', placement: 'top' %}
<div class="holder" {% render 'section-style' %}>
  <div class="container">

    <nav class="calder-detail-breadcrumb">
      <a href="/pages/gallery" class="calder-detail-breadcrumb__link">Gallery</a>
      <span class="calder-detail-breadcrumb__sep">/</span>
      {%- if meta_build != false -%}
        {%- assign gtype = meta_build.gallery_type | default: 'vehicle' -%}
        <a href="/pages/{{ gtype }}-gallery" class="calder-detail-breadcrumb__link">{{ gtype | capitalize }} Gallery</a>
        <span class="calder-detail-breadcrumb__sep">/</span>
        <span class="calder-detail-breadcrumb__current">{{ meta_build.title | default: meta_build.wheel_model }}</span>
      {%- else -%}
        <span class="calder-detail-breadcrumb__current">Gallery Build</span>
      {%- endif -%}
    </nav>

    {%- if meta_build != false -%}
      {%- liquid
        assign images = '' | split: ''
        if meta_build.featured_image != blank
          assign images = images | push: meta_build.featured_image
        endif
        if meta_build.gallery_images.value.size > 0
          for img in meta_build.gallery_images.value
            assign images = images | push: img
          endfor
        endif
        assign heading = meta_build.title | default: meta_build.wheel_model | default: 'Gallery Build'
        assign wheel_model = meta_build.wheel_model | default: ''
        assign wheel_series = meta_build.wheel_series | default: ''
        assign vehicle_year = meta_build.vehicle_year | default: ''
        assign vehicle_make = meta_build.vehicle_make | default: ''
        assign vehicle_model = meta_build.vehicle_model | default: ''
        assign vehicle_trim = meta_build.vehicle_trim | default: ''
        assign center_finish = meta_build.center_finish | default: ''
        assign lip_finish = meta_build.lip_finish | default: ''
        assign bolt_finish = meta_build.bolt_finish | default: ''
        assign overall_finish = meta_build.overall_finish | default: ''
        assign front_wheel_size = meta_build.front_wheel_size | default: ''
        assign rear_wheel_size = meta_build.rear_wheel_size | default: ''
        assign tire_brand = meta_build.tire_brand | default: ''
        assign front_tire_size = meta_build.front_tire_size | default: ''
        assign rear_tire_size = meta_build.rear_tire_size | default: ''
        assign fitment_notes = meta_build.fitment_notes | default: ''
        assign construction = meta_build.construction | default: ''
        assign product_url = '#'
        if meta_build.wheel_product != blank
          assign product_url = meta_build.wheel_product.url
        endif
      -%}

      {%- comment %} defaults for empty fields {% endcomment -%}
      {%- assign pd = '—' -%}

      {%- if images.size > 0 -%}
        <div class="calder-detail-hero">
          <div class="calder-detail-hero__image-wrap">
            <img src="{{ images[0] | image_url: width: 1200 }}" alt="{{ heading | escape }}" class="calder-detail-hero__image" id="calder-detail-main-img" width="1200" height="900">
          </div>
        </div>
        {%- if images.size > 1 -%}
          <div class="calder-detail-thumbs">
            {%- for img in images -%}
              <button type="button" class="calder-detail-thumbs__item{% if forloop.first %} calder-detail-thumbs__item--active{% endif %}" data-src="{{ img | image_url: width: 1200 }}">
                <img src="{{ img | image_url: width: 120 }}" alt="" class="calder-detail-thumbs__img" width="120" height="90" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="calder-detail-hero">
          <div class="calder-detail-hero__image-wrap calder-detail-hero__image-wrap--placeholder">
            <div class="calder-detail-hero__placeholder">
              <span class="calder-detail-hero__placeholder-icon">◻</span>
              <span class="calder-detail-hero__placeholder-text">Gallery Image Coming Soon</span>
            </div>
          </div>
        </div>
      {%- endif -%}

      <div class="calder-detail-header">
        <div class="calder-detail-header__series">{{ wheel_series | default: pd }}</div>
        <h1 class="calder-detail-header__title">{{ heading }}</h1>
        <div class="calder-detail-header__vehicle">
          {%- if vehicle_year != '' or vehicle_make != '' or vehicle_model != '' -%}
            {{ vehicle_year }} {{ vehicle_make }} {{ vehicle_model }}{% if vehicle_trim != '' %} · {{ vehicle_trim }}{% endif %}
          {%- else -%}
            Vehicle information coming soon
          {%- endif -%}
        </div>
      </div>

      <div class="calder-detail-specs">
        <h2 class="calder-detail-specs__title">Specifications</h2>
        <dl class="calder-detail-specs__grid">
          <dt class="calder-detail-specs__label">Wheel Model</dt>
          <dd class="calder-detail-specs__value">{{ wheel_model | default: pd }}</dd>
          <dt class="calder-detail-specs__label">Series</dt>
          <dd class="calder-detail-specs__value">{{ wheel_series | default: pd }}</dd>
          <dt class="calder-detail-specs__label">Construction</dt>
          <dd class="calder-detail-specs__value">{{ construction | default: pd }}</dd>
          <dt class="calder-detail-specs__label">Wheel Size</dt>
          <dd class="calder-detail-specs__value">
            {{ front_wheel_size | default: pd }}{% if rear_wheel_size != '' and rear_wheel_size != front_wheel_size %} Front / {{ rear_wheel_size }} Rear{% endif %}
          </dd>
          <dt class="calder-detail-specs__label">Overall Finish</dt>
          <dd class="calder-detail-specs__value">{{ overall_finish | default: pd }}</dd>
          <dt class="calder-detail-specs__label">Center Finish</dt>
          <dd class="calder-detail-specs__value">{{ center_finish | default: pd }}</dd>
          <dt class="calder-detail-specs__label">Lip Finish</dt>
          <dd class="calder-detail-specs__value">{{ lip_finish | default: pd }}</dd>
          <dt class="calder-detail-specs__label">Hardware Finish</dt>
          <dd class="calder-detail-specs__value">{{ bolt_finish | default: pd }}</dd>
          <dt class="calder-detail-specs__label">Tire Brand</dt>
          <dd class="calder-detail-specs__value">{{ tire_brand | default: pd }}</dd>
          <dt class="calder-detail-specs__label">Tire Size</dt>
          <dd class="calder-detail-specs__value">
            {{ front_tire_size | default: pd }}{% if rear_tire_size != '' and front_tire_size != '' %} / {{ rear_tire_size }}{% endif %}
          </dd>
        </dl>
      </div>

      <div class="calder-detail-notes">
        <h2 class="calder-detail-notes__title">Fitment Notes</h2>
        <div class="calder-detail-notes__text">{{ fitment_notes | default: 'Fitment details will be available soon. Contact a Calder specialist for configuration assistance.' }}</div>
      </div>

      <div class="calder-detail-actions">
        <a href="{{ product_url }}" class="calder-detail-actions__btn calder-detail-actions__btn--primary">View This Wheel</a>
        <a href="{{ builder_url }}" class="calder-detail-actions__btn calder-detail-actions__btn--secondary">Customize This Wheel</a>
        <a href="{{ fitment_url }}" class="calder-detail-actions__btn calder-detail-actions__btn--tertiary">Check Vehicle Fitment</a>
      </div>

      {%- comment %}Related builds{% endcomment %}
      {%- if wheel_model != '' and shop.metaobjects.gallery_build.values.size > 1 -%}
        {%- liquid
          assign related = '' | split: ''
          for build in shop.metaobjects.gallery_build.values
            if build.system.handle != build_handle and build.wheel_model == wheel_model
              assign related = related | push: build
            endif
            if related.size >= 3
              break
            endif
          endfor
        -%}
        {%- if related.size > 0 -%}
          <div class="calder-detail-related">
            <h2 class="calder-detail-related__title">More {{ wheel_model }} Configurations</h2>
            <div class="calder-gallery-grid calder-gallery-grid--related">
              {%- for build in related -%}
                {%- liquid
                  assign rh = build.title | default: build.wheel_model | default: ''
                  assign rimg = build.featured_image
                  if rimg == blank
                    assign rimg = build.gallery_images.value.first
                  endif
                  assign rurl = '/pages/gallery-build?build=' | append: build.system.handle
                  assign rdataset = ' data-wheel="' | append: build.wheel_model | append: '"'
                  assign empty_meta = '' | split: ''
                  assign empty_badges = '' | split: ''
                -%}
                {%- render 'calder-gallery-card', image: rimg, heading: rh, meta_lines: empty_meta, badges: empty_badges, url: rurl, type: 'wheel', dataset_attrs: rdataset -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}

      <div class="calder-detail-specialist">
        <div class="calder-detail-specialist__inner">
          <h2 class="calder-detail-specialist__title">Have Questions?</h2>
          <p class="calder-detail-specialist__text">Our wheel specialists can help you find the perfect configuration for your vehicle.</p>
          <a href="/pages/contact" class="calder-detail-cta__btn">Talk to a Specialist</a>
        </div>
      </div>

    {%- elsif use_blocks and block_builds.size > 0 -%}
      {%- assign b = block_builds[0] -%}
      <div class="calder-detail-hero">
        <div class="calder-detail-hero__image-wrap">
          {%- if b.settings.image != blank -%}
            <img src="{{ b.settings.image | image_url: width: 1200 }}" class="calder-detail-hero__image" alt="" width="1200" height="900">
          {%- endif -%}
        </div>
      </div>
      <div class="calder-detail-header">
        <h1 class="calder-detail-header__title">{{ b.settings.title | default: b.settings.wheel_model | default: 'Gallery Build' }}</h1>
        {%- if b.settings.vehicle_make != '' -%}
          <div class="calder-detail-header__vehicle">{{ b.settings.vehicle_year }} {{ b.settings.vehicle_make }} {{ b.settings.vehicle_model }}</div>
        {%- endif -%}
      </div>
      <dl class="calder-detail-specs__grid">
        {%- if b.settings.wheel_model != '' -%}
          <dt class="calder-detail-specs__label">Wheel</dt>
          <dd class="calder-detail-specs__value">{{ b.settings.wheel_model }}{% if b.settings.wheel_series != '' %} · {{ b.settings.wheel_series }}{% endif %}</dd>
        {%- endif -%}
        {%- if b.settings.front_wheel_size != '' -%}
          <dt class="calder-detail-specs__label">Size</dt>
          <dd class="calder-detail-specs__value">{{ b.settings.front_wheel_size }}</dd>
        {%- endif -%}
        {%- if b.settings.overall_finish != '' -%}
          <dt class="calder-detail-specs__label">Finish</dt>
          <dd class="calder-detail-specs__value">{{ b.settings.overall_finish }}</dd>
        {%- endif -%}
      </dl>
      <div class="calder-detail-actions">
        <a href="{{ b.settings.product_url | default: '#' }}" class="calder-detail-actions__btn calder-detail-actions__btn--primary">View This Wheel</a>
        <a href="{{ builder_url }}" class="calder-detail-actions__btn calder-detail-actions__btn--secondary">Customize This Wheel</a>
      </div>
    {%- else -%}
      <div class="calder-gallery-empty">
        <div class="calder-gallery-empty__title">Gallery Build Not Found</div>
        <div class="calder-gallery-empty__text">The gallery build you're looking for doesn't exist or may have been removed.</div>
        <a href="/pages/gallery" class="calder-gallery-empty__reset">Back to Gallery</a>
      </div>
    {%- endif -%}

  </div>
</div>
{% render 'section-wrapper' %}

<script>
document.addEventListener('DOMContentLoaded', function() {
  var t = document.querySelectorAll('.calder-detail-thumbs__item');
  var h = document.getElementById('calder-detail-main-img');
  t.forEach(function(b) {
    b.addEventListener('click', function() {
      if (h) h.src = this.dataset.src;
      t.forEach(function(x) { x.classList.remove('calder-detail-thumbs__item--active'); });
      this.classList.add('calder-detail-thumbs__item--active');
    });
  });
});
</script>

{% schema %}
{
  "name": "Calder Gallery Detail",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Links" },
    { "type": "url", "id": "builder_url", "label": "Builder page URL" },
    { "type": "url", "id": "fitment_url", "label": "Fitment page URL" },
    { "type": "header", "content": "Section Width" },
    { "type": "select", "id": "section_width", "label": "Width source", "options": [{ "value": "global", "label": "Use store width" }, { "value": "custom", "label": "Custom width" }], "default": "global" },
    { "type": "range", "id": "container_max_width", "min": 1178, "max": 1978, "step": 8, "unit": "px", "label": "Custom width", "default": 1178 }
  ],
  "blocks": [
    {
      "type": "build", "name": "Gallery Build Detail",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Featured image" },
        { "type": "text", "id": "title", "label": "Build title" },
        { "type": "text", "id": "vehicle_year", "label": "Vehicle year" },
        { "type": "text", "id": "vehicle_make", "label": "Vehicle make" },
        { "type": "text", "id": "vehicle_model", "label": "Vehicle model" },
        { "type": "text", "id": "wheel_model", "label": "Wheel model" },
        { "type": "text", "id": "wheel_series", "label": "Wheel series" },
        { "type": "text", "id": "front_wheel_size", "label": "Front wheel size" },
        { "type": "text", "id": "overall_finish", "label": "Overall finish" },
        { "type": "url", "id": "product_url", "label": "Product URL" }
      ]
    }
  ],
  "presets": [{ "name": "Calder Gallery Detail", "settings": {} }]
}
{% endschema %}