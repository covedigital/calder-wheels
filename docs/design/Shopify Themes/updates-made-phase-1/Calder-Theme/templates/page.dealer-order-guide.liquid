{% comment %}
  Calder Wheels — Dealer Order Guide (Printable PDF)
  URL: /pages/dealer-order-guide?view=dealer-guide
  Browser print-to-PDF (Cmd+P / Ctrl+P) generates the PDF.
  Accessible to approved dealers only.
{% endcomment %}

{%- layout none -%}
{%- render 'dealer-context' -%}

{%- unless is_dealer -%}
  <p style="font-family:sans-serif;padding:40px;text-align:center;color:#666">
    This page is for authorized dealers only.<br>
    <a href="/pages/dealer-program" style="color:#c9a96e">Apply for dealer access</a>.
  </p>
{%- endunless -%}

{%- if is_dealer -%}
{%- liquid
  assign dealer_price_field = 'dealer_tier_' | append: dealer_tier | append: '_price'
-%}
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>{{ shop.name }} — Dealer Order Guide (Tier {{ dealer_tier }})</title>
<style>
  @page { margin: 0.4in; size: letter; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 10px; color: #111; line-height: 1.35; padding: 15px; }
  h1 { font-size: 18px; margin-bottom: 2px; letter-spacing: 1px; text-transform: uppercase; }
  .subtitle { font-size: 13px; color: #555; margin-bottom: 16px; }
  .header { display: flex; justify-content: space-between; align-items: start; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 2px solid #111; }
  .header-right { text-align: right; font-size: 9px; color: #666; }
  .dealer-info { margin-bottom: 16px; padding: 10px 14px; background: #f5f5f5; border-radius: 4px; font-size: 10px; }
  .dealer-info strong { font-size: 12px; }
  table { width: 100%; border-collapse: collapse; margin-bottom: 16px; }
  th { background: #111; color: #fff; padding: 6px 8px; text-align: left; font-size: 8px; text-transform: uppercase; letter-spacing: 0.5px; }
  td { padding: 5px 8px; border-bottom: 1px solid #ddd; font-size: 9px; }
  tr:nth-child(even) td { background: #f9f9f9; }
  .price-col { text-align: right; white-space: nowrap; }
  .badge { display: inline-block; padding: 1px 5px; font-size: 7px; font-weight: 700; text-transform: uppercase; border-radius: 2px; }
  .badge--forged { background: #222; color: #fff; }
  .badge--flow_formed { background: #555; color: #fff; }
  .badge--three_piece { background: #c9a96e; color: #000; }
  .footer { margin-top: 20px; padding-top: 10px; border-top: 1px solid #ddd; font-size: 8px; color: #888; text-align: center; }
  .terms { margin-top: 16px; font-size: 8px; color: #555; }
  .terms h3 { font-size: 9px; color: #333; margin-bottom: 2px; margin-top: 8px; }
  @media print { body { padding: 0; } .no-print { display: none; } }
</style>
</head>
<body>

<div class="header">
  <div>
    <h1>{{ shop.name }}</h1>
    <div class="subtitle">Dealer Order Guide &middot; Tier {{ dealer_tier }} Pricing</div>
  </div>
  <div class="header-right">
    <div>{{ 'now' | date: '%B %d, %Y' }}</div>
    <div style="margin-top:2px;font-size:8px">Prices subject to change</div>
  </div>
</div>

{%- if customer -%}
<div class="dealer-info">
  <strong>{{ customer.name }}</strong> &middot; Account #{{ customer.id | prepend: 'DWN-' }}<br>
  {%- if customer.default_address -%}{{ customer.default_address.address1 }}, {{ customer.default_address.city }}, {{ customer.default_address.province_code }} {{ customer.default_address.zip }}{%- endif -%}
  &middot; Tier {{ dealer_tier }} &middot; {% if dealer_net_terms %}NET-30{% else %}Prepaid{% endif %}
</div>
{%- endif -%}

{%- paginate collections.all.products by 1000 -%}
<table>
  <thead>
    <tr>
      <th style="width:36px">Code</th>
      <th style="width:110px">Product</th>
      <th>Series</th>
      <th>SKU</th>
      <th class="price-col">MSRP</th>
      <th class="price-col">Dealer T{{ dealer_tier }}</th>
      <th class="price-col" style="width:30px">MOQ</th>
    </tr>
  </thead>
  <tbody>
    {%- for product in collections.all.products -%}
      {%- liquid
        assign design_code = product.metafields.custom.design_code.value
        assign series = product.metafields.custom.series.value
        assign dealer_price = product.metafields.custom[dealer_price_field]
        assign moq = product.metafields.custom.dealer_moq | default: 1
        assign retail_price = product.price
        assign series_class = ''
        if series == 'forged' or series == 'Forged'
          assign series_class = 'badge--forged'
        elsif series == 'flow_formed' or series == 'Flow-Formed'
          assign series_class = 'badge--flow_formed'
        elsif series == 'three_piece' or series == '3-Piece'
          assign series_class = 'badge--three_piece'
        endif
      -%}
      <tr>
        <td>{{ design_code | default: '-' }}</td>
        <td>{{ product.title | truncate: 28 }}</td>
        <td>{% if series %}<span class="badge {{ series_class }}">{{ series | replace: '_', ' ' | capitalize }}</span>{% else %}-{% endif %}</td>
        <td style="font-size:8px;color:#666">{{ product.selected_or_first_available_variant.sku | default: product.id | truncate: 18 }}</td>
        <td class="price-col">{{ retail_price | money }}</td>
        <td class="price-col" style="font-weight:700">
          {%- if dealer_price and dealer_price > 0 -%}{{ dealer_price | money }}{%- else -%}{{ retail_price | money }}{%- endif -%}
        </td>
        <td class="price-col">{{ moq }}</td>
      </tr>
    {%- endfor -%}
  </tbody>
</table>
{%- endpaginate -%}

<div class="terms">
  <h3>Payment Terms</h3>
  <p>{% if dealer_net_terms %}NET-30 — Invoices due within 30 days of invoice date.{% else %}Payment required at time of order.{% endif %} Late payments subject to 1.5% monthly interest.</p>

  <h3>Shipping</h3>
  <p>FOB Origin. Freight charges calculated at time of shipment. Minimum freight charge may apply.</p>

  <h3>Minimum Order Quantities</h3>
  <p>MOQ per product as listed. Mixed configurations within the same design may be combined. Contact your account representative for exceptions.</p>

  <h3>Returns &amp; Warranty</h3>
  <p>Custom-configured wheels are non-cancellable and non-returnable. Manufacturer warranty covers manufacturing defects. Return authorization required for all other returns.</p>
</div>

<div class="footer">
  {{ shop.name }} &middot; {{ shop.domain }} &middot; {{ shop.address.address1 }} {{ shop.address.city }} {{ shop.address.province_code }} &middot; {{ shop.phone }}
  <br>
  &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved. Confidential — for authorized dealers only.
</div>

<script>window.onload=function(){setTimeout(function(){window.print()},500)};</script>

</body>
</html>
{%- endif -%}