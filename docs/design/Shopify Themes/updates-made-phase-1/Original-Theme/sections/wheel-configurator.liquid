{{ 'wheel-configurator.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign is_configurable = product.metafields.custom.is_configurable.value | default: false

  unless is_configurable
    assign made_to_order = false
    for tag in product.tags
      if tag == 'configurable'
        assign is_configurable = true
        break
      endif
    endfor
  endunless

  if is_configurable == false
    echo '<!-- Product is not configurable — configurator hidden -->'
    break
  endif

  assign bom_json = product.metafields.custom.bom.value
  assign configurator_title = block.settings.title | default: 'Build Your Wheel'
  assign configurator_subtitle = block.settings.subtitle
  assign show_3d = block.settings.show_3d | default: false

  render 'configurator-data', product: product
-%}

<div
  class="wheel-configurator"
  id="wheel-configurator-{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="wheel-configurator__header">
    <h3 class="wheel-configurator__title">{{ configurator_title }}</h3>
    {% if configurator_subtitle %}
      <p class="wheel-configurator__subtitle">{{ configurator_subtitle }}</p>
    {% endif %}
  </div>

  <div class="wheel-configurator__layout">
    <div class="wheel-configurator__preview">
      <div
        class="wheel-configurator__canvas"
        id="configurator-canvas-{{ section.id }}"
        data-bom='{{ bom_json | json | escape }}'
      >
        <div class="wheel-configurator__preview-loading">
          <div class="loading-overlay__spinner" style="display:block;width:48px;height:48px;margin:0 auto;">
            <div data-load="loading"></div>
          </div>
          <p>Loading preview...</p>
        </div>

        <div class="wheel-configurator__preview-layers" style="display:none;">
          <img class="wheel-configurator__layer wheel-configurator__layer--barrel" src="" alt="" data-layer="barrel">
          <img class="wheel-configurator__layer wheel-configurator__layer--center" src="" alt="" data-layer="center">
          <img class="wheel-configurator__layer wheel-configurator__layer--hardware" src="" alt="" data-layer="hardware">
        </div>

        {% if show_3d and product.metafields.custom.model_with_variants.value == true %}
          <div class="wheel-configurator__3d-viewer" style="display:none;">
            <product-model data-section="{{ section.id }}">
              {% for media in product.media %}
                {% if media.media_type == 'model' %}
                  {{ media | model_viewer_tag: reveal: 'interaction' }}
                {% endif %}
              {% endfor %}
            </product-model>
          </div>
        {% endif %}
      </div>

      <div class="wheel-configurator__toggle-3d" style="display:none;">
        <button type="button" class="btn btn--sm btn--grey configurator-toggle-btn" data-view="layers">
          <span class="configurator-toggle-layers">2D Preview</span>
          <span class="configurator-toggle-3d">3D View</span>
        </button>
      </div>
    </div>

    <div class="wheel-configurator__controls">
      <div class="wheel-configurator__section">
        <h4 class="wheel-configurator__label">Center Finish</h4>
        <div
          class="wheel-configurator__options"
          id="configurator-centers-{{ section.id }}"
          data-component="center"
          data-loaded="false"
        >
          <div class="wheel-configurator__loading-options">
            <div data-load="loading"></div>
          </div>
        </div>
      </div>

      <div class="wheel-configurator__section">
        <h4 class="wheel-configurator__label">Barrel / Lip Finish</h4>
        <div
          class="wheel-configurator__options"
          id="configurator-barrels-{{ section.id }}"
          data-component="barrel"
          data-loaded="false"
        >
          <div class="wheel-configurator__loading-options">
            <div data-load="loading"></div>
          </div>
        </div>
      </div>

      <div class="wheel-configurator__section">
        <h4 class="wheel-configurator__label">Hardware / Rivet Finish</h4>
        <div
          class="wheel-configurator__options"
          id="configurator-hardware-{{ section.id }}"
          data-component="hardware"
          data-loaded="false"
        >
          <div class="wheel-configurator__loading-options">
            <div data-load="loading"></div>
          </div>
        </div>
      </div>

      <div
        class="wheel-configurator__availability"
        id="configurator-availability-{{ section.id }}"
        style="display:none;"
      >
      </div>

      <div class="wheel-configurator__actions" style="display:none;">
        <button
          type="button"
          id="configurator-add-{{ section.id }}"
          class="btn btn--primary w-100 wheel-configurator__add-btn"
          disabled
        >
          Add Configured Wheel to Cart
        </button>
        {% if block.settings.show_quote %}
          <button
            type="button"
            id="configurator-quote-{{ section.id }}"
            class="btn btn--secondary w-100 wheel-configurator__quote-btn"
            disabled
          >
            Request Quote
          </button>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="wheel-configurator__summary" id="configurator-summary-{{ section.id }}" style="display:none;">
    <span class="wheel-configurator__summary-item">
      <strong>Center:</strong> <span id="configurator-summary-center">—</span>
    </span>
    <span class="wheel-configurator__summary-item">
      <strong>Barrel:</strong> <span id="configurator-summary-barrel">—</span>
    </span>
    <span class="wheel-configurator__summary-item">
      <strong>Hardware:</strong> <span id="configurator-summary-hardware">—</span>
    </span>
    <span class="wheel-configurator__summary-item">
      <strong>Price:</strong> <span id="configurator-summary-price">—</span>
    </span>
  </div>
</div>

<script src="{{ 'configurator-api.js' | asset_url }}" defer></script>
<script src="{{ 'configurator-app.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Wheel Configurator",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "spacing_blocks",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Vertical space above the section on Desktop",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "use_global_blocks_desktop_space",
      "label": "Use global space on desktop",
      "default": true,
      "info": "from Section settings / Layout"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Configurator title",
      "default": "Build Your Wheel"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Select finishes to preview and order"
    },
    {
      "type": "checkbox",
      "id": "show_3d",
      "label": "Show 3D model toggle",
      "default": false,
      "info": "Requires product to have a 3D model uploaded"
    },
    {
      "type": "checkbox",
      "id": "show_quote",
      "label": "Show 'Request Quote' button",
      "default": true
    }
  ]
}
{% endschema %}